app BottomSheetSmoke {
    let sheetRef = ComponentRef<BottomSheet>()
    let nestedSheetRef = ComponentRef<BottomSheet>()
    state didDismiss: Bool = false
    state didSave: Bool = false

    body {
        Column {
            Text("Bottom sheet smoke")
            Text(didDismiss ? "Dismiss callback ran" : "Dismiss callback waiting")
            Button("Open sheet") {
                sheetRef.present()
            }
            BottomSheet(
                ref: sheetRef,
                contentPadding: 20,
                detents: [0.3, 0.6, 0.9],
                showDragIndicator: false,
                allowsDismissal: true,
                allowsBackgroundInteraction: true,
                shouldDismissOnBackPress: false,
                backgroundColor: "#00000000",
                scrimColor: "#00000000"
            ) {
                Column {
                    Row {
                        Text("Edit task")
                        Spacer()
                        Button("Save", icon: "save", style: Borderless) {
                            didSave = true
                        }
                        Button("Close", icon: "close", style: Plain) {
                            sheetRef.dismiss()
                        }
                    }
                    Text(didSave ? "Header saved" : "Not saved")
                    Text("Sheet content")
                    Button("Open nested sheet") {
                        nestedSheetRef.present()
                    }
                    BottomSheet(
                        ref: nestedSheetRef,
                        detents: [0.5, 1.0],
                        initialDetent: 0.5
                    ) {
                        Column {
                            Text("Nested sheet content")
                            Button("Return to parent") {
                                nestedSheetRef.dismiss()
                            }
                        }
                    }
                    Text("Drag the handle to change the sheet height")
                    Button("Close sheet") {
                        sheetRef.dismiss()
                    }
                }
            }
            .onDismiss {
                didDismiss = true
            }
        }
    }
}
