struct ProbeValue {
    label: String
    score: Int32
}

error ProbeError {
    rejected(value: ProbeValue, reason: String)
}

service DevProbe {
    fn increment(value: Int32) -> Int32
    async fn fail() -> ProbeValue throws ProbeError
}

native class Probe {
    init()

    property value: ProbeValue

    fn updated() -> ProbeValue
    fn numericMap() -> Map<Int32, Int32>
    fn replace(value: ProbeValue)
    fn emit()
    fn echo<T>(value: T) -> T
    fn hasValue<T>(value: T?) -> Bool
    fn echoOptional<T>(value: T?) -> T?
    fn readNullable<T>(key: String) -> T?
    async fn fail() -> ProbeValue throws ProbeError

    event changed(value: ProbeValue)

    fn dispose()
}

native class ProbeByteSet {
    init()

    property values: Set<Bytes>

    fn replace(values: Set<Bytes>) -> Set<Bytes>
    fn emit()

    event changed(values: Set<Bytes>)
}

native component ProbeCard {
    prop value: ProbeValue
    event selected(value: ProbeValue)
}

native component ProbeByteSetCard {
    prop values: Set<Bytes>
    event selected(values: Set<Bytes>)
}
