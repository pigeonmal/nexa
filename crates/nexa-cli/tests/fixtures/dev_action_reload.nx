app ActionReloadSmoke {
    state count: Int32 = 0
    state taps: Int32 = 0

    body {
        StatusBar(style: Light, hidden: false, background: "#223344")
        Direction(value: RTL)
        Column {
            Row {
                Text("Row Start")
                Text("Row End")
            }
            Stack(alignment: Center) {
                Text("Stack Underlay")
                Text("Stack Overlay V1")
            }
            Text("Accessible content", accessibilityLabel: "Accessible Action V1", accessibilityHint: "Screen reader hint", accessibilityRole: Button)
            Text("Link content", accessibilityLabel: "Accessible Link V1", accessibilityRole: Link)
            Text("Header content", accessibilityLabel: "Accessible Header V1", accessibilityRole: Header)
            Text("Image content", accessibilityLabel: "Accessible Image V1", accessibilityRole: Image)
            Text("Plain content", accessibilityLabel: "Accessible Plain V1", accessibilityRole: None)
            Text("Count: $count")
            Button("Increment") {
                count = count + 1
            }
            Text("Presses: $taps")
            Pressable(disabled: false, haptic: Light) {
                Text("Press me")
            }.onTap {
                taps = taps + 1
            }
        }
    }
}
