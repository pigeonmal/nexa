app PageSnapSmoke {
    state currentPage: Int32 = 0
    state settledEvents: Int32 = 0

    body {
        FastList(count: 4, pageSnap: true, scrollPosition: currentPage) { index in
            Column(spacing: 24, padding: 32) {
                Text("Feed page $index")
                Text("Current page $currentPage")
                Text("Settled events $settledEvents")
            }
        }
        .onScroll {
            settledEvents = settledEvents + 1
        }
    }
}
