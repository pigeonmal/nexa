app SegmentedControlSmoke {
    state filters: Array<String> = ["All", "Open", "Closed"]
    state selectedFilter: String = "Open"

    body {
        SegmentedControl(
            items: filters,
            selected: selectedFilter,
            animation: Tween(
                duration: 0.24,
                delay: 0.06,
                easing: CubicBezier(x1: 0.2, y1: 0.0, x2: 0.2, y2: 1.0)
            )
        )
    }
}
