config {
    app {
        displayName: "DevRuntimeProbe",
        version: "0.1.0",
        buildNumber: 1
    }
    ios {
        minVersion: "17.0",
        bundleIdentifier: "dev.nexa.devprobe"
    }
    android {
        minSdk: 26,
        targetSdk: 36,
        applicationId: "dev.nexa.devprobe"
    }
    permissions {}
    dependencies {
        DevProbe { id: "dev.nexa.runtime-probe", path: "probe-plugin" }
    }
}
