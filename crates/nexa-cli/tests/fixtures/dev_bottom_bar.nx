app BottomBarSmoke {
    state selectedTab: Int32 = 0

    body {
        AppBottomBar(selected: selectedTab) {
            Tab(index: 0, label: "Home", icon: "house") {
                Text("Home tab")
            }
            Tab(index: 1, label: "Settings", icon: "gearshape", badge: "2") {
                Text("Settings tab")
            }
        }
    }
}
