{
  "fixture": {
    "nxSource": "app ColumnBench {\n    state showCovers: Bool = false\n    let folder = \"file://\" + Path.documents()\n    body {\n        Column(gap: 6, padding: 82) {\n            Text(\"Distinct album covers\")\n            if showCovers {\n                    Row(gap: 5) {\n                        Image(file: folder + \"/cover-0.jpg\", description: \"Cover 0\", scale: Fit, maxHeight: 32)\n                        Image(file: folder + \"/cover-1.jpg\", description: \"Cover 1\", scale: Fit, maxHeight: 32)\n                        Image(file: folder + \"/cover-2.jpg\", description: \"Cover 2\", scale: Fit, maxHeight: 32)\n                        Image(file: folder + \"/cover-3.jpg\", description: \"Cover 3\", scale: Fit, maxHeight: 32)\n                    }\n                    Row(gap: 5) {\n                        Image(file: folder + \"/cover-4.jpg\", description: \"Cover 4\", scale: Fit, maxHeight: 65)\n                        Image(file: folder + \"/cover-5.jpg\", description: \"Cover 5\", scale: Fit, maxHeight: 65)\n                        Image(file: folder + \"/cover-6.jpg\", description: \"Cover 6\", scale: Fit, maxHeight: 65)\n                        Image(file: folder + \"/cover-7.jpg\", description: \"Cover 7\", scale: Fit, maxHeight: 65)\n                    }\n                    Row(gap: 5) {\n                        Image(file: folder + \"/cover-8.jpg\", description: \"Cover 8\", scale: Fit, maxHeight: 95)\n                        Image(file: folder + \"/cover-9.jpg\", description: \"Cover 9\", scale: Fit, maxHeight: 95)\n                        Image(file: folder + \"/cover-10.jpg\", description: \"Cover 10\", scale: Fit, maxHeight: 95)\n                        Image(file: folder + \"/cover-11.jpg\", description: \"Cover 11\", scale: Fit, maxHeight: 95)\n                    }\n            }\n        }\n    }\n}\n",
    "swiftProbe": "@MainActor\nfinal class NexaImageBench: NSObject {\n    static let shared = NexaImageBench()\n    private var startTime = 0.0\n    private var firstCPU = 0.0\n    private var startResident: UInt64 = 0\n    private var peakResident: UInt64 = 0\n    private var thumbnails: Set<ObjectIdentifier> = []\n    private var thumbnailSizes: [String] = []\n    private var decodedPixelBytes = 0\n    private var loaded = 0\n    private var previous = 0.0\n    private var intervals: [Double] = []\n    private var link: CADisplayLink?\n\n    func start() {\n        firstCPU = cpuSeconds()\n        let memory = residentBytes()\n        startResident = memory.current\n        startTime = CACurrentMediaTime()\n        previous = startTime\n        let link = CADisplayLink(target: self, selector: #selector(frame))\n        link.preferredFramesPerSecond = 60\n        link.add(to: .main, forMode: .common)\n        self.link = link\n    }\n\n    @objc private func frame() {\n        let now = CACurrentMediaTime()\n        intervals.append((now - previous) * 1000)\n        previous = now\n    }\n\n    func didLoad(_ image: UIImage) {\n        thumbnails.insert(ObjectIdentifier(image))\n        thumbnailSizes.append(\"\\(Int(image.size.width))\u00d7\\(Int(image.size.height))\")\n        if let bitmap = image.cgImage {\n            decodedPixelBytes += bitmap.bytesPerRow * bitmap.height\n        }\n        loaded += 1\n        guard loaded == 12 else { return }\n        extendLifetimeForRender()\n    }\n\n    private func extendLifetimeForRender() {\n        let loadedTime = CACurrentMediaTime()\n        let loadedCPU = cpuSeconds()\n        let loadedMemory = residentBytes()\n        DispatchQueue.main.asyncAfter(deadline: .now() + 0.4) {\n            let memory = self.residentBytes()\n            let counters: [String: Any] = [\n                \"images\": self.loaded,\n                \"distinctDecodedObjects\": self.thumbnails.count,\n                \"thumbnailSizes\": self.thumbnailSizes.sorted(),\n                \"decodedPixelBytes\": self.decodedPixelBytes,\n                \"wallSecondsToAllImages\": loadedTime - self.startTime,\n                \"cpuSecondsToAllImages\": loadedCPU - self.firstCPU,\n                \"residentStart\": self.startResident,\n                \"residentAllImages\": loadedMemory.current,\n                \"peakResident\": memory.peak,\n                \"residentAfterRender\": memory.current,\n                \"callbackIntervalsToAllImagesMs\": self.intervals,\n            ]\n            if let bytes = try? JSONSerialization.data(withJSONObject: counters) {\n                try? bytes.write(to: URL.documentsDirectory.appendingPathComponent(\"image-perf.json\"), options: .atomic)\n            }\n            self.link?.invalidate()\n            self.link = nil\n        }\n    }\n\n    private func cpuSeconds() -> Double {\n        var usage = rusage()\n        getrusage(RUSAGE_SELF, &usage)\n        return Double(usage.ru_utime.tv_sec + usage.ru_stime.tv_sec)\n          + Double(usage.ru_utime.tv_usec + usage.ru_stime.tv_usec) / 1_000_000\n    }\n\n    private func residentBytes() -> (current: UInt64, peak: UInt64) {\n        var info = mach_task_basic_info()\n        var count = mach_msg_type_number_t(MemoryLayout<mach_task_basic_info>.size / MemoryLayout<integer_t>.size)\n        let status = withUnsafeMutablePointer(to: &info) {\n            $0.withMemoryRebound(to: integer_t.self, capacity: Int(count)) {\n                task_info(mach_task_self_, task_flavor_t(MACH_TASK_BASIC_INFO), $0, &count)\n            }\n        }\n        return status == KERN_SUCCESS ? (info.resident_size, info.resident_size_max) : (0, 0)\n    }\n}\n",
