{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nexa",
  "scopeName": "source.nexa",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#builtin-types" },
    { "include": "#ui-components" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nexa",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nexa",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nexa",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nexa",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.nexa",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nexa",
          "match": "\\b(await|break|case|catch|continue|else|for|if|in|return|try|while)\\b"
        },
        {
          "name": "keyword.declaration.nexa",
          "match": "\\b(app|async|component|enum|fn|let|plugin|screen|state|struct)\\b"
        },
        {
          "name": "constant.language.boolean.nexa",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.nexa",
          "match": "\\b(null)\\b"
        }
      ]
    },
    "builtin-types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.nexa",
          "match": "\\b(Array|Bool|Bytes|Err|Float32|Float64|Int16|Int32|Int64|Int8|Map|Ok|Pair|Result|Set|String|Triple|UInt16|UInt32|UInt64|UInt8|Void)\\b"
        }
      ]
    },
    "ui-components": {
      "patterns": [
        {
          "name": "support.class.component.nexa",
          "match": "\\b(Accessibility|AppBottomBar|BottomSheet|Button|Column|Content|Direction|FastList|Image|KeyboardAware|Link|NavigationBack|NavigationLink|NavigationStack|OnActive|OnAppear|OnBackground|OnDisappear|OnInactive|Pressable|RefreshControl|Row|Stack|StatusBar|Switch|Tab|Text|TextInput)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nexa",
          "match": "(=|==|!=|<|>|<=|>=|\\+|-|\\*|/|%|\\?|->|\\.|,|:)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.nexa",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
