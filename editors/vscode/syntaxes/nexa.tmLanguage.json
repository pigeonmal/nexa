{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nexa",
  "scopeName": "source.nexa",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#config" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#modifiers" },
    { "include": "#builtin-types" },
    { "include": "#ui-components" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "config": {
      "patterns": [
        {
          "name": "meta.configuration.nexa",
          "begin": "\\b(config)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.config.nexa" },
            "2": { "name": "punctuation.section.block.begin.nexa" }
          },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.section.block.end.nexa" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            {
              "name": "meta.configuration.block.nexa",
              "begin": "\\{",
              "beginCaptures": { "0": { "name": "punctuation.section.block.begin.nexa" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.section.block.end.nexa" } },
              "patterns": [
                { "include": "#comments" },
                { "include": "#strings" },
                { "include": "#numbers" },
                { "include": "#configuration-keys" }
              ]
            },
            { "include": "#configuration-keys" }
          ]
        }
      ]
    },
    "configuration-keys": {
      "patterns": [
        {
          "name": "support.type.property-name.nexa",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nexa",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nexa",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nexa",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nexa",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.nexa",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.nexa",
          "match": "\\b(import|as)\\b"
        },
        {
          "name": "keyword.control.nexa",
          "match": "\\b(await|break|case|catch|continue|else|for|if|in|return|try|while)\\b"
        },
        {
          "name": "keyword.declaration.nexa",
          "match": "\\b(app|async|component|enum|fn|let|plugin|screen|state|struct)\\b"
        },
        {
          "name": "constant.language.boolean.nexa",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.nexa",
          "match": "\\b(null)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "entity.name.type.nexa",
          "match": "\\b(app|class|component|enum|interface|screen|struct)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.nexa" },
            "3": { "name": "entity.name.type.nexa" }
          }
        },
        {
          "name": "entity.name.function.nexa",
          "match": "\\b(fn)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.nexa" },
            "3": { "name": "entity.name.function.nexa" }
          }
        },
        {
          "name": "variable.other.property.nexa",
          "match": "\\b(let|state)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.nexa" },
            "3": { "name": "variable.other.property.nexa" }
          }
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.nexa",
          "match": "\\b(static|async)\\b"
        }
      ]
    },
    "builtin-types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.nexa",
          "match": "\\b(Array|Bool|Bytes|Err|Float32|Float64|Int16|Int32|Int64|Int8|Map|Ok|Pair|Range|Regex|RegexMatch|Result|Set|String|Triple|UInt16|UInt32|UInt64|UInt8|Void)\\b"
        }
      ]
    },
    "ui-components": {
      "patterns": [
        {
          "name": "support.class.component.nexa",
          "match": "\\b(AppBottomBar|Appearance|BottomSheet|Button|Column|ConfirmationDialog|Content|ContentUnavailable|DatePicker|Dialog|Direction|Divider|FastList|Form|Icon|Image|KeyboardAware|LinearGradient|Link|NavigationBack|NavigationLink|NavigationSplitView|NavigationStack|OnActive|OnAppear|OnBackground|OnDisappear|OnInactive|PagePager|Picker|Pressable|ProgressBar|ProgressRing|RefreshControl|Row|Section|SegmentedControl|Slider|Spacer|Stack|StatusBar|Switch|Tab|Text|TextInput|Toolbar)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nexa",
          "match": "(=|==|!=|<|>|<=|>=|\\+|-|\\*|/|%|\\?|->|\\.|,|:)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.nexa",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
