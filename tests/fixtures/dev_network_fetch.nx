app NetworkFetchSmoke {
    state statusCode: Int32 = 0

    body {
        OnAppear async {
            try {
                let headers: Map<String, String> = [
                    "Accept": "application/json",
                    "X-Client": "nexa-smoke"
                ]
                statusCode = (await Network.fetch(
                    url: "https://example.com",
                    headers: headers,
                    cachePolicy: CacheOnly
                )).statusCode
            } catch {
                statusCode = 599
            }
        }
        Text("HTTP: $statusCode")
    }
}
