app DevFileApiSmoke {
    state status: String = "Waiting"
    state path: String = Path.join(path: Path.temporary(), component: "nexa-dev-file-hot-reload.txt")
    state fileExists: Bool = false
    state permissionStatus: PermissionStatus = PermissionStatus.notDetermined

    body {
        OnAppear async {
            try {
                await File.writeText(
                    path: Path.join(path: Path.temporary(), component: "nexa-dev-file-hot-reload.txt"),
                    contents: "FILE_OK"
                )
                fileExists = File.exists(path: path)
                status = await File.readText(path: path)
                permissionStatus = await Permissions.status(permission: Notifications)
                await File.delete(path: path)
            } catch {
                status = "ERROR"
            }
        }
        Text("File: $status")
        Text("Exists: $fileExists")
        Text("Permission: $permissionStatus")
    }
}
