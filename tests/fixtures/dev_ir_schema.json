  "platforms": [
    "ios",
    "android"
  ],
  "client_messages": [
    "hello",
    "acknowledge",
    "request_full_module",
    "disconnect"
  ],
  "server_messages": [
    "welcome",
    "full_module",
    "patch",
    "diagnostics",
    "reload",
    "restart",
    "performance_overlay"
  ],
  "patch_operations": [
    "set",
    "remove"
  ],
  "severities": [
    "error",
    "warning"
  ],
  "node_kinds": [
    "Layout",
    "Column",
    "Row",
    "Stack",
    "Form",
    "FormSection",
    "Text",
    "ContentUnavailable",
    "Button",
    "Pressable",
    "TextInput",
    "FastList",
    "Switch",
    "Slider",
    "ProgressBar",
    "ProgressRing",
    "Image",
    "SystemIcon",
    "LinearGradient",
    "RefreshControl",
    "If",
    "When",
    "Link",
    "Accessibility",
    "KeyboardAware",
    "AppBottomBar",
    "BottomSheet",
    "Dialog",
    "SegmentedControl",
    "Picker",
    "DatePicker",
    "NavigationStack",
    "NavigationSplitView",
    "NavigationLink",
    "NavigationBack",
    "Content",
    "ComponentCall"
