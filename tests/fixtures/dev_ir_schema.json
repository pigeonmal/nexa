    "Assign",
    "Expression",
    "Let",
    "Return",
    "If",
    "For",
    "ForMap",
    "While",
    "CollectionMutation",
    "TryCatch",
    "Break",
    "Continue",
    "WithAnimation",
    "NativeCall"
  ],
  "collection_mutation_kinds": [
    "ArrayAppend",
    "ArrayRemoveAt",
    "SetInsert",
    "SetRemove",
    "MapSet",
    "MapRemove"
  ],
  "native_namespaces": [
    "Network",
    "File",
    "Path",
    "Permissions",
    "Keyboard"
