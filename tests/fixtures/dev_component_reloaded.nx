struct Profile {
    id: Int64,
    name: String,
}

component Card(title: String) {
    body {
        Column {
            Text("Card: $title")
            Content()
        }
    }
}

app ComponentSmoke {
    theme {
        color accent(light: "#112233", dark: "#445566")
    }

    enum Mode {
        ready,
        busy
    }

    enum AppError {
        unavailable
    }

    state numbers: Array<Int32> = [3, 5, 8]
    state optional: String? = null
    state keyboardText: String = ""
    state keyboardNumber: String = ""
    state keyboardEmail: String = ""
    state keyboardPhone: String = ""
    state keyboardUrl: String = ""
    state numericInt8: Int8 = 8
    state numericInt16: Int16 = 16
    state numericInt64: Int64 = 64
    state numericUInt8: UInt8 = 8
    state numericUInt16: UInt16 = 16
    state numericUInt32: UInt32 = 32
    state numericUInt64: UInt64 = 64
    state numericFloat32: Float32 = 3.5
    state numericFloat64: Float64 = 6.5
    state tags: Set<Int32> = [2, 4]
    state scores: Map<String, Int32> = ["nexa": 42]
    state coordinates: Triple<Int32, Int32, Int32> = Triple(2, 3, 4)
    state mode: Mode = Mode.ready
    state result: Result<Int32, AppError> = Ok(42)
    state failure: Result<Int32, AppError> = Err(AppError.unavailable)
    state profile: Profile = Profile(7, "Ada")
    state actionArray: Array<Int32> = [1, 2]
    state actionSet: Set<String> = ["a"]
    state actionMap: Map<String, Int32> = ["a": 1]
    state loopSum: Int32 = 0
    state whileCount: Int32 = 0
    state breakCount: Int32 = 0
    state continueSum: Int32 = 0
    state mapSum: Int32 = 0
    state catchCount: Int32 = 0

    body {
        StatusBar(style: Default, hidden: false, background: "#ffffff")
        OnAppear {
            Path.documents()
            actionArray.append(3)
            actionArray.remove(0)
            actionSet.insert("b")
            actionSet.remove("a")
            actionMap.set("b", 2)
            actionMap.remove("a")

            for index in 1..3 {
                loopSum = loopSum + index
            }
            while whileCount < 3 {
                whileCount = whileCount + 1
            }
            for index in 0..5 {
                if index == 2 {
                    break
                }
                breakCount = breakCount + 1
            }
            for index in 0..3 {
                if index == 1 {
                    continue
                }
                continueSum = continueSum + index
            }
            for (key, value) in actionMap {
                mapSum = mapSum + value
            }
            try {
                catchCount = catchCount + 1
            } catch {
                catchCount = 100
            }
        }
        Column {
            Card(title: "Reloaded") { Text("Projected child", fontSize: 8) }
            Row {
                Text("Binary and: \(3 < 4 && 5 >= 5)", fontSize: 8)
                Text("Contains: \(5 in numbers)", fontSize: 8)
                Text("Index: \(numbers[1])", fontSize: 8)
                Text("Coalesce: \(optional ?? \"fallback\")", fontSize: 8)
            }
            Text("Pair: \(Pair(7, 9).first), Mapped: \(numbers.map { item -> item + 1 }[1]), Filtered: \(numbers.filter { item -> item > 5 }[0]), Reduced: \(numbers.reduce(0) { total, item -> total + item })", fontSize: 8)
            Text("Int8: \(numericInt8), Int16: \(numericInt16), Int64: \(numericInt64); UInt8: \(numericUInt8), UInt16: \(numericUInt16), UInt32: \(numericUInt32), UInt64: \(numericUInt64); Float32: \(numericFloat32), Float64: \(numericFloat64)", fontSize: 8)
            Text("Set: \(4 in tags), Map: \(scores[\"nexa\"]), Triple: \(coordinates.third), Enum: \(mode), Result: \(result?), Result error: \(failure?), Struct: \(profile.name)", fontSize: 8)
            Text("Array mutation: \(actionArray[0]), Set mutation: \(\"b\" in actionSet), Map mutation: \(actionMap[\"b\"])", fontSize: 8)
            Text("For: \(loopSum), While: \(whileCount), Break: \(breakCount), Continue: \(continueSum), ForMap: \(mapSum), TryCatch: \(catchCount)", fontSize: 8)
            Text("Other comparisons: \(false || true), \(3 == 3), \(3 != 4), \(3 <= 3), \(4 > 3), \(!false)", fontSize: 8)
            Text("Size classes: \(Layout.isRegularWidth), \(Layout.isCompactWidth), \(Layout.isRegularHeight), \(Layout.isCompactHeight)", fontSize: 8)
            Text("Native path: \(Path.documents())", fontSize: 8)
            Row {
                Text("Static style", color: "#123456", fontSize: 18, fontWeight: Normal, lineLimit: 2, lineHeight: 20, letterSpacing: 1, selectable: true)
                Text("Adaptive style", color: Theme.accent, fontSize: 18, fontWeight: Medium)
                Text("Semibold style", fontWeight: Semibold, fontSize: 8)
                Text("Bold style", fontWeight: Bold, fontSize: 8)
            }
            Row {
                Column(alignment: Start, width: 200, minHeight: 20, maxHeight: 80, background: Theme.accent, cornerRadius: 8, borderColor: "#000000", borderWidth: 1, opacity: 1, animation: Spring) { Text("Styled start", fontSize: 8) }
                Row(alignment: Center, animation: EaseIn) { Text("Styled center", fontSize: 8) }
                Column(alignment: End, animation: EaseOut) { Text("Styled end", fontSize: 8) }
                Row(animation: EaseInOut) { Text("Ease in out", fontSize: 8) }
                Column(animation: Linear) { Text("Linear", fontSize: 8) }
            }
            Row {
                Accessibility(label: "Link role", role: Link) { Text("Accessible link", fontSize: 8) }
                Accessibility(label: "Header role", role: Header) { Text("Accessible header", fontSize: 8) }
                Accessibility(label: "Image role", role: Image) { Text("Accessible image", fontSize: 8) }
            Accessibility(label: "No role", role: None) { Text("Accessible none", fontSize: 8) }
            }
            Link(url: "https://example.com") { Text("External link", fontSize: 8) }
            TextInput(value: keyboardText, placeholder: "Keyboard text", keyboard: Text, capitalization: Sentences)
            TextInput(value: keyboardNumber, placeholder: "Keyboard number", keyboard: Number, capitalization: None)
            TextInput(value: keyboardEmail, placeholder: "Keyboard email", keyboard: Email, capitalization: Words)
            TextInput(value: keyboardPhone, placeholder: "Keyboard phone", keyboard: Phone, capitalization: Characters)
            TextInput(value: keyboardUrl, placeholder: "Keyboard url", keyboard: Url, capitalization: None)
            KeyboardAware(dismiss: Never) { Text("Never dismiss", fontSize: 8) }
            Row {
                Pressable(disabled: false, haptic: Light) { Text("Haptic light") }.onPress {}
                Pressable(disabled: false, haptic: Medium) { Text("Haptic medium") }.onPress {}
                Pressable(disabled: false, haptic: Heavy) { Text("Haptic heavy") }.onPress {}
            }
        }
    }
}
