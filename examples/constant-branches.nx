app ConstantBranches {
    state count: Int32 = 0

    body {
        if 1 < 2 {
            Text("Always visible")
        } else {
            Text("Removed at compile time")
        }

        Button("Use the known branch") {
            if false {
                count = 1
            } else {
                count = 2
            }
        }
    }
}
