struct User {
    name: String,
    enabled: Bool
}

app CollectionEquality {
    let labels = ["Nexa", "Swift"]
    let otherLabels = ["Nexa", "Swift"]
    let tags: Set<String> = ["mobile", "compiler"]
    let otherTags: Set<String> = ["compiler", "mobile"]
    let versions: Map<String, Int32> = ["ios": 16]
    let otherVersions: Map<String, Int32> = ["ios": 16]
    let selected = Pair("Nexa", 3)
    let otherSelected = Pair("Nexa", 3)
    let coordinates = Triple(10, 20, 30)
    let otherCoordinates = Triple(10, 20, 30)
    let user = User("Ada", true)
    let otherUser = User("Ada", true)

    body {
        Column(spacing: 8, padding: 20) {
            if labels == otherLabels {
                Text("Arrays match")
            }
            if tags == otherTags {
                Text("Sets match")
            }
            if versions == otherVersions {
                Text("Maps match")
            }
            if selected == otherSelected && coordinates == otherCoordinates {
                Text("Tuples match")
            }
            if user == otherUser {
                Text("Structs match")
            }
        }
    }
}
