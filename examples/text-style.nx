app TextStyleDemo {
    body {
        Column(spacing: 8) {
            Text("Regular text")
            Text("Medium text", fontWeight: Medium)
            Text("Important text", fontWeight: Bold)
            Text("This line is deliberately limited to one line of native text", lineLimit: 1)
            Text("Readable spacing", lineHeight: 24, letterSpacing: 0.5)
        }
    }
}
