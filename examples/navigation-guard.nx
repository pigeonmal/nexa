app NavigationGuardDemo {
    state isAuthenticated: Bool = false

    screen Home {
        Column {
            Text("Sign in to open your profile")
            NavigationLink(destination: Profile, when: isAuthenticated) {
                Text("Open profile")
            }
        }
    }

    screen Profile {
        Column {
            Text("Profile")
            NavigationBack()
        }
    }

    body {
        NavigationStack(root: Home)
    }
}
