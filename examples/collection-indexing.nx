app CollectionIndexingDemo {
    let labels = ["Nexa", "Swift", "Kotlin"]
    let selected = 1
    let versions: Map<String, Int32> = ["iOS": 18, "Android": 35]
    let release = versions["iOS"] ?? 0

    body {
        Column {
            Text(labels[selected])
            Text(release)
            FastList(labels) { label, position in
                Row(spacing: 8, alignment: Center) {
                    Text(position)
                    Text(label)
                }
            }
        }
    }
}
