app FastListScrollDemo {
    state scrollPosition: Int32 = 0
    state rows: Array<String> = ["First", "Second", "Third", "Fourth"]

    body {
        FastList(rows, key: .self, scrollPosition: scrollPosition, rowHeight: 56) { row, index in
            Text("\(index): \(row)")
        }
        Button("Jump to third") {
            scrollPosition = 2
        }
    }
}
