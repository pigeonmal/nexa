app ConditionalLogic {
    state count: Int32 = 0
    state enabled: Bool = true

    body {
        Text("Conditional rendering")
        if enabled && count < 5 {
            Text("The counter is active")
        } else if count == 5 {
            Text("The counter reached five")
        } else {
            Text("The counter is paused")
        }
        Button("Increment") {
            if enabled && count < 5 {
                count = count + 1
            } else {
                enabled = !enabled
            }
        }
    }
}
