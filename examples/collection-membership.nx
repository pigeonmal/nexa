app CollectionMembership {
    state selected: Int32 = 2
    let numbers: Set<Int32> = [1, 2, 3]
    let labels: Array<String> = ["nexa", "native"]
    let prices: Map<String, Int32> = ["basic": 10, "pro": 20]

    body {
        Column(spacing: 8, padding: 20) {
            if selected in numbers {
                Text("Selected number is available")
            }
            if "nexa" in labels {
                Text("Nexa label is available")
            }
            if "pro" in prices {
                Text("Pro price is available")
            }
        }
    }
}
