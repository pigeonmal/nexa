component ParityCard(title: String) {
    body {
        Column(spacing: 8, padding: 12, background: "#FFFFFF", cornerRadius: 16) {
            Text(title, fontSize: 13, color: "#777780")
            Content()
        }
    }
}

app ComponentParity {
    state appActivations: Int32 = 0
    state appDeactivations: Int32 = 0
    state appBackgroundEntries: Int32 = 0

    screen Catalog {
        Form {
            Section(title: "Layout") {
                NavigationLink(destination: ColumnCases) {
                    Text("Column spacing and padding")
                }
                NavigationLink(destination: RowCases) {
                    Text("Row spacing and alignment")
                }
                NavigationLink(destination: StackCases) {
                    Text("Stack overlay and alignment")
                }
                NavigationLink(destination: SpacerCases) {
                    Text("Spacer distribution")
                }
                NavigationLink(destination: DividerCases) {
                    Text("Divider thickness and color")
                }
                NavigationLink(destination: DirectionCases) {
                    Text("Layout direction baseline")
                }
            }
            Section(title: "Text and controls") {
                NavigationLink(destination: TextCases) {
                    Text("Text styles and sizing")
                }
                NavigationLink(destination: ButtonCases) {
                    Text("Button styles and states")
                }
                NavigationLink(destination: PressableCases) {
                    Text("Pressable gestures")
                }
                NavigationLink(destination: TextInputCases) {
                    Text("Text input variants")
                }
                NavigationLink(destination: SwitchCases) {
                    Text("Switch states")
                }
                NavigationLink(destination: SliderCases) {
                    Text("Slider values")
                }
                NavigationLink(destination: SegmentedCases) {
                    Text("Segmented control")
                }
                NavigationLink(destination: PickerCases) {
                    Text("Picker options")
                }
                NavigationLink(destination: DatePickerCases) {
                    Text("Date picker modes")
                }
            }
            Section(title: "Content and lists") {
                NavigationLink(destination: FormCases) {
                    Text("Form and section")
                }
                NavigationLink(destination: EmptyCases) {
                    Text("Content unavailable")
                }
                NavigationLink(destination: ProgressBarCases) {
                    Text("Progress bar values")
                }
                NavigationLink(destination: ProgressRingCases) {
                    Text("Progress ring values")
                }
                NavigationLink(destination: FastListCases) {
                    Text("FastList row sizing")
                }
                NavigationLink(destination: RefreshCases) {
                    Text("Pull to refresh")
                }
                NavigationLink(destination: KeyboardCases) {
                    Text("Keyboard-aware layout")
                }
            }
            Section(title: "Media and navigation") {
                NavigationLink(destination: IconCases) {
                    Text("Icon sizes and tint")
                }
                NavigationLink(destination: ImageCases) {
                    Text("Image asset rendering")
                }
                NavigationLink(destination: GradientCases) {
                    Text("Linear gradient")
                }
                NavigationLink(destination: LinkCases) {
                    Text("External link")
                }
                NavigationLink(destination: NavigationBackCases) {
                    Text("NavigationBack behavior")
                }
                NavigationLink(destination: ToolbarCases) {
                    Text("Toolbar placement")
                }
                NavigationLink(destination: PagerCases) {
                    Text("Page pager")
                }
                NavigationLink(destination: BottomBarCases) {
                    Text("App bottom bar")
                }
                NavigationLink(destination: SplitViewCases) {
                    Text("Adaptive split view")
                }
            }
            Section(title: "Presentation and environment") {
                NavigationLink(destination: SheetCases) {
                    Text("Bottom sheet")
                }
                NavigationLink(destination: DialogCases) {
                    Text("Dialog")
                }
                NavigationLink(destination: ConfirmationCases) {
                    Text("Confirmation dialog")
                }
                NavigationLink(destination: AppearanceCases) {
                    Text("Appearance")
                }
                NavigationLink(destination: StatusBarCases) {
                    Text("Status bar")
                }
                NavigationLink(destination: AccessibilityCases) {
                    Text("Accessibility semantics")
                }
                NavigationLink(destination: LifecycleCases) {
                    Text("Screen lifecycle")
                }
            }
        }
    }

    screen ColumnCases {
        state columnTestPage: Int32 = 0
        state columnAnimationExpanded: Bool = false
        Column(spacing: 10, padding: 16) {
            Text("Column", fontSize: 28, fontWeight: Bold)
            Row(spacing: 6) {
                Pressable(accessibilityLabel: "Flow and alignment tests", accessibilityRole: Button) {
                    Text("Flow")
                }.onTap { columnTestPage = 0 }
                Pressable(accessibilityLabel: "Size and bounds tests", accessibilityRole: Button) {
                    Text("Bounds")
                }.onTap { columnTestPage = 1 }
                Pressable(accessibilityLabel: "Surface and padding tests", accessibilityRole: Button) {
                    Text("Surface")
                }.onTap { columnTestPage = 2 }
                Pressable(accessibilityLabel: "Effects and behavior tests", accessibilityRole: Button) {
                    Text("Effects")
                }.onTap { columnTestPage = 3 }
                Pressable(accessibilityLabel: "Animation and accessibility tests", accessibilityRole: Button) {
                    Text("Behavior")
                }.onTap { columnTestPage = 4 }
            }

            if columnTestPage == 0 {
                ParityCard(title: "Spacing, nesting, and alignment") {
                    Column(spacing: 0, alignment: Start, width: 280, padding: 8, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Start · spacing 0")
                        Text("Second child")
                    }
                    Column(spacing: 8, alignment: Center, width: 280, padding: 8, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Center · spacing 8")
                        Text("Second child")
                    }
                    Column(spacing: 20, alignment: End, width: 280, padding: 8, background: "#F2F2F7", cornerRadius: 8) {
                        Text("End · spacing 20")
                        Text("Second child")
                    }
                    Column(spacing: 4, padding: 8, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Outer spacing: 4")
                        Column(spacing: 18) {
                            Text("Inner spacing: 18")
                            Text("Inner spacing stays local")
                        }
                        Text("Outer spacing resumes")
                    }
                }
            }

            if columnTestPage == 1 {
                ParityCard(title: "Fixed size and independent bounds") {
                    Column(width: 220, background: "#E8F0FF", cornerRadius: 8) {
                        Text("Fixed width: 220")
                    }
                    Column(height: 56, background: "#E8F0FF", cornerRadius: 8) {
                        Text("Fixed height: 56")
                    }
                    Column(width: 240, height: 72, minWidth: 220, maxWidth: 260, minHeight: 64, maxHeight: 80, background: "#FFFFFF", cornerRadius: 8, borderColor: "#2563EB", borderWidth: 1) {
                        Text("Fixed 240 × 72 inside 220–260 × 64–80")
                    }
                    Column(minWidth: 210, maxWidth: 260, minHeight: 64, maxHeight: 84, padding: 8, background: "#E8F0FF", cornerRadius: 8) {
                        Text("Minimum expands this short content")
                    }
                    Column(maxWidth: 170, padding: 8, background: "#FFF1E8", cornerRadius: 8) {
                        Text("Maximum width wraps this longer label onto multiple lines")
                    }
                    Column(width: 200, maxHeight: 68, spacing: 6, padding: 6, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Maximum height: 68")
                        Text("Second line")
                        Text("Third line")
                        Text("Fourth line")
                    }
                }
            }

            if columnTestPage == 2 {
                ParityCard(title: "Padding, background, border, and opacity") {
                    Column(spacing: 6, width: 280, height: 76, padding: 12, background: "#DDEBFF", cornerRadius: 14, borderColor: "#2563EB", borderWidth: 2) {
                        Text("12 dp padding")
                        Text("Blue fill · 14 dp corners · 2 dp border")
                    }
                    Column(width: 240, height: 52, padding: 8, background: "#E11D48", cornerRadius: 8, opacity: 0.45) {
                        Text("Opacity 0.45", color: "#FFFFFF")
                    }
                    Column(width: 240, height: 52, padding: 8, background: "#E11D48", cornerRadius: 8, opacity: 0.0) {
                        Text("Opacity 0.0 · transparent")
                    }
                    Column(width: 240, height: 52, padding: 8, background: "#34C759", cornerRadius: 8, opacity: 1.0) {
                        Text("Opacity 1.0", color: "#FFFFFF")
                    }
                    Column(spacing: 4, padding: 0, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Explicit zero padding")
                        Text("Compare with the padded card above")
                    }
                }
            }

            if columnTestPage == 3 {
                ParityCard(title: "Transforms, clipping, and order") {
                    Row(spacing: 24, height: 78, alignment: Center) {
                        Column(width: 90, height: 48, background: "#E11D48", cornerRadius: 8, scale: 1.2) {
                            Text("Scale", color: "#FFFFFF")
                        }
                        Column(width: 90, height: 48, background: "#2563EB", cornerRadius: 8, rotation: 12) {
                            Text("Rotate", color: "#FFFFFF")
                        }
                    }
                    Column(width: 240, height: 64, background: "#FFFFFF", cornerRadius: 12, shadow: Shadow(8, 4, 6, "#00000070")) {
                        Text("Shadow radius 8, offset 4 × 6")
                    }
                    Column(width: 240, height: 42, padding: 6, background: "#E8F0FF", cornerRadius: 8, blur: 2) {
                        Text("Blur radius 2")
                    }
                    Column(width: 180, height: 64, background: "#DDEBFF", clip: Rounded(14)) {
                        Column(width: 112, height: 84, background: "#E11D48", rotation: 28, cornerRadius: 4) {
                            Text("Clipped", color: "#FFFFFF")
                        }
                    }
                    Stack(width: 260, height: 96, background: "#F2F2F7", cornerRadius: 8, glass: "rounded(8)") {
                        Column(width: 190, height: 68, background: "#E11D48", cornerRadius: 8, zIndex: 2) {
                            Text("First child · zIndex 2", color: "#FFFFFF")
                        }
                        Column(width: 145, height: 84, background: "#2563EB", cornerRadius: 8, zIndex: 1) {
                            Text("Later child · zIndex 1", color: "#FFFFFF")
                        }
                    }
                    Column(spacing: 6, width: 280, padding: 8, background: "#F2F2F7", cornerRadius: 12) {
                        Row(spacing: 8, alignment: Center) {
                            Column(width: 64, height: 48, cornerRadius: 24, glass: "circle") {
                                Text("Circle")
                            }
                            Column(width: 78, height: 48, cornerRadius: 24, glass: "capsule") {
                                Text("Capsule")
                            }
                            Column(width: 94, height: 48, cornerRadius: 12, glass: "rounded(12)") {
                                Text("Rounded")
                            }
                        }
                        Column(width: 240, height: 48, glass: Glass(shape: "capsule", tint: "#E11D48")) {
                            Text("Tinted capsule")
                        }
                    }
                }
            }

            if columnTestPage == 4 {
                ParityCard(title: "Animation variants and accessibility") {
                    Column(width: 260, minHeight: 56, padding: 10, background: "#E8F0FF", cornerRadius: 10, animation: EaseInOut) {
                        Text("EaseInOut · expanded: $columnAnimationExpanded")
                        if columnAnimationExpanded {
                            Text("This changes the Column size")
                        }
                    }
                    Column(minHeight: 36, padding: 6, background: "#F2F2F7", cornerRadius: 8, animation: EaseIn) {
                        Text("EaseIn")
                        if columnAnimationExpanded { Text("Expanded") }
                    }
                    Column(minHeight: 36, padding: 6, background: "#F2F2F7", cornerRadius: 8, animation: EaseOut) {
                        Text("EaseOut")
                        if columnAnimationExpanded { Text("Expanded") }
                    }
                    Column(minHeight: 36, padding: 6, background: "#F2F2F7", cornerRadius: 8, animation: Linear) {
                        Text("Linear")
                        if columnAnimationExpanded { Text("Expanded") }
                    }
                    Column(minHeight: 36, padding: 6, background: "#F2F2F7", cornerRadius: 8, animation: Spring(response: 0.35, damping: 0.8)) {
                        Text("Spring")
                        if columnAnimationExpanded { Text("Expanded") }
                    }
                    Button("Toggle animated content") {
                        columnAnimationExpanded = !columnAnimationExpanded
                    }
                    Column(padding: 8, background: "#F2F2F7", cornerRadius: 8, accessibilityLabel: "Column accessibility sample", accessibilityHint: "Demonstrates Column semantics", accessibilityValue: "Ready", accessibilityRole: Header) {
                        Text("Accessible Column")
                    }
                    Row(spacing: 6, alignment: Center) {
                        Column(padding: 6, background: "#F2F2F7", cornerRadius: 8, accessibilityLabel: "Button role sample", accessibilityRole: Button) {
                            Text("Button role")
                        }
                        Column(padding: 6, background: "#F2F2F7", cornerRadius: 8, accessibilityLabel: "Link role sample", accessibilityRole: Link) {
                            Text("Link role")
                        }
                    }
                    Row(spacing: 6, alignment: Center) {
                        Column(padding: 6, background: "#F2F2F7", cornerRadius: 8, accessibilityLabel: "Image role sample", accessibilityRole: Image) {
                            Text("Image role")
                        }
                        Column(padding: 6, background: "#F2F2F7", cornerRadius: 8, accessibilityLabel: "None role sample", accessibilityRole: None) {
                            Text("None role")
                        }
                    }
                }
            }
        }
    }

    screen RowCases {
        Column(spacing: 12, padding: 16) {
            Text("Row", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Spacing and vertical alignment") {
                Row(spacing: 0, height: 48, background: "#F2F2F7") {
                    Text("Zero")
                    Text("Gap")
                }
                Row(spacing: 12, height: 48, alignment: Center, background: "#F2F2F7") {
                    Text("Twelve")
                    Text("Centered")
                }
                Row(spacing: 24, height: 48, padding: 8, background: "#F2F2F7") {
                    Text("Twenty-four")
                    Text("With padding")
                }
                Column(width: 280, padding: 8, background: "#F2F2F7", cornerRadius: 12) {
                    Row(spacing: 8, alignment: Center, width: 180, height: 48, padding: 8, glass: "capsule") {
                        Text("Glass capsule row")
                    }
                }
                Row(
                spacing: 8,
                alignment: Center,
                padding: 4,
                width: 280,
                height: 56,
                minWidth: 240,
                maxWidth: 300,
                minHeight: 48,
                maxHeight: 64,
                background: "#FFFFFF",
                cornerRadius: 8,
                borderColor: "#2563EB",
                borderWidth: 1,
                opacity: 1.0,
                scale: 1.0,
                rotation: 0,
                shadow: Shadow(1, 0, 0, "#00000020"),
                blur: 0,
                clip: Rounded(8),
                zIndex: 1,
                animation: EaseInOut
                ) {
                    Text("Row sizing and visual parameters")
                }
            }
        }
    }

    screen StackCases {
        Column(spacing: 12, padding: 16) {
            Text("Stack", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Center and corner alignment") {
                Stack(alignment: Center, width: 160, height: 96, background: "#DDEBFF", cornerRadius: 12) {
                    Text("Centered")
                    Icon(system: "star", size: 24, tint: "#E11D48", description: "Star")
                }
                Stack(alignment: End, width: 160, height: 96, background: "#F2F2F7", cornerRadius: 12) {
                    Text("End aligned")
                }
                Stack(
                alignment: Center,
                padding: 4,
                width: 240,
                height: 64,
                minWidth: 220,
                maxWidth: 260,
                minHeight: 56,
                maxHeight: 72,
                background: "#FFFFFF",
                cornerRadius: 8,
                borderColor: "#34C759",
                borderWidth: 1,
                opacity: 1.0,
                scale: 1.0,
                rotation: 0,
                shadow: Shadow(1, 0, 0, "#00000020"),
                blur: 0,
                clip: Rounded(8),
                zIndex: 1,
                animation: Linear
                ) {
                    Text("Stack sizing and visual parameters")
                }
            }
        }
    }

    screen SpacerCases {
        Column(spacing: 12, padding: 16) {
            Text("Spacer", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Flexible space in a row") {
                Row(height: 56, padding: 8, background: "#F2F2F7") {
                    Text("Leading")
                    Spacer()
                    Text("Trailing")
                }
                Row(height: 80, padding: 8, background: "#F2F2F7") {
                    Text("Two spacers")
                    Spacer()
                    Text("Center")
                    Spacer()
                    Text("End")
                }
            }
        }
    }

    screen DividerCases {
        Column(spacing: 12, padding: 16) {
            Text("Divider", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Same color, varied thickness") {
                Text("One dp")
                Divider(color: "#8E8E93", thickness: 1)
                Text("Two dp")
                Divider(color: "#8E8E93", thickness: 2)
                Text("Four dp")
                Divider(color: "#8E8E93", thickness: 4)
            }
        }
    }

    screen TextCases {
        Column(spacing: 12, padding: 16) {
            Text("Text", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Shared font size, weight, and line metrics") {
                Text("Normal 14", fontSize: 14, fontWeight: Normal)
                Text("Medium 18", fontSize: 18, fontWeight: Medium)
                Text("Semibold 22", fontSize: 22, fontWeight: Semibold)
                Text("Bold 26", fontSize: 26, fontWeight: Bold)
                Text("Italic text", italic: true, fontDesign: Serif)
                Text("Underlined text", underline: true, fontDesign: Rounded)
                Text("Combined emphasis", italic: true, underline: true, strikethrough: true, fontDesign: Monospaced)
                Text("Serif design", fontDesign: Serif)
                Text("Rounded design", fontDesign: Rounded)
                Text("Monospaced design", fontDesign: Monospaced)
                Text("Two-line text checks line height and wrapping across both platforms.", fontSize: 16, lineHeight: 22)
                Text(
                "Aligned text with visual effects",
                comment: "Text appearance parity sample",
                alignment: Center,
                fontStyle: Body,
                fontSize: 16,
                opacity: 1.0,
                scale: 1.0,
                rotation: 0,
                shadow: Shadow(1, 0, 0, "#00000020"),
                blur: 0,
                clip: Rounded(4),
                zIndex: 1,
                lineLimit: 2,
                letterSpacing: 0.2,
                selectable: true
                )
                Column(spacing: 0, padding: 8, background: "#F2F2F7", cornerRadius: 8) {
                    Text("Default text padding")
                    Text("Explicit zero padding", padding: 0)
                    Text("Explicit 12 dp padding", padding: 12)
                }
            }
        }
    }

    screen ButtonCases {
        state taps: Int32 = 0
        Column(spacing: 12, padding: 16) {
            Text("Button", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Style, size, shape, and state") {
                Text("Enabled taps: $taps")
                Button("Prominent", style: BorderedProminent, tint: "#E11D48") {
                    taps = taps + 1
                }
                Button("Bordered", style: Bordered) {
                    taps = taps + 1
                }
                Button("Plain", style: Plain) {
                    taps = taps + 1
                }
                Button("Disabled", disabled: true)
                Button("Loading", loading: true)
                Button("Glass icon", comment: "Icon and glass style parity", icon: "star", glass: true, style: Bordered) {
                    taps = taps + 1
                }
                Button("Large capsule", size: Large, shape: Capsule) {
                    taps = taps + 1
                }
            }
        }
    }

    screen PressableCases {
        state pressableTaps: Int32 = 0
        state disabledTaps: Int32 = 0
        state longPresses: Int32 = 0
        state doubleTaps: Int32 = 0
        state contextActions: Int32 = 0
        state dragUpdated: Bool = false
        state pinchUpdated: Bool = false
        Column(spacing: 12, padding: 16) {
            Text("Pressable", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Tap, press, and custom actions") {
                Text("Tap events: $pressableTaps")
                Pressable(haptic: Light) {
                    Text("Tap count: $pressableTaps")
                }.onTap {
                    pressableTaps = pressableTaps + 1
                }
                Pressable(disabled: true) {
                    Text("Disabled taps: $disabledTaps")
                }.onTap {
                    disabledTaps = disabledTaps + 1
                }
                Pressable() {
                    Text("Long press count: $longPresses")
                }.onTap {
                    pressableTaps = pressableTaps + 1
                }.onLongPress(durationMs: 500) {
                    longPresses = longPresses + 1
                }
                Pressable() {
                    Text("Double tap count: $doubleTaps")
                }.onTap {
                    pressableTaps = pressableTaps + 1
                }.onDoubleTap {
                    doubleTaps = doubleTaps + 1
                }.onLongPress(durationMs: 500) {
                    longPresses = longPresses + 1
                }
                Pressable() {
                    Text("Context actions: $contextActions")
                }.onTap {
                    pressableTaps = pressableTaps + 1
                }.contextMenu {
                    Button("Increment context action") {
                        contextActions = contextActions + 1
                    }
                }
            }
            ParityCard(title: "Drag and pinch values") {
                Pressable() {
                    Text("Drag updated: $dragUpdated")
                }.onTap {
                    pressableTaps = pressableTaps + 1
                }.onDrag {
                    translationX, translationY, velocityX, velocityY ->
                    dragUpdated = translationX != 0.0
                }
                Pressable() {
                    Text("Pinch updated: $pinchUpdated")
                }.onTap {
                    pressableTaps = pressableTaps + 1
                }.onPinch {
                    scaleFactor ->
                    pinchUpdated = scaleFactor != 1.0
                }
            }
            ParityCard(title: "Fill available parent size") {
                Stack(width: 280, height: 64, background: "#F2F2F7", cornerRadius: 8) {
                    Pressable(fillMaxSize: true) {
                        Text("Full-size pressable")
                    }.onTap {
                        pressableTaps = pressableTaps + 1
                    }
                }
            }
        }
    }

    screen TextInputCases {
        state shortText: String = ""
        state email: String = ""
        state notes: String = ""
        state password: String = ""
        state emailFocused: Bool = false
        Column(spacing: 12, padding: 16) {
            Text("TextInput", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Placeholder, keyboard, and multiline") {
                TextInput(value: shortText, placeholder: "Task name", maxLength: 40)
                TextInput(value: email, placeholder: "Email search", comment: "Searchable autofill input", keyboardType: Email, autofill: Username, returnKeyType: Next, capitalization: None, autocorrect: false, focused: emailFocused, font: Body, searchable: true)
                TextInput(value: password, placeholder: "Password", comment: "Secure password input", keyboardType: Text, isSecure: true, autofill: Password, returnKeyType: Done, autocorrect: false, capitalization: None, font: Body)
                TextInput(value: notes, placeholder: "Notes", multiline: true, minLines: 3, maxLines: 5)
            }
        }
    }

    screen SwitchCases {
        state off: Bool = false
        state on: Bool = true
        Column(spacing: 12, padding: 16) {
            Text("Switch", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Off and on states with labels") {
                Switch(value: off, label: "Notifications")
                Switch(value: on, label: "Open links in app", comment: "Switch with supporting detail")
            }
        }
    }

    screen SliderCases {
        state sliderLow: Float64 = 0.0
        state sliderMiddle: Float64 = 0.5
        state sliderHigh: Float64 = 1.0
        Column(spacing: 12, padding: 16) {
            Text("Slider", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Minimum, middle, maximum, and stepped values") {
                Text("Min: $sliderLow")
                Slider(value: sliderLow, min: 0, max: 1, step: 0.1)
                Text("Middle: $sliderMiddle")
                Slider(value: sliderMiddle, min: 0, max: 1, step: 0.05)
                Text("Max: $sliderHigh")
                Slider(value: sliderHigh, min: 0, max: 1, step: 0.25)
            }
        }
    }

    screen SegmentedCases {
        state segment: String = "Day"
        state choices: Array<String> = ["Day", "Week", "Month"]
        Column(spacing: 12, padding: 16) {
            Text("SegmentedControl", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Selection, widths, and longer labels") {
                SegmentedControl(items: choices, selected: segment, comment: "Switch the visible date range", accessibilityLabel: "Time range")
                Text("Selected: $segment")
            }
        }
    }

    screen PickerCases {
        state sort: String = "Due date"
        state sortOptions: Array<String> = ["Due date", "Priority", "Title"]
        Column(spacing: 12, padding: 16) {
            Text("Picker", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Selected value and custom label") {
                Picker(items: sortOptions, selected: sort, icon: "sort", label: "Sort tasks", tint: "#E11D48", comment: "Choose the task sort order")
                Text("Selected: $sort")
            }
        }
    }

    screen DatePickerCases {
        state timestamp: Int64 = Time.now()
        state includeTime: Bool = false
        state dateAndTime: Bool = true
        Column(spacing: 12, padding: 16) {
            Text("DatePicker", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Date-only and date-with-time modes") {
                DatePicker(timestamp: timestamp, hasTime: includeTime, accessibilityLabel: "Date only")
                DatePicker(timestamp: timestamp, hasTime: dateAndTime, accessibilityLabel: "Date and time")
            }
        }
    }

    screen FormCases {
        Column(spacing: 12, padding: 16) {
            Text("Form and Section", fontSize: 28, fontWeight: Bold)
            Form {
                Section(title: "First group", footer: "First section footer", comment: "Grouped rows with explanatory footer") {
                    Text("First row")
                    Divider(color: "#8E8E93", thickness: 1)
                    Text("Second row")
                }
                Section(title: "Second group") {
                    Text("One row")
                }
            }
        }
    }

    screen EmptyCases {
        Column(spacing: 12, padding: 16) {
            Text("ContentUnavailable", fontSize: 28, fontWeight: Bold)
            ContentUnavailable(title: "No saved tasks", icon: "inbox", description: "Saved tasks will appear here.", comment: "Empty state with supporting detail")
            ContentUnavailable(title: "No search results", icon: "search", description: "Try a different keyword.")
        }
    }

    screen ProgressBarCases {
        state barZero: Float64 = 0.0
        state barMiddle: Float64 = 0.45
        state barFull: Float64 = 1.0
        Column(spacing: 12, padding: 16) {
            Text("ProgressBar", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Zero, partial, and complete") {
                ProgressBar(progress: barZero, accessibilityLabel: "No progress")
                ProgressBar(progress: barMiddle, accessibilityLabel: "Partial progress")
                ProgressBar(progress: barFull, accessibilityLabel: "Complete progress")
            }
        }
    }

    screen ProgressRingCases {
        state ringZero: Float64 = 0.0
        state ringMiddle: Float64 = 0.45
        state ringFull: Float64 = 1.0
        Column(spacing: 12, padding: 16) {
            Text("ProgressRing", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Zero, partial, and complete") {
                Row(spacing: 24, alignment: Center) {
                    ProgressRing(progress: ringZero, accessibilityLabel: "No progress")
                    ProgressRing(progress: ringMiddle, accessibilityLabel: "Partial progress")
                    ProgressRing(progress: ringFull, accessibilityLabel: "Complete progress")
                }
            }
        }
    }

    screen FastListCases {
        state listPosition: Int32 = 0
        state allowGridScroll: Bool = true
        Column(spacing: 12, padding: 16) {
            Text("FastList", fontSize: 28, fontWeight: Bold)
            Text("Fixed row height: 56 dp")
            FastList(count: 12, rowHeight: 56, spacing: 8, accessibilityLabel: "Component parity rows") {
                index in
                Row(spacing: 12, padding: 8, background: "#FFFFFF", cornerRadius: 12) {
                    Icon(system: "check_circle", size: 20, tint: "#E11D48", description: "Task")
                    Text("Parity row \(index)")
                }
            }
            FastList(count: 6, scrollPosition: listPosition, reverseLayout: true, accessibilityLabel: "Reversed rows") {
                index in
                Text("Reverse row \(index)")
            }
            FastList(count: 6, native: true, accessibilityLabel: "Native rows") {
                index in
                Text("Native row \(index)")
            }
            FastList(count: 4, axis: Horizontal, rowHeight: 96, spacing: 12, accessibilityLabel: "Horizontal rows") {
                index in
                Text("Horizontal row \(index)")
            }
            Text("Fixed two-column grid")
            FastList(count: 6, axis: Grid(2), rowHeight: 92, spacing: 4, accessibilityLabel: "Fixed two-column grid") {
                index in
                Column(padding: 8, background: "#FFFFFF", cornerRadius: 8) {
                    Text("Fixed grid \(index)")
                }
            }
            Text("Responsive grid with 160 dp minimum cells")
            Switch(value: allowGridScroll, label: "Allow adaptive grid scrolling")
            FastList(count: 6, axis: AutoGrid(160), rowHeight: 92, spacing: 4, scrollEnabled: allowGridScroll, accessibilityLabel: "Adaptive grid") {
                index in
                Column(padding: 8, background: "#FFFFFF", cornerRadius: 8) {
                    Text("Adaptive grid \(index)")
                }
            }
            FastList(count: 3, pageSnap: true, accessibilityLabel: "Paged vertical rows") {
                index in
                Text("Page \(index)")
            }
        }
    }

    screen RefreshCases {
        state refreshing: Bool = false
        state refreshCount: Int32 = 0
        Column(spacing: 12, padding: 16) {
            Text("RefreshControl", fontSize: 28, fontWeight: Bold)
            Text("Refreshes: $refreshCount")
            RefreshControl(isRefreshing: refreshing) {
                Column(spacing: 16, padding: 20, minHeight: 320, background: "#FFFFFF", cornerRadius: 16) {
                    Text("Pull down to refresh")
                    Text("Keep scrolling content stable while refreshing.")
                }
            }.onRefresh {
                refreshing = false
                refreshCount = refreshCount + 1
            }
        }
    }

    screen KeyboardCases {
        state text: String = ""
        Column(spacing: 12, padding: 16) {
            Text("KeyboardAware", fontSize: 28, fontWeight: Bold)
            KeyboardAware(dismiss: Never) {
                Column(spacing: 12, padding: 16, background: "#FFFFFF", cornerRadius: 16) {
                    TextInput(value: text, placeholder: "Enter a task")
                    Button("Save draft") {
                        text = text
                    }
                    Text("Content above should remain visible when the keyboard opens.")
                }
            }
        }
    }

    screen IconCases {
        Column(spacing: 12, padding: 16) {
            Text("Icon", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Size and tint") {
                Row(spacing: 24, alignment: Center) {
                    Icon(system: "search", size: 20, tint: "#8E8E93", description: "Small search")
                    Icon(system: "search", size: 32, tint: "#007AFF", description: "Medium search")
                    Icon(system: "search", size: 48, tint: "#E11D48", description: "Large search")
                }
                Icon(sfsymbol: "star.fill", size: 24, tint: "#E11D48", description: "Native iOS symbol")
                Icon(materialsymbol: "star", size: 24, tint: "#E11D48", description: "Native Android symbol")
            }
        }
    }

    screen ImageCases {
        Column(spacing: 12, padding: 16) {
            Text("Image", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Asset, fit, and crop") {
                Image(asset: "parity_sample", description: "Parity sample", scale: Fit, maxHeight: 120)
                Image(asset: "parity_sample", description: "Parity sample cropped", scale: Fill, fillMaxSize: false, maxHeight: 80)
                Image(url: "https://parity.invalid/image.png", description: "Remote image fallback", scale: Fit, placeholder: "parity_sample", maxHeight: 80)
                Image(url: "https://127.0.0.1:1/image.png", description: "Remote image blank by default", maxHeight: 80)
                Image(url: "https://127.0.0.1:1/image.png", description: "Opt-in remote loading indicator", showLoadingIndicator: true, maxHeight: 80)
                Image(file: "/tmp/nexa-parity-missing-image.png", description: "Local file fallback", scale: Fit, maxHeight: 80)
            }
        }
    }

    screen GradientCases {
        Column(spacing: 12, padding: 16) {
            Text("LinearGradient", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Direction and fixed height") {
                LinearGradient(startColor: "#E11D48", endColor: "#2563EB", direction: LeadingToTrailing, height: 64)
                LinearGradient(startColor: "#E11D48", endColor: "#2563EB", direction: TopToBottom, height: 120)
            }
        }
    }

    screen LinkCases {
        Column(spacing: 12, padding: 16) {
            Text("Link", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Inline link sizing and accessibility") {
                Link(url: "https://example.com", accessibilityLabel: "Open example website") {
                    Text("Open example website")
                }
            }
        }
    }

    screen NavigationBackCases {
        state canOpenDirection: Bool = true
        Column(spacing: 12, padding: 16) {
            Text("NavigationBack", fontSize: 28, fontWeight: Bold)
            Text("Compare the explicit back control with each platform's navigation header.")
            NavigationBack(label: "Return to component index", comment: "Explicit back label parity sample")
            NavigationLink(destination: DirectionCases, when: canOpenDirection) {
                Text("Conditional navigation link")
            }
        }
    }

    screen ToolbarCases {
        state actions: Int32 = 0
        Column(spacing: 12, padding: 16) {
            Toolbar(placement: Trailing) {
                Button("Action $actions", accessibilityLabel: "Toolbar action") {
                    actions = actions + 1
                }
            }
            Text("Toolbar", fontSize: 28, fontWeight: Bold)
            Text("Tap the trailing action and compare title placement.")
        }
    }

    screen PagerCases {
        state page: Int32 = 0
        Column(spacing: 12, padding: 16) {
            Text("PagePager", fontSize: 28, fontWeight: Bold)
            PagePager(selected: page, accessibilityLabel: "Parity pages") {
                Tab(index: 0) {
                    Column(spacing: 12, padding: 24, alignment: Center) {
                        Text("First page")
                        Button("Next") {
                            page = 1
                        }
                    }
                }
                Tab(index: 1) {
                    Column(spacing: 12, padding: 24, alignment: Center) {
                        Text("Second page")
                        Button("Previous") {
                            page = 0
                        }
                    }
                }
            }
        }
    }

    screen BottomBarCases {
        state selectedTab: Int32 = 0
        AppBottomBar(selected: selectedTab, tint: "#E11D48") {
            Tab(index: 0, label: "Inbox", icon: "inbox", title: "Inbox") {
                Column(spacing: 12, padding: 16) {
                    Text("Inbox tab content")
                }
            }
            Tab(index: 1, label: "Today", icon: "sun", title: "Today") {
                Column(spacing: 12, padding: 16) {
                    Text("Today tab content")
                }
            }
            Tab(index: 2, label: "Search", icon: "search", title: "Search") {
                Column(spacing: 12, padding: 16) {
                    Text("Search tab content")
                }
            }
        }
    }

    screen SplitViewCases {
        state detailVisible: Bool = false
        NavigationSplitView(detailVisible: detailVisible) {
            Sidebar {
                Column(spacing: 12, padding: 16) {
                    Text("Sidebar")
                    Button("Show detail") {
                        detailVisible = true
                    }
                }
            }
            Detail {
                Column(spacing: 12, padding: 16) {
                    Text("Detail")
                    Button("Show sidebar") {
                        detailVisible = false
                    }
                }
            }
        }
    }

    screen SheetCases {
        state sheetPresented: Bool = false
        state largeSheetPresented: Bool = false
        Column(spacing: 12, padding: 16) {
            Text("BottomSheet", fontSize: 28, fontWeight: Bold)
            Button("Open partial sheet") {
                sheetPresented = true
            }
            Button("Open large-only sheet") {
                largeSheetPresented = true
            }
            BottomSheet(isPresented: sheetPresented, partial: true, title: "Parity sheet") {
                Toolbar(placement: Trailing) {
                    Button("Dismiss") {
                        sheetPresented = false
                    }
                    Button("Prominent", style: BorderedProminent, tint: "#E11D48") {
                        sheetPresented = false
                    }
                }
                Column(spacing: 12, padding: 24) {
                    Text("Sheet content")
                    Button("Dismiss") {
                        sheetPresented = false
                    }
                }
            }
            BottomSheet(isPresented: largeSheetPresented, partial: false, largeOnly: true, title: "Large-only parity sheet") {
                Column(spacing: 12, padding: 24) {
                    Text("Large-only sheet content")
                    Button("Dismiss") {
                        largeSheetPresented = false
                    }
                }
            }
        }
    }

    screen DialogCases {
        state dialogPresented: Bool = false
        Column(spacing: 12, padding: 16) {
            Text("Dialog", fontSize: 28, fontWeight: Bold)
            Button("Open dialog") {
                dialogPresented = true
            }
            Dialog(isPresented: dialogPresented, title: "Delete task?", message: "This action can be undone.", comment: "Dialog with cancel and delete actions") {
                Button("Cancel") {
                    dialogPresented = false
                }
                Button("Delete") {
                    dialogPresented = false
                }
            }
        }
    }

    screen ConfirmationCases {
        state confirmationPresented: Bool = false
        Column(spacing: 12, padding: 16) {
            Text("ConfirmationDialog", fontSize: 28, fontWeight: Bold)
            Button("Open actions") {
                confirmationPresented = true
            }
            ConfirmationDialog(isPresented: confirmationPresented, title: "Task actions", comment: "Context actions for a task") {
                Button("Mark complete") {
                    confirmationPresented = false
                }
                Button("Cancel") {
                    confirmationPresented = false
                }
            }
        }
    }

    screen AppearanceCases {
        Column(spacing: 12, padding: 16) {
            Text("Appearance", fontSize: 28, fontWeight: Bold)
            Appearance(mode: "light") {
                Column(spacing: 8, padding: 12, cornerRadius: 16) {
                    Text("Light appearance surface")
                }
            }
            Appearance(mode: "dark") {
                Column(spacing: 8, padding: 12, cornerRadius: 16) {
                    Text("Dark appearance surface")
                }
            }
        }
    }

    screen StatusBarCases {
        StatusBar(style: Default, hidden: false, background: "#F2F2F7")
        Column(spacing: 12, padding: 16) {
            Text("StatusBar", fontSize: 28, fontWeight: Bold)
            Text("Compare status-bar foreground, background, and safe-area handling.")
        }
    }

    screen AccessibilityCases {
        state selected: Bool = false
        Column(spacing: 12, padding: 16) {
            Text("Accessibility", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Role, label, value, and action") {
                Text("Section title", accessibilityLabel: "Parity section heading", accessibilityHint: "Introduces the controls below", accessibilityRole: Header)
                Button("Toggle selection", accessibilityLabel: "Selection", accessibilityValue: "Selected: $selected") {
                    selected =!selected
                }
                Icon(system: "check_circle", size: 24, tint: "#E11D48", description: "Selected state", accessibilityLabel: "Selected state", accessibilityRole: Image)
            }
        }
    }

    screen LifecycleCases {
        state appearances: Int32 = 0
        state departures: Int32 = 0
        OnAppear {
            appearances = appearances + 1
        }
        OnDisappear {
            departures = departures + 1
        }
        Column(spacing: 12, padding: 16) {
            Text("Screen lifecycle", fontSize: 28, fontWeight: Bold)
            Text("Appearances: $appearances")
            Text("Departures: $departures")
            Text("App active events: $appActivations")
            Text("App inactive events: $appDeactivations")
            Text("App background events: $appBackgroundEntries")
            Text("Navigate away and back to compare lifecycle delivery.")
        }
    }

    screen DirectionCases {
        Column(spacing: 12, padding: 16) {
            Text("Direction", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Explicit left-to-right app environment") {
                Text("The app pins LTR to make paired layout screenshots deterministic.")
                Row(spacing: 12, padding: 12, background: "#F2F2F7", cornerRadius: 12) {
                    Text("Leading")
                    Spacer()
                    Text("Trailing")
                }
            }
        }
    }

    body {
        OnActive {
            appActivations = appActivations + 1
        }
        OnInactive {
            appDeactivations = appDeactivations + 1
        }
        OnBackground {
            appBackgroundEntries = appBackgroundEntries + 1
        }
        Direction(value: LTR)
        NavigationStack(root: Catalog)
    }
}
