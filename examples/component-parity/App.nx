    screen TextCases {
        state textTestPage: Int32 = 0
        state textInterpolationFloat64: Float64 = 0.25
        state textInterpolationFloat32: Float32 = 0.125
        state textInterpolationInteger: Int32 = 42
        Column(spacing: 10, padding: 16) {
            Text("Text", fontSize: 28, fontWeight: Bold)
            Row(spacing: 12) {
                Pressable(accessibilityLabel: "Text typography tests", accessibilityRole: Button) {
                    Text("Typography", fontSize: 13)
                }.onTap {
                    textTestPage = 0
                }
                Pressable(accessibilityLabel: "Text layout and effects tests", accessibilityRole: Button) {
                    Text("Layout + effects", fontSize: 13)
                }.onTap {
                    textTestPage = 1
                }
                Pressable(accessibilityLabel: "Text semantic font styles", accessibilityRole: Button) {
                    Text("Font styles", fontSize: 13)
                }.onTap {
                    textTestPage = 2
                }
            }
            if textTestPage == 0 {
                ParityCard(title: "Font sizes, weights, and designs") {
                    Text("Normal 14", fontSize: 14, fontWeight: Normal)
                    Text("Medium 18", fontSize: 18, fontWeight: Medium)
                    Text("Semibold 22", fontSize: 22, fontWeight: Semibold)
                    Text("Bold 26", fontSize: 26, fontWeight: Bold)
                    Text("Italic text", italic: true, fontDesign: Serif)
                    Text("Underlined text", underline: true, fontDesign: Rounded)
                    Text("Combined emphasis", italic: true, underline: true, strikethrough: true, fontDesign: Monospaced)
                    Text("Default design", fontDesign: Default)
                    Text("Serif design", fontDesign: Serif)
                    Text("Serif 18", fontSize: 18, fontDesign: Serif, comment: "Serif typeface at a custom size")
                    Text("Rounded design", fontDesign: Rounded)
                    Text("Monospaced design", fontDesign: Monospaced)
                }
                ParityCard(title: "Typed numeric interpolation · device locale") {
                    Text("Float64: \(textInterpolationFloat64)")
                    Text("Float32: \(textInterpolationFloat32)")
                    Text("Int32: \(textInterpolationInteger)")
                    Row(spacing: 8) {
                        Button("Use boundary values") {
                            textInterpolationFloat64 = - 0.2
                            textInterpolationFloat32 = 1.5
                            textInterpolationInteger = - 7
                        }
                        Button("Reset values") {
                            textInterpolationFloat64 = 0.25
                            textInterpolationFloat32 = 0.125
                            textInterpolationInteger = 42
                        }
                    }
                }
            }
            if textTestPage == 1 {
                ParityCard(title: "Layout, constraints, and effects") {
                    Text("Leading alignment\nshort", alignment: Leading, color: "#FF3B30")
                    Text("Centered alignment\nshort", alignment: Center, color: "#007AFF")
                    Text("Trailing alignment\nshort", alignment: Trailing, color: "#E11D48")
                    Text("Caption font style", fontStyle: Caption, color: "#007AFF")
                    Text("Explicit line height\nkeeps both lines readable", fontSize: 16, lineHeight: 22, lineLimit: 2)
                    Text("Line limit\nhides the next line", lineLimit: 1)
                    Stack(alignment: Start, width: 220, height: 32, background: "#F2F2F7", cornerRadius: 4) {
                        Text("This fixed-width text must truncate with an ellipsis", fontSize: 14, lineLimit: 1)
                    }
                    Text("Letter spacing", letterSpacing: 0.8)
                    Row(spacing: 12) {
                        Text("Opacity", fontSize: 14, opacity: 0.55)
                        Text("Scale", fontSize: 14, scale: 1.08)
                        Text("Rotate", fontSize: 14, rotation: 3)
                    }
                    Row(spacing: 12) {
                        Text("Shadow", fontSize: 14, shadow: Shadow(4, 2, 2, "#00000066"))
                        Text("Blur", fontSize: 14, blur: 1)
                        Text("Clip", fontSize: 14, clip: Rounded(6))
                    }
                    Stack(width: 220, height: 44, background: "#F2F2F7") {
                        Text("Above", color: "#FF3B30", fontSize: 20, fontWeight: Bold, zIndex: 2)
                        Text("Below", color: "#007AFF", fontSize: 12, zIndex: 1)
                    }
                    Column(spacing: 0, padding: 8, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Default text padding")
                        Text("Explicit zero padding", padding: 0)
                        Text("Explicit 12 dp padding", padding: 12)
                    }
                    Text("Selectable text", selectable: true)
                }
            }
            if textTestPage == 2 {
                ParityCard(title: "Semantic font styles") {
                    Text("LargeTitle", fontStyle: LargeTitle)
                    Text("Title", fontStyle: Title)
                    Text("Title2", fontStyle: Title2)
                    Text("Title3", fontStyle: Title3)
                    Text("Headline", fontStyle: Headline)
                    Text("Subheadline", fontStyle: Subheadline)
                    Text("Body", fontStyle: Body)
                    Text("Callout", fontStyle: Callout)
                    Text("Footnote", fontStyle: Footnote)
                    Text("Caption", fontStyle: Caption)
                    Text("Caption2", fontStyle: Caption2)
                    Text("Headline at 24", fontSize: 24, fontStyle: Headline)
                    Text("Regular override", fontSize: 24, fontStyle: Headline, fontWeight: Normal)
                    Text("Accessible text", comment: "Text with screen reader metadata", accessibilityLabel: "Accessible text label", accessibilityHint: "Read the text metadata", accessibilityValue: "Ready", accessibilityRole: Header)
                }
            }
        }
    }

    screen ButtonCases {
        state taps: Int32 = 0
        state actionDisabled: Bool = false
        state actionLoading: Bool = false
        Column(spacing: 8, padding: 16) {
            Text("Button", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Button styles, dimensions, and states") {
                Column(spacing: 6, alignment: Center) {
                    Row(spacing: 6, alignment: Center) {
                        Text("Taps: $taps")
                        Button("Toggle states", style: Plain) {
                            actionDisabled =!actionDisabled
                            actionLoading =!actionLoading
                        }
                    }
                    Row(spacing: 6, alignment: Center) {
                        Button("Prominent", style: BorderedProminent, tint: "#E11D48") {
                            taps = taps + 1
                        }
                        Button("Bordered", style: Bordered) {
                            taps = taps + 1
                        }
                    }
                    Row(spacing: 6, alignment: Center) {
                        Button("Borderless", style: Borderless) {
                            taps = taps + 1
                        }
                        Button("Plain", style: Plain) {
                            taps = taps + 1
                        }
                    }
                    Row(spacing: 6, alignment: Center) {
                        Button("Small", style: Bordered, size: Small) {
                            taps = taps + 1
                        }
                        Button("Regular", style: Bordered, size: Regular) {
                            taps = taps + 1
                        }
                        Button("Large", style: Bordered, size: Large) {
                            taps = taps + 1
                        }
                    }
                    Row(spacing: 6, alignment: Center) {
                        Button("", icon: "add", shape: Circle) {
                            taps = taps + 1
                        }
                        Button("Capsule", shape: Capsule) {
                            taps = taps + 1
                        }
                        Button("Rounded", shape: Rounded(12)) {
                            taps = taps + 1
                        }
                    }
                    Row(spacing: 6, alignment: Center) {
                        Button("Glass icon", comment: "Icon and glass style parity", icon: "star", glass: true, style: Bordered) {
                            taps = taps + 1
                        }
                        Button("Tinted plain", style: Plain, tint: "#7C3AED") {
                            taps = taps + 1
                        }
                    }
                    Row(spacing: 6, alignment: Center) {
                        Button("Disabled", disabled: true) {
                            taps = taps + 1
                        }
                        Button("Loading", loading: true) {
                            taps = taps + 1
                        }
                    }
                    Row(spacing: 6, alignment: Center) {
                        Button("Dynamic disabled", disabled: actionDisabled) {
                            taps = taps + 1
                        }
                        Button("Dynamic loading", loading: actionLoading) {
                            taps = taps + 1
                        }
                    }
                    Button("Enabled action") {
                        taps = taps + 1
                    }
                }
            }
        }
    }

    screen PressableCases {
        state pressableTaps: Int32 = 0
        state disabledTaps: Int32 = 0
        state longPresses: Int32 = 0
        state doubleTaps: Int32 = 0
        state contextActions: Int32 = 0
        state dragUpdated: Bool = false
        state pinchUpdated: Bool = false
        Column(spacing: 12, padding: 16) {
            Text("Pressable", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Tap, press, and custom actions") {
                Text("Tap events: $pressableTaps")
                Pressable(haptic: Light) {
                    Text("Tap count: $pressableTaps")
                }.onTap {
                    pressableTaps = pressableTaps + 1
                }
                Pressable(disabled: true) {
                    Text("Disabled taps: $disabledTaps")
                }.onTap {
                    disabledTaps = disabledTaps + 1
                }
                Pressable() {
                    Text("Long press count: $longPresses")
                }.onTap {
                    pressableTaps = pressableTaps + 1
                }.onLongPress(durationMs: 500) {
                    longPresses = longPresses + 1
                }
                Pressable() {
                    Text("Double tap count: $doubleTaps")
                }.onTap {
                    pressableTaps = pressableTaps + 1
                }.onDoubleTap {
                    doubleTaps = doubleTaps + 1
                }.onLongPress(durationMs: 500) {
                    longPresses = longPresses + 1
                }
                Pressable() {
                    Text("Context actions: $contextActions")
                }.onTap {
                    pressableTaps = pressableTaps + 1
                }.contextMenu {
                    Button("Increment context action") {
                        contextActions = contextActions + 1
                    }
                }
            }
            ParityCard(title: "Drag and pinch values") {
                Pressable() {
                    Text("Drag updated: $dragUpdated")
                }.onTap {
                    pressableTaps = pressableTaps + 1
                }.onDrag {
                    translationX, translationY, velocityX, velocityY ->
                    dragUpdated = translationX != 0.0
                }
                Pressable() {
                    Text("Pinch updated: $pinchUpdated")
                }.onTap {
                    pressableTaps = pressableTaps + 1
                }.onPinch {
                    scaleFactor ->
                    pinchUpdated = scaleFactor != 1.0
                }
            }
            ParityCard(title: "Fill available parent size") {
                Stack(width: 280, height: 64, background: "#F2F2F7", cornerRadius: 8) {
                    Pressable(fillMaxSize: true) {
                        Text("Full-size pressable")
                    }.onTap {
                        pressableTaps = pressableTaps + 1
                    }
                }
            }
        }
    }

    screen TextInputCases {
        state shortText: String = ""
        state email: String = ""
        state emailNext: String = ""
        state notes: String = ""
        state password: String = ""
        state numberValue: String = ""
        state phoneValue: String = ""
        state urlValue: String = ""
        state oneTimeCode: String = ""
        state wordCapitalization: String = ""
        state characterCapitalization: String = ""
        state titleText: String = ""
        state minimumLinesText: String = ""
        state maximumLinesText: String = ""
        state lastChanged: String = ""
        state changeCount: Int32 = 0
        state lastSubmitted: String = "Not submitted"
        state emailFocused: Bool = false
        KeyboardAware(dismiss: Interactive) {
            Column(spacing: 12, padding: 16) {
                Text("TextInput", fontSize: 28, fontWeight: Bold)
                Text("No field is focused when this screen opens.", fontSize: 13, color: "#777780")
                Button("Reset inputs") {
                    shortText = ""
                    email = ""
                    emailNext = ""
                    notes = ""
                    password = ""
                    numberValue = ""
                    phoneValue = ""
                    urlValue = ""
                    oneTimeCode = ""
                    wordCapitalization = ""
                    characterCapitalization = ""
                    titleText = ""
                    minimumLinesText = ""
                    maximumLinesText = ""
                    lastChanged = ""
                    changeCount = 0
                    lastSubmitted = "Not submitted"
                    emailFocused = false
                }
                ParityCard(title: "Default text, placeholder, comment, length, and onChange") {
                    TextInput(value: shortText, placeholder: "Task name", comment: "Task name for the parity audit", keyboardType: Text, isSecure: false, autocorrect: true, capitalization: Sentences, maxLength: 12, font: Body, searchable: false, returnKeyType: Done) {
                        lastSubmitted = "Text · Done"
                    }.onChange {
                        changed ->
                        lastChanged = changed
                        changeCount = changeCount + 1
                    }
                    Text("Value: $shortText · last change: $lastChanged · edits: $changeCount", fontSize: 13)
                    Text("Last submitted: $lastSubmitted", fontSize: 13)
                }
                ParityCard(title: "Keyboard, return key, and focus") {
                    TextInput(value: email, placeholder: "Search email", comment: "Username autofill and searchable input", keyboardType: Email, autofill: Username, returnKeyType: Search, capitalization: None, autocorrect: false, focused: emailFocused, font: Body, searchable: true)
                    TextInput(value: emailNext, placeholder: "Email · Next", keyboardType: Email, returnKeyType: Next, capitalization: None, autocorrect: false) {
                        lastSubmitted = "Email · Next"
                    }
                    TextInput(value: numberValue, placeholder: "Number · Search", keyboardType: Number, returnKeyType: Search, capitalization: None, autocorrect: false, searchable: false) {
                        lastSubmitted = "Number · Search"
                    }
                    TextInput(value: phoneValue, placeholder: "Phone · Send", keyboardType: Phone, returnKeyType: Send, capitalization: Characters, autocorrect: false) {
                        lastSubmitted = "Phone · Send"
                    }
                    TextInput(value: urlValue, placeholder: "URL · Done", keyboardType: Url, returnKeyType: Done, capitalization: Words) {
                        lastSubmitted = "URL · Done"
                    }
                    Button("Focus email") {
                        emailFocused = true
                    }
                    Button("Clear email focus") {
                        emailFocused = false
                    }
                    Text("Email focused: $emailFocused · last submitted: $lastSubmitted", fontSize: 13)
                }
                ParityCard(title: "Secure entry and autofill types") {
                    TextInput(value: password, placeholder: "Password", keyboardType: Text, isSecure: true, autofill: Password, returnKeyType: Done, autocorrect: false, capitalization: None, font: Body) {
                        lastSubmitted = "Password · Done"
                    }
                    TextInput(value: oneTimeCode, placeholder: "One-time code", keyboardType: Number, autofill: OneTimeCode, returnKeyType: Done, autocorrect: false, capitalization: None)
                }
                ParityCard(title: "Capitalization and font variants") {
                    TextInput(value: wordCapitalization, placeholder: "Words · Title 3", keyboardType: Text, capitalization: Words, autocorrect: false, font: Title3)
                    TextInput(value: characterCapitalization, placeholder: "Characters", keyboardType: Text, capitalization: Characters, autocorrect: false, font: Body)
                    TextInput(value: titleText, placeholder: "Default capitalization", font: Title3)
                }
                ParityCard(title: "Multiline line limits") {
                    TextInput(value: notes, placeholder: "3–5 lines", multiline: true, minLines: 3, maxLines: 5, font: Body)
                    TextInput(value: minimumLinesText, placeholder: "At least 2 lines", multiline: true, minLines: 2)
                    TextInput(value: maximumLinesText, placeholder: "At most 4 lines", multiline: true, maxLines: 4)
                }
            }
        }
    }

