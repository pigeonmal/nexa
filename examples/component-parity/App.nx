component ParityCard(title: String) {
    body {
        Column(spacing: 8, padding: 12, background: "#FFFFFF", cornerRadius: 16) {
            Text(title, fontSize: 13, color: "#777780")
            Content()
        }
    }
}

struct SheetAuditItem {
    id: Int32,
    title: String,
}

app ComponentParity {
    state appActivations: Int32 = 0
    state appDeactivations: Int32 = 0
    state appBackgroundEntries: Int32 = 0

    screen Catalog {
        Form {
            Section(title: "Featured") {
                NavigationLink(destination: FastListCases) {
                    Text("FastList parity")
                }
            }
            Section(title: "Layout") {
                NavigationLink(destination: ColumnCases) {
                    Text("Column spacing and padding")
                }
                NavigationLink(destination: RowCases) {
                    Text("Row spacing and alignment")
                }
                NavigationLink(destination: StackCases) {
                    Text("Stack overlay and alignment")
                }
                NavigationLink(destination: SpacerCases) {
                    Text("Spacer distribution")
                }
                NavigationLink(destination: TitleCases) {
                    Text("Navigation title system")
                }
                NavigationLink(destination: DividerCases) {
                    Text("Divider thickness and color")
                }
                NavigationLink(destination: DirectionCases) {
                    Text("Layout direction baseline")
                }
            }
            Section(title: "Text and controls") {
                NavigationLink(destination: TextCases) {
                    Text("Text styles and sizing")
                }
                NavigationLink(destination: ButtonCases) {
                    Text("Button styles and states")
                }
                NavigationLink(destination: PressableCases) {
                    Text("Pressable gestures")
                }
                NavigationLink(destination: TextInputCases) {
                    Text("Text input variants")
                }
                NavigationLink(destination: SwitchCases) {
                    Text("Switch states")
                }
                NavigationLink(destination: SliderCases) {
                    Text("Slider values")
                }
                NavigationLink(destination: SegmentedCases) {
                    Text("Segmented control")
                }
                NavigationLink(destination: PickerCases) {
                    Text("Picker options")
                }
            }
            Section(title: "Content and lists") {
                NavigationLink(destination: FastListCases) {
                    Text("FastList parameters")
                }
                NavigationLink(destination: FormCases) {
                    Text("Form and section")
                }
                NavigationLink(destination: EmptyCases) {
                    Text("Content unavailable")
                }
                NavigationLink(destination: ProgressBarCases) {
                    Text("Progress bar values")
                }
                NavigationLink(destination: ProgressRingCases) {
                    Text("Progress ring values")
                }
                NavigationLink(destination: RefreshCases) {
                    Text("Pull to refresh")
                }
                NavigationLink(destination: KeyboardCases) {
                    Text("Keyboard-aware layout")
                }
            }
            Section(title: "Media and navigation") {
                NavigationLink(destination: IconCases) {
                    Text("Icon sizes and tint")
                }
                NavigationLink(destination: ImageCases) {
                    Text("Image asset rendering")
                }
                NavigationLink(destination: GradientCases) {
                    Text("Linear gradient")
                }
                NavigationLink(destination: LinkCases) {
                    Text("External link")
                }
                NavigationLink(destination: NavigationBackCases) {
                    Text("NavigationBack behavior")
                }
                NavigationLink(destination: ToolbarCases) {
                    Text("Toolbar placement")
                }
                NavigationLink(destination: PagerCases) {
                    Text("Page pager")
                }
                NavigationLink(destination: BottomBarCases) {
                    Text("App bottom bar")
                }
                NavigationLink(destination: SplitViewCases) {
                    Text("Adaptive split view")
                }
            }
            Section(title: "Presentation and environment") {
                NavigationLink(destination: SheetCases) {
                    Text("Bottom sheet")
                }
                NavigationLink(destination: DialogCases) {
                    Text("Dialog")
                }
                NavigationLink(destination: ConfirmationCases) {
                    Text("Confirmation dialog")
                }
                NavigationLink(destination: AppearanceCases) {
                    Text("Appearance")
                }
                NavigationLink(destination: StatusBarCases) {
                    Text("Status bar")
                }
                NavigationLink(destination: AccessibilityCases) {
                    Text("Accessibility semantics")
                }
                NavigationLink(destination: LifecycleCases) {
                    Text("Screen lifecycle")
                }
            }
        }
    }

    screen ColumnCases {
        state columnTestPage: Int32 = 0
        state columnAnimationExpanded: Bool = false
        Column(spacing: 10, padding: 16) {
            Text("Column", fontSize: 28, fontWeight: Bold)
            Row(spacing: 6) {
                Pressable(accessibilityLabel: "Flow and alignment tests", accessibilityRole: Button) {
                    Text("Flow")
                }.onTap {
                    columnTestPage = 0
                }
                Pressable(accessibilityLabel: "Size and bounds tests", accessibilityRole: Button) {
                    Text("Bounds")
                }.onTap {
                    columnTestPage = 1
                }
                Pressable(accessibilityLabel: "Surface and padding tests", accessibilityRole: Button) {
                    Text("Surface")
                }.onTap {
                    columnTestPage = 2
                }
                Pressable(accessibilityLabel: "Effects and behavior tests", accessibilityRole: Button) {
                    Text("Effects")
                }.onTap {
                    columnTestPage = 3
                }
                Pressable(accessibilityLabel: "Animation and accessibility tests", accessibilityRole: Button) {
                    Text("Behavior")
                }.onTap {
                    columnTestPage = 4
                }
            }

            if columnTestPage == 0 {
                ParityCard(title: "Spacing, nesting, and alignment") {
                    Column(spacing: 0, alignment: Start, width: 280, padding: 8, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Start · spacing 0")
                        Text("Second child")
                    }
                    Column(spacing: 8, alignment: Center, width: 280, padding: 8, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Center · spacing 8")
                        Text("Second child")
                    }
                    Column(spacing: 20, alignment: End, width: 280, padding: 8, background: "#F2F2F7", cornerRadius: 8) {
                        Text("End · spacing 20")
                        Text("Second child")
                    }
                    Column(spacing: 4, padding: 8, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Outer spacing: 4")
                        Column(spacing: 18) {
                            Text("Inner spacing: 18")
                            Text("Inner spacing stays local")
                        }
                        Text("Outer spacing resumes")
                    }
                }
            }

            if columnTestPage == 1 {
                ParityCard(title: "Fixed size and independent bounds") {
                    Column(width: 220, background: "#E8F0FF", cornerRadius: 8) {
                        Text("Fixed width: 220")
                    }
                    Column(height: 56, background: "#E8F0FF", cornerRadius: 8) {
                        Text("Fixed height: 56")
                    }
                    Column(width: 240, height: 72, minWidth: 220, maxWidth: 260, minHeight: 64, maxHeight: 80, background: "#FFFFFF", cornerRadius: 8, borderColor: "#2563EB", borderWidth: 1) {
                        Text("Fixed 240 × 72 inside 220–260 × 64–80")
                    }
                    Column(minWidth: 210, maxWidth: 260, minHeight: 64, maxHeight: 84, padding: 8, background: "#E8F0FF", cornerRadius: 8) {
                        Text("Minimum expands this short content")
                    }
                    Column(maxWidth: 170, padding: 8, background: "#FFF1E8", cornerRadius: 8) {
                        Text("Maximum width wraps this longer label onto multiple lines")
                    }
                    Column(width: 200, maxHeight: 68, spacing: 6, padding: 6, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Maximum height: 68")
                        Text("Second line")
                        Text("Third line")
                        Text("Fourth line")
                    }
                }
            }

            if columnTestPage == 2 {
                ParityCard(title: "Padding, background, border, and opacity") {
                    Column(spacing: 6, width: 280, height: 76, padding: 12, background: "#DDEBFF", cornerRadius: 14, borderColor: "#2563EB", borderWidth: 2) {
                        Text("12 dp padding")
                        Text("Blue fill · 14 dp corners · 2 dp border")
                    }
                    Column(width: 240, height: 52, padding: 8, background: "#E11D48", cornerRadius: 8, opacity: 0.45) {
                        Text("Opacity 0.45", color: "#FFFFFF")
                    }
                    Column(width: 240, height: 52, padding: 8, background: "#E11D48", cornerRadius: 8, opacity: 0.0) {
                        Text("Opacity 0.0 · transparent")
                    }
                    Column(width: 240, height: 52, padding: 8, background: "#34C759", cornerRadius: 8, opacity: 1.0) {
                        Text("Opacity 1.0", color: "#FFFFFF")
                    }
                    Column(spacing: 4, padding: 0, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Explicit zero padding")
                        Text("Compare with the padded card above")
                    }
                }
            }

            if columnTestPage == 3 {
                ParityCard(title: "Transforms, clipping, and order") {
                    Row(spacing: 24, height: 78, alignment: Center) {
                        Column(width: 90, height: 48, background: "#E11D48", cornerRadius: 8, scale: 1.2) {
                            Text("Scale", color: "#FFFFFF")
                        }
                        Column(width: 90, height: 48, background: "#2563EB", cornerRadius: 8, rotation: 12) {
                            Text("Rotate", color: "#FFFFFF")
                        }
                    }
                    Column(width: 240, height: 64, background: "#FFFFFF", cornerRadius: 12, shadow: Shadow(8, 4, 6, "#00000070")) {
                        Text("Shadow radius 8, offset 4 × 6")
                    }
                    Column(width: 240, height: 42, padding: 6, background: "#E8F0FF", cornerRadius: 8, blur: 2) {
                        Text("Blur radius 2")
                    }
                    Column(width: 180, height: 64, background: "#DDEBFF", clip: Rounded(14)) {
                        Column(width: 112, height: 84, background: "#E11D48", rotation: 28, cornerRadius: 4) {
                            Text("Clipped", color: "#FFFFFF")
                        }
                    }
                    Stack(width: 260, height: 96, background: "#F2F2F7", cornerRadius: 8, glass: "rounded(8)") {
                        Column(width: 190, height: 68, background: "#E11D48", cornerRadius: 8, zIndex: 2) {
                            Text("First child · zIndex 2", color: "#FFFFFF")
                        }
                        Column(width: 145, height: 84, background: "#2563EB", cornerRadius: 8, zIndex: 1) {
                            Text("Later child · zIndex 1", color: "#FFFFFF")
                        }
                    }
                    Column(spacing: 6, width: 280, padding: 8, background: "#F2F2F7", cornerRadius: 12) {
                        Row(spacing: 8, alignment: Center) {
                            Column(width: 64, height: 48, cornerRadius: 24, glass: "circle") {
                                Text("Circle")
                            }
                            Column(width: 78, height: 48, cornerRadius: 24, glass: "capsule") {
                                Text("Capsule")
                            }
                            Column(width: 94, height: 48, cornerRadius: 12, glass: "rounded(12)") {
                                Text("Rounded")
                            }
                        }
                        Column(width: 240, height: 48, glass: Glass(shape: "capsule", tint: "#E11D48")) {
                            Text("Tinted capsule")
                        }
                    }
                }
            }

            if columnTestPage == 4 {
                ParityCard(title: "Animation variants and accessibility") {
                    Column(width: 260, minHeight: 56, padding: 10, background: "#E8F0FF", cornerRadius: 10, animation: EaseInOut) {
                        Text("EaseInOut · expanded: $columnAnimationExpanded")
                        if columnAnimationExpanded {
                            Text("This changes the Column size")
                        }
                    }
                    Column(minHeight: 36, padding: 6, background: "#F2F2F7", cornerRadius: 8, animation: EaseIn) {
                        Text("EaseIn")
                        if columnAnimationExpanded {
                            Text("Expanded")
                        }
                    }
                    Column(minHeight: 36, padding: 6, background: "#F2F2F7", cornerRadius: 8, animation: EaseOut) {
                        Text("EaseOut")
                        if columnAnimationExpanded {
                            Text("Expanded")
                        }
                    }
                    Column(minHeight: 36, padding: 6, background: "#F2F2F7", cornerRadius: 8, animation: Linear) {
                        Text("Linear")
                        if columnAnimationExpanded {
                            Text("Expanded")
                        }
                    }
                    Column(minHeight: 36, padding: 6, background: "#F2F2F7", cornerRadius: 8, animation: Spring(response: 0.35, damping: 0.8)) {
                        Text("Spring")
                        if columnAnimationExpanded {
                            Text("Expanded")
                        }
                    }
                    Button("Toggle animated content") {
                        columnAnimationExpanded =!columnAnimationExpanded
                    }
                    Column(padding: 8, background: "#F2F2F7", cornerRadius: 8, accessibilityLabel: "Column accessibility sample", accessibilityHint: "Demonstrates Column semantics", accessibilityValue: "Ready", accessibilityRole: Header) {
                        Text("Accessible Column")
                    }
                    Row(spacing: 6, alignment: Center) {
                        Column(padding: 6, background: "#F2F2F7", cornerRadius: 8, accessibilityLabel: "Button role sample", accessibilityRole: Button) {
                            Text("Button role")
                        }
                        Column(padding: 6, background: "#F2F2F7", cornerRadius: 8, accessibilityLabel: "Link role sample", accessibilityRole: Link) {
                            Text("Link role")
                        }
                    }
                    Row(spacing: 6, alignment: Center) {
                        Column(padding: 6, background: "#F2F2F7", cornerRadius: 8, accessibilityLabel: "Image role sample", accessibilityRole: Image) {
                            Text("Image role")
                        }
                        Column(padding: 6, background: "#F2F2F7", cornerRadius: 8, accessibilityLabel: "None role sample", accessibilityRole: None) {
                            Text("None role")
                        }
                    }
                }
            }
        }
    }

    screen RowCases {
        state rowTestPage: Int32 = 0
        state rowAnimationExpanded: Bool = false
        Column(spacing: 10, padding: 16) {
            Text("Row", fontSize: 28, fontWeight: Bold)
            Row(spacing: 12) {
                Pressable(accessibilityLabel: "Row flow parameter tests", accessibilityRole: Button) {
                    Text("Flow", fontSize: 13)
                }.onTap {
                    rowTestPage = 0
                }
                Pressable(accessibilityLabel: "Row horizontal arrangement tests", accessibilityRole: Button) {
                    Text("Arrange", fontSize: 13)
                }.onTap {
                    rowTestPage = 1
                }
                Pressable(accessibilityLabel: "Row size and bounds tests", accessibilityRole: Button) {
                    Text("Bounds", fontSize: 13)
                }.onTap {
                    rowTestPage = 2
                }
            }
            Row(spacing: 12) {
                Pressable(accessibilityLabel: "Row surface and padding tests", accessibilityRole: Button) {
                    Text("Surface", fontSize: 13)
                }.onTap {
                    rowTestPage = 3
                }
                Pressable(accessibilityLabel: "Row effects tests", accessibilityRole: Button) {
                    Text("Effects", fontSize: 13)
                }.onTap {
                    rowTestPage = 4
                }
                Pressable(accessibilityLabel: "Row animation and accessibility tests", accessibilityRole: Button) {
                    Text("Behavior", fontSize: 13)
                }.onTap {
                    rowTestPage = 5
                }
            }

            if rowTestPage == 0 {
                ParityCard(title: "Spacing and vertical alignment") {
                    Row(spacing: 0, width: 280, height: 36, background: "#F2F2F7") {
                        Text("0 dp")
                        Text("A")
                        Text("B")
                    }
                    Row(spacing: 8, width: 280, height: 36, background: "#F2F2F7") {
                        Text("8 dp")
                        Text("A")
                        Text("B")
                    }
                    Row(spacing: 24, width: 280, height: 36, background: "#F2F2F7") {
                        Text("24 dp")
                        Text("A")
                        Text("B")
                    }
                    Row(width: 280, height: 52, background: "#F2F2F7") {
                        Column(width: 42, height: 16, background: "#2563EB", cornerRadius: 4) {
                            Text("Short", fontSize: 10, color: "#FFFFFF")
                        }
                        Column(width: 42, height: 44, background: "#E11D48", cornerRadius: 4) {
                            Text("Tall", fontSize: 10, color: "#FFFFFF")
                        }
                    }
                    Row(spacing: 8, width: 280, height: 52, alignment: Start, background: "#F2F2F7") {
                        Column(width: 42, height: 16, background: "#2563EB", cornerRadius: 4) {
                            Text("Top", fontSize: 10, color: "#FFFFFF")
                        }
                        Column(width: 42, height: 44, background: "#E11D48", cornerRadius: 4) {
                            Text("Tall", fontSize: 10, color: "#FFFFFF")
                        }
                    }
                    Row(spacing: 8, width: 280, height: 52, alignment: Center, background: "#F2F2F7") {
                        Column(width: 42, height: 16, background: "#2563EB", cornerRadius: 4) {
                            Text("Mid", fontSize: 10, color: "#FFFFFF")
                        }
                        Column(width: 42, height: 44, background: "#E11D48", cornerRadius: 4) {
                            Text("Tall", fontSize: 10, color: "#FFFFFF")
                        }
                    }
                    Row(spacing: 8, width: 280, height: 52, alignment: End, background: "#F2F2F7") {
                        Column(width: 42, height: 16, background: "#2563EB", cornerRadius: 4) {
                            Text("Bottom", fontSize: 9, color: "#FFFFFF")
                        }
                        Column(width: 42, height: 44, background: "#E11D48", cornerRadius: 4) {
                            Text("Tall", fontSize: 10, color: "#FFFFFF")
                        }
                    }
                }
            }

            if rowTestPage == 1 {
                ParityCard(title: "Horizontal arrangement") {
                    Row(spacing: 8, width: 280, height: 42, background: "#F2F2F7") {
                        Text("Default start")
                        Text("Second")
                    }
                    Row(spacing: 8, width: 280, height: 42, horizontalArrangement: Start, background: "#F2F2F7") {
                        Text("Explicit start")
                        Text("Second")
                    }
                    Row(spacing: 8, width: 280, height: 42, horizontalArrangement: Center, background: "#F2F2F7") {
                        Text("Center")
                        Text("Second")
                    }
                    Row(spacing: 8, width: 280, height: 42, horizontalArrangement: End, background: "#F2F2F7") {
                        Text("End")
                        Text("Second")
                    }
                    Row(spacing: 8, height: 42, horizontalArrangement: Center, background: "#DDEBFF", cornerRadius: 8) {
                        Text("Arrangement fills available width")
                    }
                    Row(spacing: 4, width: 280, padding: 6, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Outer 4")
                        Row(spacing: 16, background: "#DDEBFF", cornerRadius: 6) {
                            Text("A")
                            Text("B")
                        }
                        Text("Outer 4")
                    }
                    Row(width: 280, height: 64, background: "#F2F2F7") {
                        Text("Default arrangement remains start aligned")
                    }
                }
            }

            if rowTestPage == 2 {
                ParityCard(title: "Fixed size and independent bounds") {
                    Row(width: 220, background: "#E8F0FF", cornerRadius: 8) {
                        Text("Fixed width: 220")
                    }
                    Row(height: 56, background: "#E8F0FF", cornerRadius: 8) {
                        Text("Fixed height: 56")
                    }
                    Row(width: 240, height: 72, minWidth: 220, maxWidth: 260, minHeight: 64, maxHeight: 80, background: "#FFFFFF", cornerRadius: 8, borderColor: "#2563EB", borderWidth: 1) {
                        Text("Fixed 240 × 72 inside 220–260 × 64–80")
                    }
                    Row(minWidth: 210, maxWidth: 260, minHeight: 64, maxHeight: 84, padding: 8, background: "#E8F0FF", cornerRadius: 8) {
                        Text("Minimum expands this short content")
                    }
                    Row(maxWidth: 170, padding: 8, background: "#FFF1E8", cornerRadius: 8) {
                        Text("Maximum width wraps this longer label onto multiple lines")
                    }
                    Row(width: 200, maxHeight: 68, spacing: 6, padding: 6, background: "#F2F2F7", cornerRadius: 8) {
                        Column(width: 72, height: 88, background: "#E11D48", cornerRadius: 4) {
                        }
                    }
                }
            }

            if rowTestPage == 3 {
                ParityCard(title: "Padding, background, border, and opacity") {
                    Row(spacing: 8, width: 280, height: 76, padding: 12, background: "#DDEBFF", cornerRadius: 14, borderColor: "#2563EB", borderWidth: 2) {
                        Text("12 dp padding")
                        Text("Blue fill · 14 dp corners · 2 dp border")
                    }
                    Row(width: 240, height: 52, padding: 8, background: "#E11D48", cornerRadius: 8, opacity: 0.45) {
                        Text("Opacity 0.45", color: "#FFFFFF")
                    }
                    Row(width: 240, height: 52, padding: 8, background: "#E11D48", cornerRadius: 8, opacity: 0.0) {
                        Text("Opacity 0.0 · transparent")
                    }
                    Row(width: 240, height: 52, padding: 8, background: "#34C759", cornerRadius: 8, opacity: 1.0) {
                        Text("Opacity 1.0", color: "#FFFFFF")
                    }
                    Row(spacing: 8, width: 280, height: 40, padding: 0, background: "#F2F2F7", cornerRadius: 8) {
                        Text("No inset")
                        Text("12 dp above")
                    }
                }
            }

            if rowTestPage == 4 {
                ParityCard(title: "Transforms, clipping, shadows, and surfaces") {
                    Row(spacing: 24, height: 88, alignment: Center) {
                        Row(width: 90, height: 48, background: "#E11D48", cornerRadius: 8, scale: 1.2) {
                            Text("Scale", color: "#FFFFFF")
                        }
                        Row(width: 90, height: 48, background: "#2563EB", cornerRadius: 8, rotation: 12) {
                            Text("Rotate", color: "#FFFFFF")
                        }
                    }
                    Row(width: 240, height: 64, background: "#FFFFFF", cornerRadius: 12, shadow: Shadow(8, 4, 6, "#00000070")) {
                        Text("Shadow radius 8, offset 4 × 6")
                    }
                    Row(width: 240, height: 42, padding: 6, background: "#E8F0FF", cornerRadius: 8, blur: 2) {
                        Text("Blur radius 2")
                    }
                    Row(width: 180, height: 64, background: "#DDEBFF", clip: Rounded(14)) {
                        Row(width: 220, height: 84, background: "#E11D48", rotation: 12, cornerRadius: 4) {
                            Text("Clipped overflow", color: "#FFFFFF")
                        }
                    }
                    Stack(width: 240, height: 88, background: "#F2F2F7", cornerRadius: 8) {
                        Row(width: 150, height: 48, padding: 4, background: "#E11D48", cornerRadius: 8, zIndex: 2) {
                            Text("Above", color: "#FFFFFF")
                        }
                        Row(width: 210, height: 72, padding: 4, background: "#2563EB", cornerRadius: 8, zIndex: 1) {
                            Text("Behind", color: "#FFFFFF")
                        }
                    }
                    Row(spacing: 8, width: 220, height: 48, padding: 8, glass: Glass(shape: "capsule", tint: "#DDEBFF")) {
                        Text("Capsule surface")
                    }
                }
            }

            if rowTestPage == 5 {
                ParityCard(title: "Animation variants and accessibility") {
                    Row(spacing: 6, minHeight: 36, padding: 6, background: "#F2F2F7", cornerRadius: 8, animation: EaseInOut) {
                        Text("EaseInOut")
                        if rowAnimationExpanded {
                            Text("Expanded")
                        }
                    }
                    Row(spacing: 6, minHeight: 36, padding: 6, background: "#F2F2F7", cornerRadius: 8, animation: EaseIn) {
                        Text("EaseIn")
                        if rowAnimationExpanded {
                            Text("Expanded")
                        }
                    }
                    Row(spacing: 6, minHeight: 36, padding: 6, background: "#F2F2F7", cornerRadius: 8, animation: EaseOut) {
                        Text("EaseOut")
                        if rowAnimationExpanded {
                            Text("Expanded")
                        }
                    }
                    Row(spacing: 6, minHeight: 36, padding: 6, background: "#F2F2F7", cornerRadius: 8, animation: Linear) {
                        Text("Linear")
                        if rowAnimationExpanded {
                            Text("Expanded")
                        }
                    }
                    Row(spacing: 6, minHeight: 36, padding: 6, background: "#F2F2F7", cornerRadius: 8, animation: Spring(response: 0.35, damping: 0.8)) {
                        Text("Spring")
                        if rowAnimationExpanded {
                            Text("Expanded")
                        }
                    }
                    Button("Toggle animated row content") {
                        rowAnimationExpanded =!rowAnimationExpanded
                    }
                    Row(accessibilityLabel: "Accessible row sample", accessibilityHint: "Demonstrates row semantics", accessibilityValue: "Ready", accessibilityRole: Header) {
                        Text("Accessible Row")
                    }
                    Row(accessibilityLabel: "Button role row", accessibilityRole: Button) {
                        Text("Button role")
                    }
                    Row(accessibilityLabel: "Link role row", accessibilityRole: Link) {
                        Text("Link role")
                    }
                    Row(accessibilityLabel: "Image role row", accessibilityRole: Image) {
                        Text("Image role")
                    }
                    Row(accessibilityLabel: "None role row", accessibilityRole: None) {
                        Text("None role")
                    }
                }
            }
        }
    }

    screen StackCases {
        state stackTestPage: Int32 = 0
        state stackAnimationExpanded: Bool = false
        Column(spacing: 10, padding: 16) {
            Text("Stack", fontSize: 28, fontWeight: Bold)
            Row(spacing: 12) {
                Pressable(accessibilityLabel: "Stack alignment tests", accessibilityRole: Button) {
                    Text("Align", fontSize: 13)
                }.onTap {
                    stackTestPage = 0
                }
                Pressable(accessibilityLabel: "Stack size and bounds tests", accessibilityRole: Button) {
                    Text("Bounds", fontSize: 13)
                }.onTap {
                    stackTestPage = 1
                }
                Pressable(accessibilityLabel: "Stack surface and padding tests", accessibilityRole: Button) {
                    Text("Surface", fontSize: 13)
                }.onTap {
                    stackTestPage = 2
                }
            }
            Row(spacing: 12) {
                Pressable(accessibilityLabel: "Stack glass shape tests", accessibilityRole: Button) {
                    Text("Glass", fontSize: 13)
                }.onTap {
                    stackTestPage = 3
                }
                Pressable(accessibilityLabel: "Stack effects tests", accessibilityRole: Button) {
                    Text("Effects", fontSize: 13)
                }.onTap {
                    stackTestPage = 4
                }
                Pressable(accessibilityLabel: "Stack animation and accessibility tests", accessibilityRole: Button) {
                    Text("Behavior", fontSize: 13)
                }.onTap {
                    stackTestPage = 5
                }
            }

            if stackTestPage == 0 {
                ParityCard(title: "Default, center, and corner alignment") {
                    Stack(width: 220, height: 48) {
                        Text("No fill · transparent")
                    }
                    Stack(width: 220, height: 64, background: "#DDEBFF", cornerRadius: 8) {
                        Text("Default center")
                    }
                    Stack(alignment: Start, width: 220, height: 64, padding: 8, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Top leading")
                    }
                    Stack(alignment: Center, width: 220, height: 64, background: "#DDEBFF", cornerRadius: 8) {
                        Text("Explicit center")
                    }
                    Stack(alignment: End, width: 220, height: 64, padding: 8, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Bottom trailing")
                    }
                    Stack(width: 220, height: 64, background: "#F2F2F7", cornerRadius: 8) {
                        Stack(alignment: Start, width: 220, height: 56, padding: 4, background: "#2563EB", cornerRadius: 6) {
                            Text("First layer · blue", color: "#FFFFFF")
                        }
                        Stack(alignment: End, width: 132, height: 40, padding: 4, background: "#E11D48", cornerRadius: 6) {
                            Text("Second · red", color: "#FFFFFF")
                        }
                    }
                }
            }

            if stackTestPage == 1 {
                ParityCard(title: "Fixed size and independent bounds") {
                    Stack(width: 180, height: 56, background: "#DDEBFF", cornerRadius: 8) {
                        Text("Fixed 180 × 56")
                    }
                    Stack(minWidth: 180, padding: 8, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Minimum width: 180")
                    }
                    Stack(maxWidth: 150, padding: 8, background: "#FFF1E8", cornerRadius: 8) {
                        Text("Maximum width wraps this longer Stack label onto several lines")
                    }
                    Stack(minHeight: 72, padding: 8, background: "#E8F0FF", cornerRadius: 8) {
                        Text("Minimum height: 72")
                    }
                    Stack(maxHeight: 64, background: "#F2F2F7", cornerRadius: 8) {
                        Column(spacing: 4) {
                            Text("Maximum height: 64")
                            Text("Second line")
                            Text("Third line")
                        }
                    }
                    Stack(width: 240, height: 72, minWidth: 220, maxWidth: 260, minHeight: 64, maxHeight: 80, background: "#FFFFFF", cornerRadius: 8, borderColor: "#34C759", borderWidth: 1) {
                        Text("Fixed size within 220–260 × 64–80 bounds")
                    }
                }
            }

            if stackTestPage == 2 {
                ParityCard(title: "Padding, fill, corners, and border") {
                    Stack(width: 240, height: 64, padding: 0, background: "#DDEBFF", cornerRadius: 18) {
                        Text("Zero padding")
                    }
                    Stack(width: 240, height: 72, padding: 16, background: "#DDEBFF", cornerRadius: 18) {
                        Text("16 dp padding · blue fill")
                    }
                    Stack(width: 240, height: 64, padding: 8, background: "#FFFFFF", cornerRadius: 12, borderColor: "#E11D48", borderWidth: 1) {
                        Text("1 dp red border")
                    }
                    Stack(width: 240, height: 64, padding: 8, background: "#FFFFFF", cornerRadius: 12, borderColor: "#2563EB", borderWidth: 3) {
                        Text("3 dp blue border")
                    }
                }
            }

            if stackTestPage == 3 {
                ParityCard(title: "Glass shapes and padded bounds") {
                    Stack(width: 64, height: 64, padding: 8, glass: Glass(shape: "circle", tint: "#DDEBFF")) {
                        Text("●")
                    }
                    Stack(width: 220, height: 56, padding: 8, glass: Glass(shape: "capsule", tint: "#DDEBFF")) {
                        Text("Glass capsule with padding")
                    }
                    Stack(width: 220, height: 64, padding: 8, glass: Glass(shape: "rounded(12)", tint: "#DDEBFF")) {
                        Text("Glass rounded corners")
                    }
                }
            }

            if stackTestPage == 4 {
                ParityCard(title: "Opacity, transforms, shadow, blur, and clipping") {
                    Stack(width: 220, height: 48, background: "#E11D48", cornerRadius: 8, opacity: 0.45) {
                        Text("Opacity 0.45", color: "#FFFFFF")
                    }
                    Stack(width: 220, height: 48, background: "#E11D48", cornerRadius: 8, opacity: 0.0) {
                        Text("Opacity 0 · transparent")
                    }
                    Stack(width: 220, height: 48, background: "#34C759", cornerRadius: 8, opacity: 1.0) {
                        Text("Opacity 1.0", color: "#FFFFFF")
                    }
                    Row(spacing: 16, alignment: Center, height: 88) {
                        Stack(width: 72, height: 48, background: "#E11D48", cornerRadius: 8, scale: 0.75) {
                            Text("Scale .75", fontSize: 11, color: "#FFFFFF")
                        }
                        Stack(width: 72, height: 48, background: "#2563EB", cornerRadius: 8, scale: 1.2) {
                            Text("Scale 1.2", fontSize: 11, color: "#FFFFFF")
                        }
                        Stack(width: 72, height: 48, background: "#34C759", cornerRadius: 8, rotation: 12) {
                            Text("Rotate 12°", fontSize: 11, color: "#FFFFFF")
                        }
                    }
                    Stack(width: 240, height: 64, background: "#FFFFFF", cornerRadius: 12, shadow: Shadow(8, 4, 6, "#00000070")) {
                        Text("Shadow radius 8, offset 4 × 6")
                    }
                    Stack(width: 240, height: 48, padding: 6, background: "#E8F0FF", cornerRadius: 8, blur: 2) {
                        Text("Blur radius 2")
                    }
                    Stack(width: 180, height: 64, background: "#DDEBFF", clip: Rounded(14)) {
                        Stack(width: 240, height: 88, background: "#E11D48") {
                            Text("Rounded clip")
                        }
                    }
                }
            }

            if stackTestPage == 5 {
                ParityCard(title: "Animation and accessibility") {
                    Stack(width: 240, height: 88, background: "#F2F2F7", cornerRadius: 8) {
                        Stack(width: 150, height: 48, padding: 4, background: "#E11D48", cornerRadius: 8, zIndex: 2) {
                            Text("Above · z 2", color: "#FFFFFF")
                        }
                        Stack(width: 210, height: 72, padding: 4, background: "#2563EB", cornerRadius: 8, zIndex: 1) {
                            Text("Behind · z 1", color: "#FFFFFF")
                        }
                    }
                    Stack(width: 240, minHeight: 36, padding: 4, background: "#F2F2F7", cornerRadius: 8, animation: EaseInOut) {
                        Column(width: 220, padding: 4, background: "#DDEBFF", cornerRadius: 6) {
                            Text("EaseInOut content")
                            if stackAnimationExpanded {
                                Text("Extra content")
                            }
                        }
                    }
                    Stack(width: 240, minHeight: 36, padding: 4, background: "#F2F2F7", cornerRadius: 8, animation: EaseIn) {
                        Column(width: 220, padding: 4, background: "#E8F0FF", cornerRadius: 6) {
                            Text("EaseIn content")
                            if stackAnimationExpanded {
                                Text("Extra content")
                            }
                        }
                    }
                    Stack(width: 240, minHeight: 36, padding: 4, background: "#F2F2F7", cornerRadius: 8, animation: EaseOut) {
                        Column(width: 220, padding: 4, background: "#DDEBFF", cornerRadius: 6) {
                            Text("EaseOut content")
                            if stackAnimationExpanded {
                                Text("Extra content")
                            }
                        }
                    }
                    Stack(width: 240, minHeight: 36, padding: 4, background: "#F2F2F7", cornerRadius: 8, animation: Linear) {
                        Column(width: 220, padding: 4, background: "#E8F0FF", cornerRadius: 6) {
                            Text("Linear content")
                            if stackAnimationExpanded {
                                Text("Extra content")
                            }
                        }
                    }
                    Stack(width: 240, minHeight: 36, padding: 4, background: "#F2F2F7", cornerRadius: 8, animation: Spring(response: 0.35, damping: 0.8)) {
                        Column(width: 220, padding: 4, background: "#DDEBFF", cornerRadius: 6) {
                            Text("Spring content")
                            if stackAnimationExpanded {
                                Text("Extra content")
                            }
                        }
                    }
                    Button("Toggle animated Stack content") {
                        stackAnimationExpanded =!stackAnimationExpanded
                    }
                    Stack(accessibilityLabel: "Accessible Stack sample", accessibilityHint: "Demonstrates Stack semantics", accessibilityValue: "Ready", accessibilityRole: Image, padding: 8, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Accessible Stack")
                    }
                }
            }
        }
    }

