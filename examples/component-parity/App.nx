    screen SegmentedCases {
        state defaultSegment: String = "Day"
        state tintOnlySegment: String = "Day"
        state trackBackgroundSegment: String = "Day"
        state springSegment: String = "Day"
        state tweenSegment: String = "Day"
        state paletteSegment: String = "Day"
        state compactSegment: String = "Week"
        state singleSegment: String = "Only"
        state emptySegment: String = "Missing"
        state invalidSegment: String = "Year"
        state choices: Array<String> = ["Day", "Week", "Month"]
        state singleChoice: Array<String> = ["Only"]
        state emptyChoices: Array<String> = []
        KeyboardAware {
            Column(spacing: 8, padding: 12) {
                Text("SegmentedControl", fontSize: 28, fontWeight: Bold)
                ParityCard(title: "Native segmented-control default style") {
                    Text("No visual overrides · native platform styling", fontSize: 12, color: "#777780")
                    SegmentedControl(
                    items: choices,
                    selected: defaultSegment,
                    accessibilityLabel: "Native default range"
                    )
                    Text("Selected: $defaultSegment")
                }
                ParityCard(title: "Selected pill tint only") {
                    Text("Selected pill #2563EB · no other overrides", fontSize: 12, color: "#777780")
                    SegmentedControl(
                    items: choices,
                    selected: tintOnlySegment,
                    tint: "#2563EB",
                    accessibilityLabel: "Tint-only range"
                    )
                    Text("Selected: $tintOnlySegment")
                }
                ParityCard(title: "Track background only") {
                    Text("Track color #E8EDF5", fontSize: 12, color: "#777780")
                    SegmentedControl(
                    items: choices,
                    selected: trackBackgroundSegment,
                    background: "#E8EDF5",
                    accessibilityLabel: "Custom track background range"
                    )
                    Text("Selected: $trackBackgroundSegment")
                }
                ParityCard(title: "Color parameters") {
                    Text("Track #E8EDF5 · selected #2563EB", fontSize: 12, color: "#777780")
                    Text("Selected text #FFFFFF · other text #475569", fontSize: 12, color: "#777780")
                    Text("Border #93C5FD · width 1", fontSize: 12, color: "#777780")
                    SegmentedControl(
                    items: choices,
                    selected: paletteSegment,
                    tint: "#2563EB",
                    background: "#E8EDF5",
                    selectedTextColor: "#FFFFFF",
                    textColor: "#475569",
                    borderColor: "#93C5FD",
                    borderWidth: 1,
                    accessibilityLabel: "Blue color range"
                    )
                    Text("Selected: $paletteSegment")
                }
                ParityCard(title: "Typography, height, shape, and border") {
                    Text("Font 13 · Semibold · height 34 · radius 10 · border 2", fontSize: 12, color: "#777780")
                    Text("Track #F2F4F7 · selected #FDE68A · border #CBD5E1", fontSize: 12, color: "#777780")
                    Text("Selected text #111827 · other text #475569", fontSize: 12, color: "#777780")
                    SegmentedControl(
                    items: choices,
                    selected: compactSegment,
                    tint: "#FDE68A",
                    background: "#F2F4F7",
                    selectedTextColor: "#111827",
                    textColor: "#475569",
                    fontSize: 13,
                    fontWeight: Semibold,
                    height: 34,
                    cornerRadius: 10,
                    borderColor: "#CBD5E1",
                    borderWidth: 2,
                    accessibilityLabel: "Compact custom range"
                    )
                    Text("Selected: $compactSegment")
                }
                ParityCard(title: "Default, spring, and tween motion") {
                    Text("Default platform motion", fontSize: 12, color: "#777780")
                    SegmentedControl(items: ["Day", "Week", "Month"], selected: defaultSegment, comment: "Switch the visible date range", accessibilityLabel: "Default time range")
                    Text("Default: $defaultSegment")
                    Text("Custom spring motion", fontSize: 12, color: "#777780")
                    SegmentedControl(items: choices, selected: springSegment, animation: Spring(response: 0.35, damping: 0.82), accessibilityLabel: "Spring time range")
                    Text("Spring: $springSegment")
                    Text("Custom tween motion", fontSize: 12, color: "#777780")
                    SegmentedControl(items: choices, selected: tweenSegment, animation: Tween(duration: 0.24, easing: EaseOut), accessibilityLabel: "Tween time range")
                    Text("Tween: $tweenSegment")
                }
                ParityCard(title: "Item and selection edge cases") {
                    Text("One item")
                    SegmentedControl(items: singleChoice, selected: singleSegment, accessibilityLabel: "Single option")
                    Text("Single selection: $singleSegment")
                    Text("No items")
                    SegmentedControl(items: emptyChoices, selected: emptySegment, accessibilityLabel: "Empty options")
                    Text("Empty selection: $emptySegment")
                    Text("Selected value absent from items")
                    SegmentedControl(items: choices, selected: invalidSegment, accessibilityLabel: "Missing selection")
                    Text("Missing selection: $invalidSegment")
                }
            }
        }
    }

