            ParityCard(title: "Icon for each option") {
                Picker(items: sortOptions, selected: rowIconSort, itemIcons: ["calendar", "flag_filled", "edit"], label: "Sort by", comment: "Choose an option with its own icon")
                Text("Selected row icon: $rowIconSort")
