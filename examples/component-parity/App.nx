    screen PickerDateCases {
        state selectedDate: Int64 = 1792153800000
        state boundedDate: Int64 = 1792153800000
        state selectedTime: Int64 = 1792153800000
        state selectedDateTime: Int64 = 1792153800000
        state rangeStart: Int64 = 1791763200000
        state rangeEnd: Int64 = 1792454400000
        state earliestDate: Int64 = 1791763200000
        state latestDate: Int64 = 1792454400000
        state rangeEarliestDate: Int64 = 1788220800000
        state rangeLatestDate: Int64 = 1795996800000
        Form(showDividers: false, background: "#FFFFFF") {
            Section(title: "Date styles") {
                Text("Range selection · one native calendar")
                PickerDate(type: Date, style: Compact, selection: Range, startTimestamp: rangeStart, endTimestamp: rangeEnd, minimum: rangeEarliestDate, maximum: rangeLatestDate, tint: "#2563EB", locale: "en-GB", timeZone: "Europe/Paris", accessibilityLabel: "Compact travel dates")
                Text("Default · inline graphical calendar")
                PickerDate(type: Date, timestamp: selectedDate, locale: "en-GB", timeZone: "Europe/Paris", accessibilityLabel: "Due date")
                Text("Automatic · explicit native style")
                PickerDate(type: Date, style: Automatic, timestamp: selectedDate, locale: "en-GB")
                Text("Graphical · inline calendar")
                PickerDate(type: Date, style: Graphical, selection: Single, timestamp: boundedDate, minimum: earliestDate, maximum: latestDate, locale: "en-GB", timeZone: "Europe/Paris", accessibilityLabel: "Graphical due date")
                Text("Wheel · native wheel on iOS, Material input on Android")
                PickerDate(type: Date, style: Wheel, timestamp: selectedDate, locale: "en-GB", timeZone: "Europe/Paris", accessibilityLabel: "Wheel date")
                Text("Input · date input style")
                PickerDate(type: Date, style: Input, timestamp: selectedDate, locale: "en-GB", timeZone: "Europe/Paris", accessibilityLabel: "Date input")
            }
            Section(title: "Time and date-time") {
                Text("Time · 24-hour display")
                PickerDate(type: Time, style: Wheel, timestamp: selectedTime, is24Hour: true, locale: "en-GB", timeZone: "Europe/Paris", accessibilityLabel: "Appointment time")
                Text("Input · time input style")
                PickerDate(type: Time, style: Input, timestamp: selectedTime, is24Hour: false, locale: "en-GB", timeZone: "Europe/Paris", accessibilityLabel: "Time input")
                Text("Input · date and time input style")
                PickerDate(type: DateTime, style: Input, timestamp: selectedDateTime, locale: "en-GB", timeZone: "Europe/Paris", accessibilityLabel: "Date and time input")
                Text("Date and time · compact presentation")
                PickerDate(type: DateTime, style: Compact, timestamp: selectedDateTime, is24Hour: false, locale: "en-GB", timeZone: "Europe/Paris", accessibilityLabel: "Appointment date and time")
                Text("Date · compact presentation")
                PickerDate(type: Date, style: Compact, timestamp: selectedDate, locale: "en-GB", timeZone: "Europe/Paris", accessibilityLabel: "Compact date")
            }
            Section(title: "Date range") {
                Text("Select a bounded date range")
                PickerDate(type: Date, style: Graphical, selection: Range, startTimestamp: rangeStart, endTimestamp: rangeEnd, minimum: rangeEarliestDate, maximum: rangeLatestDate, tint: "#2563EB", locale: "en-GB", timeZone: "Europe/Paris", accessibilityLabel: "Travel dates")
            }
            Section(title: "Visual parameters and disabled state") {
                Text("Accent, text, surfaces, border, and radius")
                PickerDate(type: Date, style: Graphical, timestamp: boundedDate, minimum: earliestDate, maximum: latestDate, tint: "#7C3AED", textColor: "#172033", backgroundColor: "#F1F5F9", pickerBackgroundColor: "#FFFFFF", borderColor: "#CBD5E1", borderWidth: 1, cornerRadius: 16, locale: "fr-FR", timeZone: "Europe/Paris", accessibilityLabel: "Customized date picker")
                Text("Disabled picker")
                PickerDate(type: Date, style: Compact, timestamp: selectedDate, locale: "en-GB", timeZone: "Europe/Paris", enabled: false, accessibilityLabel: "Disabled date picker")
                Text("Unbound picker uses its local selection")
                PickerDate(type: Date, style: Compact, locale: "en-GB", timeZone: "Europe/Paris")
            }
        }
    }

