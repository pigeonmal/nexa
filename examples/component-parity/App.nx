    screen EmptyCases {
        state searchTitle: String = "No search results"
        state inboxDescription: String = "Saved tasks will appear here."
        Column(spacing: 12, padding: 16) {
            Text("ContentUnavailable", fontSize: 28, fontWeight: Bold)
            ContentUnavailable(title: "No saved tasks", icon: "inbox", description: inboxDescription, titleColor: "#111111", descriptionColor: "#666666", iconTint: "#007AFF", background: "#F2F2F7", comment: "Custom empty-state colors")
            ContentUnavailable(title: searchTitle, icon: "search")
            Pressable(accessibilityLabel: "Toggle empty-state copy", accessibilityRole: Button) {
                Stack(alignment: Center, width: 224, height: 48, background: "#F2F2F7", cornerRadius: 12) {
                    Text("Toggle empty-state copy", fontSize: 14, color: "#111111")
                }
            }.onTap {
                if searchTitle == "No search results" {
                    searchTitle = "No results found for your current search"
                    inboxDescription = "Your saved tasks will appear here once you add them to your inbox."
                } else {
                    searchTitle = "No search results"
                    inboxDescription = "Saved tasks will appear here."
                }
            }
        }
    }

    screen ProgressBarCases {
        state barTint: String = "#7C3AED"
        state barTrack: String = "#EDE9FE"
        state barCustomProgress: Float64 = 0.45
        state barAccessibleLabel: String = "Upload progress"
        state barAccessibleHint: String = "Announces the upload completion percentage"
        state barAccessibleValue: String = "45 percent"
        state barAndroidWave: Bool = true
        state barUnderflow: Float64 = - 0.25
        state barZero: Float64 = 0.0
        state barMiddle: Float64 = 0.45
        state barFull: Float64 = 1.0
        state barOverflow: Float64 = 1.25
        Column(spacing: 12, padding: 16) {
            Text("ProgressBar", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Omitted progress uses the native indeterminate animation") {
                Column(spacing: 12) {
                    ProgressBar()
                    ProgressBar(
                    tint: barTint,
                    trackColor: barTrack,
                    thickness: 12,
                    cornerRadius: 6,
                    android_wave: barAndroidWave
                    )
                }
            }
            ParityCard(title: "Native default style and clamped progress values") {
                Column(spacing: 12) {
                    ProgressBar(progress: barUnderflow, accessibilityLabel: "Underflow clamps to zero")
                    ProgressBar(progress: barZero, accessibilityLabel: "No progress")
                    ProgressBar(progress: barMiddle, accessibilityLabel: "Partial progress")
                    ProgressBar(progress: barFull, accessibilityLabel: "Complete progress")
                    ProgressBar(progress: barOverflow, accessibilityLabel: "Overflow clamps to complete")
                }
            }
            ParityCard(title: "Custom fill, track, thickness, and corner treatment") {
                ProgressBar(
                progress: barCustomProgress,
                tint: barTint,
                trackColor: barTrack,
                thickness: 12,
                cornerRadius: 6,
                accessibilityLabel: barAccessibleLabel,
                accessibilityHint: barAccessibleHint,
                accessibilityValue: barAccessibleValue,
                accessibilityRole: None,
                android_wave: barAndroidWave
                )
                Text("Progress value: $barAccessibleValue", fontSize: 12, color: "#777780")
                Text("Tint: $barTint · trackColor: $barTrack", fontSize: 12, color: "#777780")
                Text("Thickness: 12 · cornerRadius: 6", fontSize: 12, color: "#777780")
                Text("Label: $barAccessibleLabel", fontSize: 12, color: "#777780")
                Text("Hint: $barAccessibleHint", fontSize: 12, color: "#777780")
                Text("Role: None (native progress role)", fontSize: 12, color: "#777780")
                Text("Android wave: $barAndroidWave (iOS ignores this parameter)", fontSize: 12, color: "#777780")
                Row(spacing: 8) {
                    Button("45%", accessibilityLabel: "Set upload progress to 45 percent") {
                        barCustomProgress = 0.45
                        barAccessibleValue = "45 percent"
                    }
                    Button("75%", accessibilityLabel: "Set upload progress to 75 percent") {
                        barCustomProgress = 0.75
                        barAccessibleValue = "75 percent"
                    }
                    Button("Colors", accessibilityLabel: "Toggle progress bar colors") {
                        if barTint == "#7C3AED" {
                            barTint = "#2563EB"
                            barTrack = "#DBEAFE"
                        } else {
                            barTint = "#7C3AED"
                            barTrack = "#EDE9FE"
                        }
                    }
                    Button("Wave", accessibilityLabel: "Toggle Android wavy progress style") {
                        barAndroidWave =!barAndroidWave
                    }
                }
            }
        }
    }

    screen ProgressRingCases {
        state ringUnderflow: Float64 = - 0.25
        state ringZero: Float64 = 0.0
        state ringMiddle: Float64 = 0.45
        state ringFull: Float64 = 1.0
        state ringOverflow: Float64 = 1.25
        state ringTint: String = "#2563EB"
        state ringAndroidWave: Bool = false
        Column(spacing: 12, padding: 16) {
            Text("ProgressRing parameters", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Clamp below zero, partial, complete, and above one") {
                Row(spacing: 16, alignment: Center) {
                    ProgressRing(progress: ringUnderflow, accessibilityLabel: "Underflow clamps to zero")
                    ProgressRing(progress: ringZero, accessibilityLabel: "No progress")
                    ProgressRing(progress: ringMiddle, accessibilityLabel: "Partial progress")
                    ProgressRing(progress: ringFull, accessibilityLabel: "Complete progress")
                    ProgressRing(progress: ringOverflow, accessibilityLabel: "Overflow clamps to complete")
                }
            }
            ParityCard(title: "Omitted progress is indeterminate") {
                Row(spacing: 20, alignment: Center) {
                    ProgressRing()
                    ProgressRing(android_wave: ringAndroidWave)
                    Button("Toggle Android wave") {
                        ringAndroidWave =!ringAndroidWave
                    }
                }
            }
            ParityCard(title: "Tint, track, size, and thickness") {
                Row(spacing: 16, alignment: Center) {
                    ProgressRing(
                    progress: ringMiddle,
                    tint: ringTint,
                    trackColor: "#DBEAFE",
                    size: 28,
                    thickness: 3,
                    accessibilityLabel: "Active upload",
                    accessibilityHint: "Shows upload completion",
                    accessibilityValue: "45 percent",
                    accessibilityRole: None
                    )
                    ProgressRing(
                    progress: ringFull,
                    tint: "#EA580C",
                    trackColor: "#FFEDD5",
                    size: 56,
                    thickness: 8,
                    accessibilityLabel: "Completed upload",
                    accessibilityHint: "Upload is complete",
                    accessibilityValue: "100 percent",
                    accessibilityRole: None
                    )
                }
                Button("Change dynamic tint") {
                    if ringTint == "#2563EB" {
                        ringTint = "#7C3AED"
                    } else {
                        ringTint = "#2563EB"
                    }
                }
            }
        }
    }

    screen FastListCases {
        state listPosition: Int32 = 0
        state reverseListPosition: Int32 = 0
        state allowGridScroll: Bool = true
        state listScrollEnabled: Bool = true
        state listPage: Int32 = 9
        state listScrollCount: Int32 = 0
        state listEndReachedCount: Int32 = 0
        state listSectionItems: Array<Array<String>> = [["First section row", "Second section row"], ["Third section row"]]
        state listMovableItems: Array<SheetAuditItem> = [SheetAuditItem(1, "Move task one"), SheetAuditItem(2, "Move task two"), SheetAuditItem(3, "Move task three")]
        state listMoveEnabled: Bool = true
        state listMoveCount: Int32 = 0
        state listDeleteCount: Int32 = 0
        PagePager(selected: listPage, accessibilityLabel: "FastList cases") {
            Tab(index: 0) {
                Column(spacing: 12, padding: 16) {
                    Text("FastList · vertical", fontSize: 24, fontWeight: Bold)
                    Text("Fixed row height 56 dp · spacing 8 dp · 12 rows")
                    FastList(count: 12, rowHeight: 56, spacing: 8, showDividers: false, accessibilityLabel: "Component parity rows") {
                        index in
                        Row(spacing: 12, padding: 8, background: "#FFFFFF", cornerRadius: 12) {
                            Icon(system: "check_circle", size: 20, tint: "#E11D48", description: "Task")
                            Text("Parity row \(index)")
                        }
                    }
                }
            }
            Tab(index: 1) {
                Column(spacing: 12, padding: 16) {
                    Text("FastList · reverse and position", fontSize: 24, fontWeight: Bold)
                    Text("Scroll position: \(reverseListPosition)")
                    FastList(count: 24, scrollPosition: reverseListPosition, reverseLayout: true, rowHeight: 48, spacing: 4, accessibilityLabel: "Reversed rows") {
                        index in
                        Text("Reverse row \(index)")
                    }
                }
            }
            Tab(index: 2) {
                Column(spacing: 12, padding: 16) {
                    Text("FastList · vertical", fontSize: 24, fontWeight: Bold)
                    Text("Virtualized rows · consistent full-width container")
                    FastList(count: 12, showDividers: false, accessibilityLabel: "Vertical rows") {
                        index in
                        Text("Vertical row \(index)")
                    }
                }
            }
            Tab(index: 3) {
                Column(spacing: 12, padding: 16) {
                    Text("FastList · horizontal", fontSize: 24, fontWeight: Bold)
                    Text("140 dp content · 96 dp row · 12 dp gap")
                    Column(height: 128) {
                        FastList(count: 4, axis: Horizontal, rowHeight: 96, spacing: 12, accessibilityLabel: "Horizontal rows") {
                            index in
                            Column(width: 140, height: 80, padding: 8, background: "#FFFFFF", cornerRadius: 12) {
                                Text("Horizontal row \(index)")
                            }
                        }
                    }
                }
            }
            Tab(index: 4) {
                Column(spacing: 12, padding: 16) {
                    Text("FastList · fixed grid", fontSize: 24, fontWeight: Bold)
                    Text("Two columns · 92 dp cells · 4 dp spacing")
                    FastList(count: 12, axis: Grid(2), rowHeight: 92, spacing: 4, accessibilityLabel: "Fixed two-column grid") {
                        index in
                        Column(padding: 8, background: "#FFFFFF", cornerRadius: 8) {
                            Text("Fixed grid \(index)")
                        }
                    }
                }
            }
            Tab(index: 5) {
                Column(spacing: 12, padding: 16) {
                    Text("FastList · responsive grid", fontSize: 24, fontWeight: Bold)
                    Text("24 cells · minimum width 160 dp · 92 dp high")
                    Switch(value: allowGridScroll, label: "Allow adaptive grid scrolling")
                    FastList(count: 24, axis: AutoGrid(160), rowHeight: 92, spacing: 4, scrollEnabled: allowGridScroll, accessibilityLabel: "Adaptive grid") {
                        index in
                        Column(padding: 8, background: "#FFFFFF", cornerRadius: 8) {
                            Text("Adaptive grid \(index)")
                        }
                    }
                }
            }
            Tab(index: 6) {
                Column(spacing: 12, padding: 16) {
                    Text("FastList · page snap", fontSize: 24, fontWeight: Bold)
                    Text("Swipe vertically to move one full viewport per page")
                    FastList(count: 3, pageSnap: true, accessibilityLabel: "Paged vertical rows") {
                        index in
                        Column(padding: 24, background: "#E8F0FF", cornerRadius: 16) {
                            Text("Page \(index)", fontSize: 28, fontWeight: Bold)
                        }
                    }
                }
            }
            Tab(index: 7) {
                Column(spacing: 12, padding: 16) {
                    Text("FastList · scroll callbacks", fontSize: 24, fontWeight: Bold)
                    Text("Scroll callbacks: \(listScrollCount) · end reached: \(listEndReachedCount) · position: \(listPosition)")
                    Switch(value: listScrollEnabled, label: "Scrolling enabled")
                    Button("Reset scroll callbacks") {
                        listScrollCount = 0
                        listPosition = 0
                    }
                    FastList(count: 24, rowHeight: 48, spacing: 8, scrollPosition: listPosition, scrollEnabled: listScrollEnabled, showDividers: true, accessibilityLabel: "FastList callback rows") {
                        index in
                        Row(spacing: 8, padding: 8, alignment: Center, background: "#FFFFFF") {
                            Text("Scroll row \(index)")
                            Spacer()
                        }
                    }.onScroll {
                        listScrollCount += 1
                    }.onEndReached {
                        listEndReachedCount += 1
                    }.stickyHeader {
                        Column(padding: 8, background: "#E8F0FF") {
                            Text("Pinned list header")
                        }
                    }
                }
            }
            Tab(index: 8) {
                Column(spacing: 12, padding: 16) {
                    Text("FastList · sections and headers", fontSize: 24, fontWeight: Bold)
                    Text("Section source · sectionHeader · dividers")
                    FastList(sections: listSectionItems, rowHeight: 48, spacing: 4, showDividers: true, accessibilityLabel: "FastList section rows") {
                        item, index, section in
                        Row(padding: 8, background: "#FFFFFF") {
                            Text("Section \(section) · row \(index): \(item)")
                        }
                    }.sectionHeader {
                        Column(padding: 8, background: "#E8F0FF") {
                            Text("Section header", fontWeight: Semibold)
                        }
                    }
                }
            }
            Tab(index: 9) {
                Column(spacing: 12, padding: 16) {
                    Text("FastList · keyed collection and actions", fontSize: 24, fontWeight: Bold)
                    Text("Move events: \(listMoveCount) · delete actions: \(listDeleteCount)")
                    Switch(value: listMoveEnabled, label: "Allow row reordering")
                    Button("Reset movable tasks") {
                        listMovableItems = [SheetAuditItem(1, "Move task one"), SheetAuditItem(2, "Move task two"), SheetAuditItem(3, "Move task three")]
                        listMoveCount = 0
                        listDeleteCount = 0
                    }
                    Text("Android: long-press + drag. iOS: drag the row handle.")
                    Text("Turn reordering off to use swipe actions on either platform.")
                    FastList(listMovableItems, key:.id, showDividers: true, accessibilityLabel: "FastList keyed movable tasks") {
                        item, index in
                        Row(spacing: 8, padding: 8, alignment: Center, background: "#FFFFFF") {
                            Text("\(index + 1). \(item.title)")
                            Spacer()
                        }
                    }.onMove(enabled: listMoveEnabled) {
                        from, to ->
                        listMoveCount += 1
                        listMovableItems.move(from, to)
                    }.swipeActions {
                        Button("Delete", icon: "delete", style: Borderless) {
                            listDeleteCount += 1
                            listMovableItems.remove(index)
                        }
                    }
                }
            }
        }
    }

    screen RefreshCases {
        state refreshing: Bool = false
        state refreshCount: Int32 = 0
        Column(spacing: 12, padding: 16) {
            Text("RefreshControl", fontSize: 28, fontWeight: Bold)
            Text("Refreshes: $refreshCount")
            RefreshControl(isRefreshing: refreshing) {
                Column(spacing: 16, padding: 20, minHeight: 320, background: "#FFFFFF", cornerRadius: 16) {
                    Text("Pull down to refresh")
                    Text("Keep scrolling content stable while refreshing.")
                }
            }.onRefresh {
                refreshing = false
                refreshCount = refreshCount + 1
            }
        }
    }

    screen KeyboardCases {
        state text: String = ""
        Column(spacing: 12, padding: 16) {
            Text("KeyboardAware", fontSize: 28, fontWeight: Bold)
            KeyboardAware(dismiss: Never) {
                Column(spacing: 12, padding: 16, background: "#FFFFFF", cornerRadius: 16) {
                    TextInput(value: text, placeholder: "Enter a task")
                    Button("Save draft") {
                        text = text
                    }
                    Text("Content above should remain visible when the keyboard opens.")
                }
            }
        }
    }

    screen IconCases {
        Column(spacing: 12, padding: 16) {
            Text("Icon", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Size and tint") {
                Row(spacing: 24, alignment: Center) {
                    Icon(system: "search", size: 20, tint: "#8E8E93", description: "Small search")
                    Icon(system: "search", size: 32, tint: "#007AFF", description: "Medium search")
                    Icon(system: "search", size: 48, tint: "#E11D48", description: "Large search")
                }
                Icon(sfsymbol: "star.fill", size: 24, tint: "#E11D48", description: "Native iOS symbol")
                Icon(materialsymbol: "star", size: 24, tint: "#E11D48", description: "Native Android symbol")
            }
        }
    }

    screen ImageCases {
        Column(spacing: 12, padding: 16) {
            Text("Image", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Asset, fit, and crop") {
                Image(asset: "parity_sample", description: "Parity sample", scale: Fit, maxHeight: 120)
                Image(asset: "parity_sample", description: "Parity sample cropped", scale: Fill, fillMaxSize: false, maxHeight: 80)
                Image(url: "https://parity.invalid/image.png", description: "Remote image fallback", scale: Fit, placeholder: "parity_sample", maxHeight: 80)
                Image(url: "https://127.0.0.1:1/image.png", description: "Remote image blank by default", maxHeight: 80)
                Image(url: "https://127.0.0.1:1/image.png", description: "Opt-in remote loading indicator", showLoadingIndicator: true, maxHeight: 80)
                Image(file: "/tmp/nexa-parity-missing-image.png", description: "Local file fallback", scale: Fit, maxHeight: 80)
            }
        }
    }

    screen GradientCases {
        Column(spacing: 12, padding: 16) {
            Text("LinearGradient", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Direction and fixed height") {
                LinearGradient(startColor: "#E11D48", endColor: "#2563EB", direction: LeadingToTrailing, height: 64)
                LinearGradient(startColor: "#E11D48", endColor: "#2563EB", direction: TopToBottom, height: 120)
            }
        }
    }

    screen LinkCases {
        Column(spacing: 12, padding: 16) {
            Text("Link", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Inline link sizing and accessibility") {
                Link(url: "https://example.com", accessibilityLabel: "Open example website") {
                    Text("Open example website")
                }
            }
        }
    }

    screen NavigationBackCases {
        state canOpenDirection: Bool = true
        Column(spacing: 12, padding: 16) {
            Text("NavigationBack", fontSize: 28, fontWeight: Bold)
            Text("Compare the explicit back control with each platform's navigation header.")
            NavigationBack(label: "Return to component index", comment: "Explicit back label parity sample")
            NavigationLink(destination: DirectionCases, when: canOpenDirection) {
                Text("Conditional navigation link")
            }
        }
    }

    screen ToolbarCases {
        state actions: Int32 = 0
        Column(spacing: 12, padding: 16) {
            Toolbar(placement: Trailing) {
                Button("Action $actions", accessibilityLabel: "Toolbar action") {
                    actions = actions + 1
                }
            }
            Text("Toolbar", fontSize: 28, fontWeight: Bold)
            Text("Tap the trailing action and compare title placement.")
        }
    }

    screen PagerCases {
        state page: Int32 = 0
        Column(spacing: 12, padding: 16) {
            Text("PagePager", fontSize: 28, fontWeight: Bold)
            PagePager(selected: page, accessibilityLabel: "Parity pages") {
                Tab(index: 0) {
                    Column(spacing: 12, padding: 24, alignment: Center) {
                        Text("First page")
                        Button("Next") {
                            page = 1
                        }
                    }
                }
                Tab(index: 1) {
                    Column(spacing: 12, padding: 24, alignment: Center) {
                        Text("Second page")
                        Button("Previous") {
                            page = 0
                        }
                    }
                }
            }
        }
    }

    screen BottomBarCases {
        state selectedTab: Int32 = 0
        AppBottomBar(selected: selectedTab, tint: "#E11D48") {
            Tab(index: 0, label: "Inbox", icon: "inbox", title: "Inbox") {
                Column(spacing: 12, padding: 16) {
                    Text("Inbox tab content")
                }
            }
            Tab(index: 1, label: "Today", icon: "sun", title: "Today") {
                Column(spacing: 12, padding: 16) {
                    Text("Today tab content")
                }
            }
            Tab(index: 2, label: "Search", icon: "search", title: "Search") {
                Column(spacing: 12, padding: 16) {
                    Text("Search tab content")
                }
            }
        }
    }

    screen SplitViewCases {
        state detailVisible: Bool = false
        NavigationSplitView(detailVisible: detailVisible) {
            Sidebar {
                Column(spacing: 12, padding: 16) {
                    Text("Sidebar")
                    Button("Show detail") {
                        detailVisible = true
                    }
                }
            }
            Detail {
                Column(spacing: 12, padding: 16) {
                    Text("Detail")
                    Button("Show sidebar") {
                        detailVisible = false
                    }
                }
            }
        }
    }

    screen SheetCases {
        state sheetPresented: Bool = false
        state nestedSheetPresented: Bool = false
        state headerSheetPresented: Bool = false
        state headerSheetSaved: Bool = false
        state expandedSheetPresented: Bool = false
        state defaultSheetPresented: Bool = false
        state morePaddingSheetPresented: Bool = false
        state mapSheetPresented: Bool = false
        state mapSheetDismissed: Bool = false
        state mapSheetSelectedSnapPoint: Float64 = 0.5
        state backgroundActionCount: Int32 = 0
        state sheetSurface: String = "#F1F5F9"
        state sheetNote: String = ""
        state layoutAuditPresented: Bool = false
        state listAuditPresented: Bool = false
        state sheetLayoutPage: Int32 = 0
        state sheetLayoutNote: String = ""
        state sheetLayoutEnabled: Bool = true
        state sheetLayoutSlider: Float64 = 0.5
        state sheetListPage: Int32 = 0
        state sheetListPosition: Int32 = 0
        state sheetAllowGridScroll: Bool = true
        state sheetSectionItems: Array<Array<String>> = [["First section row", "Second section row"], ["Third section row"]]
        state sheetMovableItems: Array<SheetAuditItem> = [SheetAuditItem(1, "Move task one"), SheetAuditItem(2, "Move task two"), SheetAuditItem(3, "Move task three")]
        state sheetMoveEnabled: Bool = true
        state sheetMoveCount: Int32 = 0
        state sheetListScrollEnabled: Bool = true
        state sheetListScrollCount: Int32 = 0
        state sheetListEndCount: Int32 = 0
        state sheetListDeleteCount: Int32 = 0
        state sheetRefreshing: Bool = false
        state sheetRefreshCount: Int32 = 0
        Column(spacing: 12, padding: 16) {
            Text("BottomSheet", fontSize: 28, fontWeight: Bold)
            Button("Open medium and expanded sheet") {
                sheetPresented = true
            }
            Button("Open sheet header actions") {
                headerSheetSaved = false
                BottomSheet.present(headerSheetPresented)
            }
            Button("Open locked expanded sheet") {
                expandedSheetPresented = true
            }
            Button("Open compact half-height sheet") {
                defaultSheetPresented = true
            }
            Button("Open sheet with more content padding") {
                morePaddingSheetPresented = true
            }
            Button("Open layout parity inside sheet") {
                layoutAuditPresented = true
            }
            Button("Open FastList parity inside sheet") {
                listAuditPresented = true
            }
            Button("Background action: \(backgroundActionCount)") {
                backgroundActionCount += 1
            }
            Button("Open custom map sheet") {
                mapSheetDismissed = false
                BottomSheet.present(mapSheetPresented)
            }
            BottomSheet(
            isPresented: sheetPresented,
            detents: [Medium, Expanded],
            initialDetent: Medium,
            showDragIndicator: true,
            allowsDismissal: true,
            allowsBackgroundInteraction: false,
            shouldDismissOnBackPress: true,
            backgroundColor: sheetSurface
            ) {
                Column(spacing: 12) {
                    Text("Task details", fontSize: 20, fontWeight: Semibold)
                    Text("Medium and expanded native resting sizes")
                    TextInput(value: sheetNote, placeholder: "Add an optional note", accessibilityLabel: "Task note")
                    Button("Open nested sheet") {
                        BottomSheet.present(nestedSheetPresented)
                    }
                    BottomSheet(
                    isPresented: nestedSheetPresented,
                    detents: [Medium, Expanded],
                    initialDetent: Medium
                    ) {
                        Column(spacing: 12) {
                            Text("Nested quick actions", fontSize: 20, fontWeight: Semibold)
                            Text("The task details sheet stays open underneath.")
                            Button("Return to task details") {
                                BottomSheet.dismiss(nestedSheetPresented)
                            }
                        }
                    }
                    Button("Done", style: BorderedProminent, tint: "#2563EB") {
                        sheetPresented = false
                    }
                }
            }
            BottomSheet(
            isPresented: headerSheetPresented,
            detents: [Medium, Expanded],
            initialDetent: Medium
            ) {
                Column(spacing: 16, alignment: Start) {
                    Row(spacing: 12) {
                        Text("Edit task", fontSize: 20, fontWeight: Semibold)
                        Spacer()
                        Button("Save", icon: "save", style: Borderless) {
                            headerSheetSaved = true
                        }
                        Button("Close", icon: "close", style: Plain) {
                            BottomSheet.dismiss(headerSheetPresented)
                        }
                    }
                    Text("Update the launch plan")
                    Text(headerSheetSaved?"Changes saved": "Unsaved changes")
                    Text("Save keeps this sheet open. Close dismisses it.")
                }
            }
            BottomSheet(
            isPresented: expandedSheetPresented,
            detents: [Expanded],
            initialDetent: Expanded,
            showDragIndicator: false,
            allowsDismissal: false
            ) {
                Column(spacing: 12) {
                    Text("Expanded and locked", fontSize: 20, fontWeight: Semibold)
                    Text("The drag handle, Back, and outside dismissal are disabled.")
                    Button("Close from content") {
                        expandedSheetPresented = false
                    }
                }
            }
            BottomSheet(
            isPresented: defaultSheetPresented,
            snapPoints: [0.5],
            initialSnapPoint: 0.5,
            scrimColor: "#00000033"
            ) {
                Column(spacing: 12) {
                    Text("Half-height · compact default inset", fontSize: 20, fontWeight: Semibold)
                    Row(spacing: 8, padding: 8, horizontalArrangement: Start, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Default: 8 pt/dp")
                        Spacer()
                    }
                    Button("Close") {
                        defaultSheetPresented = false
                    }
                }
            }
            BottomSheet(
            isPresented: morePaddingSheetPresented,
            contentPadding: 24,
            detents: [Medium, Expanded]
            ) {
                Column(spacing: 12) {
                    Text("More content padding", fontSize: 20, fontWeight: Semibold)
                    Row(spacing: 8, padding: 8, horizontalArrangement: Start, background: "#F2F2F7", cornerRadius: 8) {
                        Text("Override: 24 pt/dp")
                        Spacer()
                    }
                    Button("Close") {
                        morePaddingSheetPresented = false
                    }
                }
            }
            BottomSheet(
            isPresented: layoutAuditPresented,
            contentPadding: 0,
            detents: [Expanded],
            initialDetent: Expanded,
            showDragIndicator: true
            ) {
                PagePager(selected: sheetLayoutPage, accessibilityLabel: "Sheet layout parity pages") {
                    Tab(index: 0) {
                        Column(spacing: 10, padding: 16) {
                            Text("Column · start / center / end", fontSize: 20, fontWeight: Semibold)
                            Text("Column default: centered, top-first")
                            Column(width: 280, spacing: 8, padding: 8, background: "#F2F2F7", cornerRadius: 12) {
                                Row(spacing: 8, alignment: Center) {
                                    Column(width: 74, height: 76, spacing: 6, padding: 6, alignment: Start, background: "#DDEBFF", cornerRadius: 8) {
                                        Text("Start", fontSize: 12, fontWeight: Semibold)
                                        Text("left", alignment: Leading)
                                    }
                                    Column(width: 74, height: 76, spacing: 6, padding: 6, alignment: Center, background: "#E8F0FF", cornerRadius: 8) {
                                        Text("Center", fontSize: 12, fontWeight: Semibold)
                                        Text("middle", alignment: Center)
                                    }
                                    Column(width: 74, height: 76, spacing: 6, padding: 6, alignment: End, background: "#DDEBFF", cornerRadius: 8) {
                                        Text("End", fontSize: 12, fontWeight: Semibold)
                                        Text("right", alignment: Trailing)
                                    }
                                }
                            }
                            Column(width: 280, spacing: 0, padding: 0, alignment: Start, background: "#FFF1E8", cornerRadius: 8) {
                                Text("spacing 0 · padding 0", padding: 0)
                                Text("second child starts below first", padding: 0)
                            }
                            Column(width: 280, spacing: 12, padding: 16, alignment: Start, background: "#E8F0FF", cornerRadius: 8) {
                                Text("spacing 12 · padding 16", padding: 8)
                                Text("nested padding 8", padding: 8)
                            }
                            Text("Text padding 16", padding: 16)
                            TextInput(value: sheetLayoutNote, placeholder: "TextInput fills its sheet column", accessibilityLabel: "Sheet parity sheetLayoutNote")
                            Button("Sheet child button") {
                                sheetLayoutEnabled =!sheetLayoutEnabled
                            }
                        }
                    }
                    Tab(index: 1) {
                        Column(spacing: 10, padding: 16, alignment: Start) {
                            Text("Row · cross and main axis", fontSize: 20, fontWeight: Semibold)
                            Text("Horizontal: Start / Center / End")
                            Row(width: 280, height: 54, spacing: 8, padding: 6, alignment: Center, horizontalArrangement: Start, background: "#F2F2F7", cornerRadius: 8) {
                                Column(width: 48, height: 28, background: "#DDEBFF", cornerRadius: 4) {
                                    Text("A", alignment: Center)
                                }
                                Column(width: 48, height: 28, background: "#E8F0FF", cornerRadius: 4) {
                                    Text("B", alignment: Center)
                                }
                                Column(width: 48, height: 28, background: "#DDEBFF", cornerRadius: 4) {
                                    Text("C", alignment: Center)
                                }
                            }
                            Row(width: 280, height: 54, spacing: 8, padding: 6, alignment: Center, horizontalArrangement: Center, background: "#F2F2F7", cornerRadius: 8) {
                                Column(width: 48, height: 28, background: "#DDEBFF", cornerRadius: 4) {
                                    Text("A", alignment: Center)
                                }
                                Column(width: 48, height: 28, background: "#E8F0FF", cornerRadius: 4) {
                                    Text("B", alignment: Center)
                                }
                                Column(width: 48, height: 28, background: "#DDEBFF", cornerRadius: 4) {
                                    Text("C", alignment: Center)
                                }
                            }
                            Row(width: 280, height: 54, spacing: 8, padding: 6, alignment: Center, horizontalArrangement: End, background: "#F2F2F7", cornerRadius: 8) {
                                Column(width: 48, height: 28, background: "#DDEBFF", cornerRadius: 4) {
                                    Text("A", alignment: Center)
                                }
                                Column(width: 48, height: 28, background: "#E8F0FF", cornerRadius: 4) {
                                    Text("B", alignment: Center)
                                }
                                Column(width: 48, height: 28, background: "#DDEBFF", cornerRadius: 4) {
                                    Text("C", alignment: Center)
                                }
                            }
                            Text("Vertical alignment: Start / Center / End")
                            Row(width: 280, height: 60, spacing: 8, padding: 6, alignment: Start, background: "#F2F2F7", cornerRadius: 8) {
                                Column(width: 48, height: 20, background: "#DDEBFF", cornerRadius: 4) {
                                    Text("Top", fontSize: 11, alignment: Center)
                                }
                                Column(width: 48, height: 40, background: "#E8F0FF", cornerRadius: 4) {
                                    Text("Tall", fontSize: 11, alignment: Center)
                                }
                            }
                            Row(width: 280, height: 60, spacing: 8, padding: 6, alignment: Center, horizontalArrangement: Start, background: "#F2F2F7", cornerRadius: 8) {
                                Column(width: 48, height: 20, background: "#DDEBFF", cornerRadius: 4) {
                                    Text("Top", fontSize: 11, alignment: Center)
                                }
                                Column(width: 48, height: 40, background: "#E8F0FF", cornerRadius: 4) {
                                    Text("Tall", fontSize: 11, alignment: Center)
                                }
                            }
                            Row(width: 280, height: 60, spacing: 8, padding: 6, alignment: End, horizontalArrangement: Start, background: "#F2F2F7", cornerRadius: 8) {
                                Column(width: 48, height: 20, background: "#DDEBFF", cornerRadius: 4) {
                                    Text("Top", fontSize: 11, alignment: Center)
                                }
                                Column(width: 48, height: 40, background: "#E8F0FF", cornerRadius: 4) {
                                    Text("Tall", fontSize: 11, alignment: Center)
                                }
                            }
                            Switch(value: sheetLayoutEnabled, label: "Switch remains interactive")
                            Slider(value: sheetLayoutSlider, min: 0, max: 1, step: 0.1)
                        }
                    }
                    Tab(index: 2) {
                        Column(spacing: 12, padding: 16) {
                            Text("Stack · overlay and Spacer", fontSize: 20, fontWeight: Semibold)
                            Row(width: 280, height: 92, spacing: 8, padding: 4, alignment: Center, background: "#F2F2F7", cornerRadius: 8) {
                                Stack(width: 78, height: 76, padding: 4, alignment: Start, background: "#DDEBFF", cornerRadius: 8) {
                                    Text("Top start", fontSize: 11)
                                }
                                Stack(width: 78, height: 76, padding: 4, alignment: Center, background: "#E8F0FF", cornerRadius: 8) {
                                    Text("Center", fontSize: 11)
                                }
                                Stack(width: 78, height: 76, padding: 4, alignment: End, background: "#DDEBFF", cornerRadius: 8) {
                                    Text("Bottom end", fontSize: 11)
                                }
                            }
                            Row(width: 280, height: 56, spacing: 8, padding: 8, horizontalArrangement: Start, background: "#F2F2F7", cornerRadius: 8) {
                                Text("Leading", padding: 4)
                                Spacer()
                                Text("Trailing", padding: 4)
                            }
                            Column(width: 280, minHeight: 56, maxHeight: 96, spacing: 8, padding: 8, alignment: Start, background: "#F2F2F7", cornerRadius: 8) {
                                Text("Width + min/max height constraints", fontSize: 12)
                                ProgressBar(progress: sheetLayoutSlider, thickness: 8, cornerRadius: 4)
                                ProgressRing(progress: sheetLayoutSlider, size: 32, thickness: 4)
                            }
                        }
                    }
                }
            }
            BottomSheet(
            isPresented: listAuditPresented,
            contentPadding: 0,
            detents: [Expanded],
            initialDetent: Expanded,
            showDragIndicator: true
            ) {
                PagePager(selected: sheetListPage, accessibilityLabel: "FastList parity pages inside sheet") {
                    Tab(index: 0) {
                        Column(spacing: 12, padding: 16) {
                            Text("FastList · vertical", fontSize: 24, fontWeight: Bold)
                            Text("Fixed row height 56 dp · spacing 8 dp · 12 rows")
                            FastList(count: 12, rowHeight: 56, spacing: 8, showDividers: false, accessibilityLabel: "Component parity rows") {
                                index in
                                Row(spacing: 12, padding: 8, background: "#FFFFFF", cornerRadius: 12) {
                                    Icon(system: "check_circle", size: 20, tint: "#E11D48", description: "Task")
                                    Text("Parity row \(index)")
                                }
                            }
                        }
                    }
                    Tab(index: 1) {
                        Column(spacing: 12, padding: 16) {
                            Text("FastList · reverse and position", fontSize: 24, fontWeight: Bold)
                            Text("Scroll position: \(sheetListPosition)")
                            FastList(count: 24, scrollPosition: sheetListPosition, reverseLayout: true, rowHeight: 48, spacing: 4, accessibilityLabel: "Reversed rows") {
                                index in
                                Text("Reverse row \(index)")
                            }
                        }
                    }
                    Tab(index: 2) {
                        Column(spacing: 12, padding: 16) {
                            Text("FastList · vertical", fontSize: 24, fontWeight: Bold)
                            Text("Virtualized rows · consistent full-width container")
                            FastList(count: 12, showDividers: false, accessibilityLabel: "Vertical rows") {
                                index in
                                Text("Vertical row \(index)")
                            }
                        }
                    }
                    Tab(index: 3) {
                        Column(spacing: 12, padding: 16) {
                            Text("FastList · horizontal", fontSize: 24, fontWeight: Bold)
                            Text("140 dp content · 96 dp row · 12 dp gap")
                            Column(height: 128) {
                                FastList(count: 4, axis: Horizontal, rowHeight: 96, spacing: 12, accessibilityLabel: "Horizontal rows") {
                                    index in
                                    Column(width: 140, height: 80, padding: 8, background: "#FFFFFF", cornerRadius: 12) {
                                        Text("Horizontal row \(index)")
                                    }
                                }
                            }
                        }
                    }
                    Tab(index: 4) {
                        Column(spacing: 12, padding: 16) {
                            Text("FastList · fixed grid", fontSize: 24, fontWeight: Bold)
                            Text("Two columns · 92 dp cells · 4 dp spacing")
                            FastList(count: 12, axis: Grid(2), rowHeight: 92, spacing: 4, accessibilityLabel: "Fixed two-column grid") {
                                index in
                                Column(padding: 8, background: "#FFFFFF", cornerRadius: 8) {
                                    Text("Fixed grid \(index)")
                                }
                            }
                        }
                    }
                    Tab(index: 5) {
                        Column(spacing: 12, padding: 16) {
                            Text("FastList · responsive grid", fontSize: 24, fontWeight: Bold)
                            Text("24 cells · minimum width 160 dp · 92 dp high")
                            Switch(value: sheetAllowGridScroll, label: "Allow adaptive grid scrolling")
                            FastList(count: 24, axis: AutoGrid(160), rowHeight: 92, spacing: 4, scrollEnabled: sheetAllowGridScroll, accessibilityLabel: "Adaptive grid") {
                                index in
                                Column(padding: 8, background: "#FFFFFF", cornerRadius: 8) {
                                    Text("Adaptive grid \(index)")
                                }
                            }
                        }
                    }
                    Tab(index: 6) {
                        Column(spacing: 12, padding: 16) {
                            Text("FastList · page snap", fontSize: 24, fontWeight: Bold)
                            Text("Swipe vertically to move one full viewport per page")
                            FastList(count: 3, pageSnap: true, accessibilityLabel: "Paged vertical rows") {
                                index in
                                Column(padding: 24, background: "#E8F0FF", cornerRadius: 16) {
                                    Text("Page \(index)", fontSize: 28, fontWeight: Bold)
                                }
                            }
                        }
                    }
                    Tab(index: 7) {
                        Column(spacing: 12, padding: 16) {
                            Text("FastList · sections and headers", fontSize: 24, fontWeight: Bold)
                            Text("Section source · sectionHeader · dividers")
                            FastList(sections: sheetSectionItems, rowHeight: 48, spacing: 4, showDividers: true, accessibilityLabel: "Sheet sectioned rows") {
                                item, index, section in
                                Row(padding: 8, background: "#FFFFFF") {
                                    Text("Section \(section) · row \(index): \(item)")
                                }
                            }.sectionHeader {
                                Column(padding: 8, background: "#E8F0FF") {
                                    Text("Section header", fontWeight: Semibold)
                                }
                            }
                        }
                    }
                    Tab(index: 8) {
                        Column(spacing: 12, padding: 16) {
                            Text("FastList · keyed collection and actions", fontSize: 24, fontWeight: Bold)
                            Text("Move enabled: \(sheetMoveEnabled)")
                            Text("Move events: \(sheetMoveCount)")
                            Text("Delete actions: \(sheetListDeleteCount)")
                            Switch(value: sheetMoveEnabled, label: "Allow row reordering")
                            Text("Android: long-press + drag. iOS: drag the row handle.")
                            FastList(sheetMovableItems, key:.id, showDividers: true, accessibilityLabel: "Keyed movable tasks") {
                                item, index in
                                Row(spacing: 8, padding: 8, alignment: Center, background: "#FFFFFF") {
                                    Text("\(index + 1). \(item.title)")
                                    Spacer()
                                }
                            }.onMove(enabled: sheetMoveEnabled) {
                                from, to ->
                                sheetMoveCount += 1
                                sheetMovableItems.move(from, to)
                            }.swipeActions {
                                Button("Delete", icon: "delete", style: Borderless) {
                                    sheetListDeleteCount += 1
                                }
                            }
                        }
                    }
                    Tab(index: 9) {
                        Column(spacing: 12, padding: 16) {
                            Text("FastList · scroll callbacks", fontSize: 24, fontWeight: Bold)
                            Text("Scroll callbacks: \(sheetListScrollCount) · end reached: \(sheetListEndCount) · position: \(sheetListPosition)")
                            Button("Reset scroll callbacks") {
                                sheetListScrollCount = 0
                                sheetListPosition = 0
                            }
                            Switch(value: sheetListScrollEnabled, label: "Scrolling enabled")
                            FastList(count: 24, rowHeight: 48, spacing: 8, scrollPosition: sheetListPosition, scrollEnabled: sheetListScrollEnabled, showDividers: true, accessibilityLabel: "Sheet scroll callback rows") {
                                index in
                                Row(spacing: 8, padding: 8, alignment: Center, background: "#FFFFFF") {
                                    Text("Scroll row \(index)")
                                    Spacer()
                                }
                            }.onScroll {
                                sheetListScrollCount += 1
                            }.onEndReached {
                                sheetListEndCount += 1
                            }.stickyHeader {
                                Column(padding: 8, background: "#E8F0FF") {
                                    Text("Pinned list header")
                                }
                            }
                        }
                    }
                    Tab(index: 10) {
                        Column(spacing: 12, padding: 16) {
                            Text("FastList · pull to refresh", fontSize: 24, fontWeight: Bold)
                            Text("Refreshes: \(sheetRefreshCount)")
                            Text("Pull down inside the list to exercise refresh")
                            RefreshControl(isRefreshing: sheetRefreshing) {
                                FastList(count: 8, rowHeight: 56, spacing: 8, accessibilityLabel: "Pull to refresh sheet rows") {
                                    index in
                                    Text("Refresh row \(index)")
                                }
                            }.onRefresh {
                                sheetRefreshing = false
                                sheetRefreshCount += 1
                            }
                        }
                    }
                }
            }
            BottomSheet(
            isPresented: mapSheetPresented,
            snapPoints: [0.25, 0.5, 0.85],
            selectedSnapPoint: mapSheetSelectedSnapPoint,
            showDragIndicator: true,
            allowsDismissal: true,
            allowsBackgroundInteraction: true,
            shouldDismissOnBackPress: false
            ) {
                Column(spacing: 4) {
                    Row(spacing: 8) {
                        Text("Map sheet", fontSize: 20, fontWeight: Semibold)
                        Spacer()
                        Button("Close") {
                            BottomSheet.dismiss(mapSheetPresented)
                        }
                    }
                    Text(mapSheetSelectedSnapPoint == 0.25
                    ?"Selected snap point: Compact (25%)"
                    : (mapSheetSelectedSnapPoint == 0.5
                    ?"Selected snap point: Half (50%)"
                    : "Selected snap point: Expanded (85%)"))
                    Row(spacing: 8) {
                        Button("Compact") {
                            BottomSheet.snapTo(mapSheetSelectedSnapPoint, 0.25)
                        }
                        Button("Half") {
                            BottomSheet.snapTo(mapSheetSelectedSnapPoint, 0.5)
                        }
                        Button("Expand") {
                            BottomSheet.snapTo(mapSheetSelectedSnapPoint, 0.85)
                        }
                    }
                }
            }.onDismiss {
                mapSheetDismissed = true
            }
            Text(mapSheetDismissed?"Dismiss callback ran": "Dismiss callback waiting")
        }
    }

    screen DialogCases {
        state dialogPresented: Bool = false
        Column(spacing: 12, padding: 16) {
            Text("Dialog", fontSize: 28, fontWeight: Bold)
            Button("Open dialog") {
                dialogPresented = true
            }
            Dialog(isPresented: dialogPresented, title: "Delete task?", message: "This action can be undone.", comment: "Dialog with cancel and delete actions") {
                Button("Cancel") {
                    dialogPresented = false
                }
                Button("Delete") {
                    dialogPresented = false
                }
            }
        }
    }

    screen ConfirmationCases {
        state confirmationPresented: Bool = false
        Column(spacing: 12, padding: 16) {
            Text("ConfirmationDialog", fontSize: 28, fontWeight: Bold)
            Button("Open actions") {
                confirmationPresented = true
            }
            ConfirmationDialog(isPresented: confirmationPresented, title: "Task actions", comment: "Context actions for a task") {
                Button("Mark complete") {
                    confirmationPresented = false
                }
                Button("Cancel") {
                    confirmationPresented = false
                }
            }
        }
    }

    screen AppearanceCases {
        Column(spacing: 12, padding: 16) {
            Text("Appearance", fontSize: 28, fontWeight: Bold)
            Appearance(mode: "light") {
                Column(spacing: 8, padding: 12, cornerRadius: 16, background: "#F2F2F7") {
                    Text("Light appearance surface")
                }
            }
            Appearance(mode: "dark") {
                Column(spacing: 8, padding: 12, cornerRadius: 16, background: "#1C1C1E") {
                    Text("Dark appearance surface")
                }
            }
        }
    }

    screen StatusBarCases {
        StatusBar(style: Default, hidden: false, background: "#F2F2F7")
        Column(spacing: 12, padding: 16) {
            Text("StatusBar", fontSize: 28, fontWeight: Bold)
            Text("Compare status-bar foreground, background, and safe-area handling.")
        }
    }

    screen AccessibilityCases {
        state selected: Bool = false
        Column(spacing: 12, padding: 16) {
            Text("Accessibility", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Role, label, value, and action") {
                Text("Section title", accessibilityLabel: "Parity section heading", accessibilityHint: "Introduces the controls below", accessibilityRole: Header)
                Button("Toggle selection", accessibilityLabel: "Selection", accessibilityValue: "Selected: $selected") {
                    selected =!selected
                }
                Icon(system: "check_circle", size: 24, tint: "#E11D48", description: "Selected state", accessibilityLabel: "Selected state", accessibilityRole: Image)
            }
        }
    }

    screen LifecycleCases {
        state appearances: Int32 = 0
        state departures: Int32 = 0
        OnAppear {
            appearances = appearances + 1
        }
        OnDisappear {
            departures = departures + 1
        }
        Column(spacing: 12, padding: 16) {
            Text("Screen lifecycle", fontSize: 28, fontWeight: Bold)
            Text("Appearances: $appearances")
            Text("Departures: $departures")
            Text("App active events: $appActivations")
            Text("App inactive events: $appDeactivations")
            Text("App background events: $appBackgroundEntries")
            Text("Navigate away and back to compare lifecycle delivery.")
        }
    }

    screen DirectionCases {
        Column(spacing: 12, padding: 16) {
            Text("Direction", fontSize: 28, fontWeight: Bold)
            ParityCard(title: "Layout follows the app direction") {
                Text("Leading and trailing adapt to the app's layout direction.")
                Row(spacing: 12, padding: 12, background: "#F2F2F7", cornerRadius: 12) {
                    Text("Leading")
                    Spacer()
                    Text("Trailing")
                }
            }
            NavigationLink(destination: NavigationBackCases) {
                Text("Open nested navigation level")
            }
        }
    }

    body {
        OnActive {
            appActivations = appActivations + 1
        }
        OnInactive {
            appDeactivations = appDeactivations + 1
        }
        OnBackground {
            appBackgroundEntries = appBackgroundEntries + 1
        }
        Direction(value: LTR)
        NavigationStack(root: Catalog, titleMode: Inline, titleAlignment: Automatic)
    }
}
