            Text("Form and Section", fontSize: 28, fontWeight: Bold)
            Form(showDividers: false, background: "#FFFFFF") {
                Section(title: "First group", footer: "First section footer", comment: "Grouped rows with explanatory footer", showDividers: true, background: "#FFFFFF") {
                    Text("First row")
                    Text("Second row")
