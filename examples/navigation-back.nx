app NavigationDemo {
    state visits: Int32 = 0

    screen Home {
        OnAppear {
            visits = visits + 1
        }

        Column(spacing: 12) {
            Text("Home")
            Text(visits)
            NavigationLink(destination: Profile) {
                Text("Open profile")
            }
        }
    }

    screen Profile {
        state profileVisits: Int32 = 0

        StatusBar(style: Light, hidden: false)

        Column(spacing: 12) {
            Text("Profile")
            Text(visits)
            Text(profileVisits)
            NavigationBack(label: "Back")
            Button("Increment visits") {
                visits = visits + 1
            }
            Button("Increment profile visits") {
                profileVisits = profileVisits + 1
            }
        }
    }

    body {
        NavigationStack(root: Home)
    }
}
