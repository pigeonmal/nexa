app FastListRefreshDemo {
    state refreshing: Bool = false
    state rows: Array<String> = ["First", "Second"]

    body {
        RefreshControl(isRefreshing: refreshing) {
            FastList(rows, key: .self, rowHeight: 56) { row, index in
                Text("\(index): \(row)")
            }
        }.onRefresh {
            refreshing = true
            rows.append("Refreshed")
            refreshing = false
        }
    }
}
