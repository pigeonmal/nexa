component Card(title: String) {
    body {
        Column(spacing: 8, padding: 16) {
            Text(title, fontWeight: Semibold)
            Content()
        }
    }
}

app ComponentSlots {
    body {
        Column(spacing: 12, padding: 20) {
            Card(title: "Account") {
                Text("Signed in")
                Button("Sign out") {}
            }
            Card(title: "Help") {
                Text("Contact support")
            }
        }
    }
}
