import "components/CounterButton.nx"

app CustomComponents {
    state message: String = "Tap to update each button independently"

    theme {
        color accent(light: "#155EEF", dark: "#84ADFF")
    }

    body {
        Column(spacing: 16, padding: 20) {
            Text(message)
            CounterButton(label: "First")
            CounterButton(label: "Second")
        }
    }
}
