app NavigationDemo {
    state visits: Int32 = 0

    screen Home {
        OnAppear {
            visits = visits + 1
        }

        Column(spacing: 12) {
            Text("Home")
            Text(visits)
            NavigationLink(destination: Profile) {
                Text("Open profile")
            }
        }
    }

    screen Profile {
        StatusBar(style: Light, hidden: false)

        Column(spacing: 12) {
            Text("Profile")
            Text(visits)
            Button("Increment visits") {
                visits = visits + 1
            }
        }
    }

    body {
        NavigationStack(root: Home)
    }
}
