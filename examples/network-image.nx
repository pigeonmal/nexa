app NetworkImage {
    state profileURL = "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=512"

    body {
        Column(spacing: 12, padding: 20) {
            Text("The remote image uses the generated native network stack")
            Image(
                url: profileURL,
                description: "Profile photo",
                scale: Fill,
                placeholder: "nexa_mark"
            )
        }
    }
}
