app PressableDoubleTap {
    state likes: Int32 = 0

    body {
        Column {
            Pressable(haptic: Light) {
                Text("Double tap to like")
            }.onTap {
                likes = likes + 1
            }.onDoubleTap {
                likes = likes + 2
            }.onLongPress(durationMs: 700) {
                likes = 0
            }

            Text("Likes: \(likes)")
        }
    }
}
