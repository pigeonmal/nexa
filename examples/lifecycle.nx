app LifecycleExample {
    state appearances: Int32 = 0
    state disappearances: Int32 = 0
    state activations: Int32 = 0
    state inactivations: Int32 = 0
    state backgrounds: Int32 = 0

    body {
        OnAppear {
            appearances = appearances + 1
        }
        OnDisappear {
            disappearances = disappearances + 1
        }
        OnActive {
            activations = activations + 1
        }
        OnInactive {
            inactivations = inactivations + 1
        }
        OnBackground {
            backgrounds = backgrounds + 1
        }

        Column {
            Text("Appeared \(appearances) time(s)")
            Text("Disappeared \(disappearances) time(s)")
            Text("Active \(activations) time(s)")
            Text("Inactive \(inactivations) time(s)")
            Text("Backgrounded \(backgrounds) time(s)")
        }
    }
}
