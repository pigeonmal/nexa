import "../models/TaskItem.nx"

fn todoDateLabel(timestamp: Int64) -> String {
    let today: Int64 = Time.startOfDay(Time.now())
    let date: Int64 = Time.startOfDay(timestamp)
    return date == today ? "Today"
        : (date == Time.addCalendarDays(today, 1) ? "Tomorrow"
        : (date == Time.addCalendarDays(today, -1) ? "Yesterday"
        : Time.format(timestamp, "d MMM")))
}

fn todoSectionDateLabel(timestamp: Int64) -> String {
    let today: Int64 = Time.startOfDay(Time.now())
    let date: Int64 = Time.startOfDay(timestamp)
    if date == today { return "Today" }
    if date == Time.addCalendarDays(today, 1) { return "Tomorrow" }
    if date == Time.addCalendarDays(today, -1) { return "Yesterday" }
    return Time.format(timestamp, Time.format(Time.now(), "yyyy") == Time.format(timestamp, "yyyy")
        ? "EEEE, d MMM"
        : "EEEE, d MMM yyyy")
}

fn taskRowDateLabel(timestamp: Int64, hasTime: Bool) -> String {
    let date = todoDateLabel(timestamp)
    return hasTime ? date + ", " + Time.format(timestamp, "HH:mm") : date
}

fn taskRowIsOverdue(task: TaskItem) -> Bool {
    if task.dueTimestamp == null || task.isCompleted { return false }
    let due: Int64 = task.dueTimestamp ?? 0
    return task.hasTime ? due < Time.now() : Time.startOfDay(due) < Time.startOfDay(Time.now())
}

component TaskRowContent(task: TaskItem) {
    body {
        Column(spacing: 3, alignment: Start) {
            if task.isCompleted {
                Text(task.title, strikethrough: true, color: "#8E8E93")
            } else {
                Text(task.title)
            }
            if task.taskDescription != "" {
                Text(task.taskDescription, fontSize: 15, color: "#8E8E93", lineLimit: 2)
            }
            if task.dueTimestamp != null || task.priority != "None" || task.commentCount > 0 || task.reminderCount > 0 {
                Row(spacing: 6) {
                    if task.dueTimestamp != null {
                        if taskRowIsOverdue(task) {
                            Row(spacing: 2) {
                                Icon(system: "calendar", size: 12, tint: "#FF3B30", description: "")
                                Text(taskRowDateLabel(task.dueTimestamp ?? 0, task.hasTime), fontSize: 12, color: "#FF3B30")
                            }
                        } else {
                            Row(spacing: 2) {
                                Icon(system: "calendar", size: 12, tint: "#8E8E93", description: "")
                                Text(taskRowDateLabel(task.dueTimestamp ?? 0, task.hasTime), fontSize: 12, color: "#8E8E93")
                            }
                        }
                    }
                    if task.priority != "None" {
                        if task.priority == "Highest" {
                            Row(spacing: 2) {
                                Icon(system: "flag_filled", size: 12, tint: "#FF3B30", description: "")
                                Text(task.priority, fontSize: 12, color: "#FF3B30")
                            }
                        } else if task.priority == "High" {
                            Row(spacing: 2) {
                                Icon(system: "flag_filled", size: 12, tint: "#FF9500", description: "")
                                Text(task.priority, fontSize: 12, color: "#FF9500")
                            }
                        } else if task.priority == "Normal" {
                            Row(spacing: 2) {
                                Icon(system: "flag_filled", size: 12, tint: "#FFCC00", description: "")
                                Text(task.priority, fontSize: 12, color: "#FFCC00")
                            }
                        } else {
                            Row(spacing: 2) {
                                Icon(system: "flag_filled", size: 12, tint: "#34C759", description: "")
                                Text(task.priority, fontSize: 12, color: "#34C759")
                            }
                        }
                    }
                    if task.commentCount > 0 {
                        Row(spacing: 2) {
                            Icon(system: "comment_left", size: 12, tint: "#8E8E93", description: "")
                            Text(task.commentCount, fontSize: 12, color: "#8E8E93")
                        }
                    }
                    if task.reminderCount > 0 {
                        Row(spacing: 2) {
                            Icon(system: "notifications", size: 12, tint: "#8E8E93", description: "")
                            Text(task.reminderCount, fontSize: 12, color: "#8E8E93")
                        }
                    }
                }
            }
        }
    }
}
