import "models/TaskItem.nx"
import "models/ReminderItem.nx"
import "components/TaskRowContent.nx"
import "storage/TodoPersistence.nx"
import "widgets/Tasks.nx"
import "components/CommentPanel.nx"
import "features/TodoOperations.nx"
import "screens/Theme.nx"
import "screens/Completed.nx"
import "screens/Main.nx"
plugin "dev.nexa.notifications" as Notifications
plugin "dev.nexa.browser" as Browser
plugin "dev.nexa.mail-composer" as Mail
plugin "dev.nexa.data-extractor" as DataExtractor

app TodoArchetype {
    let notifications = Notifications()
    let browser = Browser.SystemBrowser()
    let mail = Mail.MailComposer()
    let dataExtractor = DataExtractor.DataExtractor()
    state showingOnboarding: Bool = (Storage.getString("onboarding.launchedBefore") ?? "false") != "true"
    state currentOnboardingPage: Int32 = 0
    state notificationTask: TaskHandle? = null
    state browserTask: TaskHandle? = null
    state mailTask: TaskHandle? = null
    state reminderStatus: String = ""
    state reminderSaved: Bool = false

    state selectedTab: Int32 = (Storage.getString("settings.start-page") ?? "tabToday") == "tabInbox" ? 0 : ((Storage.getString("settings.start-page") ?? "tabToday") == "tabUpcoming" ? 2 : 1)
    state startPageSelection: String = (Storage.getString("settings.start-page") ?? "tabToday") == "tabInbox" ? "Inbox" : ((Storage.getString("settings.start-page") ?? "tabToday") == "tabUpcoming" ? "Upcoming" : "Today")
    state tasks: Array<TaskItem> = []
    state nextTaskID: Int32 = 1
    state reminders: Array<ReminderItem> = []
    state nextReminderID: Int32 = 1
    state reminderTitle: String = ""
    state reminderHasTime: Bool = true
    state reminderTimestamp: Int64 = Time.now() + 3600000
    state sortSelection: String = Storage.getString("settings.task-sort") ?? "Date (Asc)"
    state autoReminderChoice: String = (Storage.getString("settings.auto-reminder-minutes") ?? "10") == "0" ? "None" : ((Storage.getString("settings.auto-reminder-minutes") ?? "10") == "30" ? "30 minutes before" : ((Storage.getString("settings.auto-reminder-minutes") ?? "10") == "60" ? "1 hour before" : "10 minutes before"))
    state selectedTheme: String = "Alizarin Red"
    state appearanceMode: String = Storage.getString("settings.appearance") ?? "system"
    state openLinksInApp: Bool = (Storage.getString("settings.open-links-in-app") ?? "false") == "true"
    state searchQuery: String = ""

    state editingID: Int32 = -1
    state taskTitle: String = ""
    state dateExtractionTask: TaskHandle? = null
    state detectedDate: DataExtractor.ExtractedData? = null
    state dateSuggestionDismissed: Bool = false
    state taskDescription: String = ""
    state taskTitleFocused: Bool = false
    state hasDueDate: Bool = false
    state dueTimestamp: Int64 = Time.now()
    state hasTime: Bool = false
    state priority: String = "None"
    state showingTaskEditor: Bool = false
    state showingPriorityPicker: Bool = false
    state showingDatePicker: Bool = false
    state pickerTimestamp: Int64 = Time.now()
    state pickerHasTime: Bool = false
    state showingComments: Bool = false
    state showingReminders: Bool = false
    state addingReminder: Bool = false
    state returnToEditorAfterOverlay: Bool = false
    state selectedTaskID: Int32 = -1

    body {
        OnAppear async {
            if (await todoPersistence.initialize()) {
                let storedTheme = await todoPersistence.loadTheme()
                if storedTheme == "" {
                    await todoPersistence.saveTheme(selectedTheme)
                } else {
                    selectedTheme = storedTheme
                }
                tasks = await todoPersistence.loadTasks()
                nextTaskID = await todoPersistence.loadNextID()
                reminders = await todoPersistence.loadReminders()
                nextReminderID = await todoPersistence.loadNextReminderID()
            } else {
                Log.error(message: "TODO_SQLITE_INITIALIZATION_FAIL")
            }

            notifications.localNotificationOpened { notification ->
                let found = taskForReminder(tasks, reminders, notification.identifier)
                if found != null {
                    let task = found ?? TaskItem(-1, "", "", null, false, "None", false, null, true, 0, 0, 0)
                    editingID = task.id
                    taskTitle = task.title
                    taskDescription = task.taskDescription
                    hasDueDate = task.dueTimestamp != null
                    dueTimestamp = task.dueTimestamp ?? Time.now()
                    hasTime = task.hasTime
                    priority = task.priority
                    if !task.isCompleted {
                        selectedTab = task.dueTimestamp == null ? 0 : (Time.startOfDay(task.dueTimestamp ?? 0) == Time.startOfDay(Time.now()) ? 1 : 2)
                        taskTitleFocused = editingID < 0
                        showingTaskEditor = true
                    }
                } else {
                    Log.error(message: "TODO_NOTIFICATION_TASK_NOT_FOUND")
                }
            }
        }

        OnInactive {
            Storage.setString("settings.start-page", startPageSelection == "Inbox" ? "tabInbox" : (startPageSelection == "Upcoming" ? "tabUpcoming" : "tabToday"))
            Storage.setString("settings.task-sort", sortSelection)
            Storage.setString("settings.auto-reminder-minutes", autoReminderChoice == "None" ? "0" : (autoReminderChoice == "30 minutes before" ? "30" : (autoReminderChoice == "1 hour before" ? "60" : "10")))
            Storage.setString("settings.open-links-in-app", openLinksInApp ? "true" : "false")
        }

        OnActive {
            Task.launch(executor: TaskExecutor.Main) {
                if (await todoPersistence.initialize()) {
                    tasks = await todoPersistence.loadTasks()
                    reminders = await todoPersistence.loadReminders()
                    nextTaskID = await todoPersistence.loadNextID()
                    nextReminderID = await todoPersistence.loadNextReminderID()
                    await notifications.setBadgeCount(todoFilter(tasks, 1, "").count)
                    for reminder in reminders {
                        if !reminder.isDeleted && hasActiveReminderTask(tasks, reminder.taskID) && reminder.timestamp > Time.now() {
                            try {
                                if !(await notifications.isLocalPending(reminder.identifier)) {
                                    let body = reminderNotificationBody(tasks, reminder)
                                    await notifications.scheduleLocalAt(
                                        reminder.identifier,
                                        Locale.localized("Reminder"),
                                        body,
                                        reminder.timestamp / 1000
                                    )
                                }
                            } catch {
                                case Notifications.NotificationError.permissionDenied {}
                                case Notifications.NotificationError.invalidIdentifier {}
                                case Notifications.NotificationError.invalidDelay {}
                                case Notifications.NotificationError.schedulerUnavailable {}
                                case Notifications.NotificationError.firebaseNotConfigured {}
                                case Notifications.NotificationError.remoteRegistrationUnavailable {}
                            }
                        } else {
                            notifications.cancelLocal(reminder.identifier)
                        }
                    }
                } else {
                    Log.error(message: "TODO_SQLITE_RECONCILIATION_FAILED")
                }
            }
        }

        NavigationStack(root: Main)
    }
}
