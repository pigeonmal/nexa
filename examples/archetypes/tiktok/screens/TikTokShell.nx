import "HomeScreen.nx"
import "DiscoverScreen.nx"
import "CreateScreen.nx"
import "ActivityScreen.nx"
import "ProfileScreen.nx"
import "../components/BottomTab.nx"

screen TikTokShell {
    AppBottomBar(selected: selectedTab, tint: "#FFFFFF") {
        Tab(index: 0, label: "Home", icon: "home") {
            HomeScreen()
        }
        Tab(index: 1, label: "Discover", icon: "search") {
            DiscoverScreen()
        }
        Tab(index: 2, label: "Create", icon: "add") {
            CreateScreen()
        }
        Tab(index: 3, label: "Inbox", icon: "inbox") {
            ActivityScreen()
        }
        Tab(index: 4, label: "Profile", icon: "person") {
            ProfileScreen()
        }

        TabBar {
            Column(background: "#09090B") {
                Stack(alignment: Center, height: 55, background: "#09090B") {
                    Row(spacing: 0, alignment: Center, padding: 4, background: "#09090B") {
                    Pressable(accessibilityLabel: "Home tab", accessibilityRole: Button) {
                        BottomTab(label: "Home", icon: "home", active: selectedTab == 0)
                    }.onTap { selectedTab = 0 }
                    Spacer()
                    Pressable(accessibilityLabel: "Discover tab", accessibilityRole: Button) {
                        BottomTab(label: "Discover", icon: "search", active: selectedTab == 1)
                    }.onTap { selectedTab = 1 }
                    Spacer()
                    Pressable(accessibilityLabel: "Create a video", accessibilityRole: Button) {
                        Stack(alignment: Center, width: 44, height: 28) {
                            Stack(width: 43, height: 25, background: "#25F4EE", cornerRadius: 6) {}
                            Stack(width: 43, height: 25, background: "#FE2C55", cornerRadius: 6) {}
                            Stack(alignment: Center, width: 40, height: 25, background: "#FFFFFF", cornerRadius: 6) {
                                Icon(system: "add", description: "Create", size: 20, tint: "#111111")
                            }
                        }
                    }.onTap { selectedTab = 2 }
                    Spacer()
                    Pressable(accessibilityLabel: "Inbox tab", accessibilityRole: Button) {
                        BottomTab(label: "Inbox", icon: "inbox", active: selectedTab == 3)
                    }.onTap { selectedTab = 3 }
                    Spacer()
                    Pressable(accessibilityLabel: "Profile tab", accessibilityRole: Button) {
                        BottomTab(label: "Profile", icon: "person", active: selectedTab == 4)
                    }.onTap { selectedTab = 4 }
                    }
                }
                Stack(height: 16, background: "#09090B") {}
            }
        }
    }
}
