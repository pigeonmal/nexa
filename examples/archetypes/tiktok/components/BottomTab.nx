component BottomTab(label: String, icon: String, active: Bool) {
    let tint = if active { "#FFFFFF" } else { "#9B9BA0" }

    body {
        Column(spacing: 3, alignment: Center, padding: 4) {
            if icon == "home" {
                Icon(system: "home", description: "", size: 21, tint: tint)
            } else if icon == "search" {
                Icon(system: "search", description: "", size: 21, tint: tint)
            } else if icon == "inbox" {
                Icon(system: "inbox", description: "", size: 21, tint: tint)
            } else {
                Icon(system: "person", description: "", size: 21, tint: tint)
            }
            if active {
                Text(label, color: "#FFFFFF", fontSize: 9, fontWeight: Semibold)
            } else {
                Text(label, color: "#9B9BA0", fontSize: 9, fontWeight: Medium)
            }
        }
    }
}
