component BottomTab(label: String, icon: String, active: Bool) {
    let tint = if active { "#FFFFFF" } else { "#9B9BA0" }

    body {
        Column(gap: 3, alignment: Center, padding: 4) {
            if icon == "home" {
                Icon(Icons.system.home, description: "", size: 21, color: tint)
            } else if icon == "search" {
                Icon(Icons.system.search, description: "", size: 21, color: tint)
            } else if icon == "inbox" {
                Icon(Icons.system.inbox, description: "", size: 21, color: tint)
            } else {
                Icon(Icons.system.person, description: "", size: 21, color: tint)
            }
            if active {
                Text(label, color: "#FFFFFF", fontSize: 9, fontWeight: Semibold)
            } else {
                Text(label, color: "#9B9BA0", fontSize: 9, fontWeight: Medium)
            }
        }
    }
}
