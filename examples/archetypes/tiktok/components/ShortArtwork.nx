component ShortArtwork(assetName: String) {
    body {
        if assetName == "coast" {
            Image(asset: "poster_coast_pexels_8651079.jpg", description: "Short video preview", fit: Fill, width: Fill, height: Fill)
        } else if assetName == "food" {
            Image(asset: "poster_food_pexels_16060256.jpg", description: "Short video preview", fit: Fill, width: Fill, height: Fill)
        } else if assetName == "trail" {
            Image(asset: "poster_trail_pexels_35746721.jpg", description: "Short video preview", fit: Fill, width: Fill, height: Fill)
        } else if assetName == "design" {
            Image(asset: "poster_design_pexels_7546553.jpg", description: "Short video preview", fit: Fill, width: Fill, height: Fill)
        } else if assetName == "waves" {
            Image(asset: "poster_waves_pexels_19266818.jpg", description: "Short video preview", fit: Fill, width: Fill, height: Fill)
        } else if assetName == "court" {
            Image(asset: "poster_court_pexels_14317220.jpg", description: "Short video preview", fit: Fill, width: Fill, height: Fill)
        } else {
            Image(asset: "poster_city_pexels_20131950.jpg", description: "Short video preview", fit: Fill, width: Fill, height: Fill)
        }
    }
}
