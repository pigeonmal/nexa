config {
    app { displayName: "TikTokClone", version: "1.0.0", buildNumber: 1 }
    dependencies {
        VideoPlayer { id: "dev.nexa.video-player", path: "../../../plugins/video-player" }
        MediaPicker { id: "dev.nexa.media-picker", path: "../../../plugins/media-picker" }
    }
    ios { minVersion: "17.0", bundleIdentifier: "dev.nexa.tiktokclone" }
    android {
        minSdk: 23,
        targetSdk: 36,
        applicationId: "dev.nexa.tiktokclone",
        cronet {
            provider: "embedded",
            diskCacheSizeMb: 64,
        },
    }
    permissions {}
}
