app GridListDemo {
    let products: Array<String> = ["Nexa", "SwiftUI", "Compose", "Cronet"]

    body {
        FastList(
            items: products,
            axis: Grid(2),
            index: position,
            item: product,
            key: product
        ) {
            Stack(minHeight: 72, padding: 12, background: "#F3F4F6") {
                Text(position)
                Text(product)
            }
        }
    }
}
