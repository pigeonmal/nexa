app GridListDemo {
    let products: Array<String> = ["Nexa", "SwiftUI", "Compose", "Cronet"]

    body {
        FastList(products, axis: Grid(2), key: .self, rowHeight: 72) { product, position in
            Stack(minHeight: 72, padding: 12, background: "#F3F4F6") {
                Text(position)
                Text(product)
            }
        }
    }
}
