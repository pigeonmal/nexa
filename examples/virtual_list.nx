app VirtualListApp {
    state totalRows: Int32 = 50000
    let listRef = ComponentRef<FastList>()

    body {
        Column(gap: 12) {
            Text("Nexa FastList Virtualization (50,000 Rows)")

            Row(gap: 8) {
                Button("Jump to 100") {
                    listRef.scrollToIndex(index: 100)
                }
                Button("Jump to 1000") {
                    listRef.scrollToIndex(index: 1000)
                }
                Button("Jump to Top") {
                    listRef.scrollToTop()
                }
            }

            FastList(count: totalRows, rowHeight: 52, ref: listRef) { index in
                Row(gap: 12, padding: 8) {
                    Text(index)
                    Text("Virtualized Row Item")
                }
            }
        }
    }
}
