app ThemedApp {
    theme {
        color surface(light: "#FFFFFF", dark: "#101216")
        color foreground(light: "#17191F", dark: "#F4F6FA")
        spacing page: 20
        spacing section: 12
        radius card: 16
        fontSize title: 28
        fontSize body: 16
    }

    body {
        Column(
            spacing: Theme.section,
            padding: Theme.page,
            background: Theme.surface,
            cornerRadius: Theme.card
        ) {
            Text("Welcome to Nexa", color: Theme.foreground, fontSize: Theme.title)
            Text("This screen follows your device appearance.", fontSize: Theme.body)
        }
    }
}
