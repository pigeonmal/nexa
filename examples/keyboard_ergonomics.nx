app KeyboardErgonomics {
    state email: String = ""
    state password: String = ""
    state code: String = ""

    let emailInputRef = ComponentRef<TextInput>()
    body {
        Column {
            TextInput(
                value: email,
                placeholder: "Email address",
                keyboardType: Email,
                autofill: Username,
                returnKeyType: Next,
                focused: true,
                ref: emailInputRef,
            ) {
                Log.info(message: "Email submitted")
            }
            TextInput(
                value: password,
                placeholder: "Password",
                isSecure: true,
                autofill: Password,
                returnKeyType: Done,
            ) {
                Log.info(message: "Password submitted")
            }
            TextInput(
                value: code,
                placeholder: "Verification code",
                keyboardType: Number,
                autofill: OneTimeCode,
                returnKeyType: Send,
            ) {
                Log.info(message: "Code submitted")
            }
            Button("Focus email") {
                emailInputRef.focus()
            }
            Button("Blur email") {
                emailInputRef.blur()
            }
        }
    }
}
