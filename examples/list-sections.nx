app FastListSectionsDemo {
    state groups: Array<Array<String>> = [["Alpha", "Beta"], ["Gamma"], ["Delta", "Epsilon"]]

    body {
        FastList(sections: groups, key: .self, rowHeight: 48) { item, itemIndex, sectionIndex in
            Text("\(sectionIndex):\(itemIndex) \(item)")
        }.sectionHeader {
            Text("Section \(sectionIndex)")
        }
    }
}
