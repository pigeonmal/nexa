app SpringAnimation {
    state expanded: Bool = false

    body {
        Column(spacing: 12, animation: Spring(response: 0.35, damping: 0.8)) {
            Button("Toggle details") {
                expanded = !expanded
            }

            if expanded {
                Text("The layout expands with a configured spring.")
            }.transition(.fade)

            when expanded {
                true: { Text("Conditional content enters from the bottom.") }
                else: { Spacer() }
            }.transition(.slide(from: .bottom))
        }
    }
}
