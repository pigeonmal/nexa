app MapIteration {
    state total: Int32 = 0
    let prices: Map<String, Int32> = ["basic": 10, "pro": 20]

    body {
        Column(spacing: 8, padding: 20) {
            Text("Total: \(total)")
            Button("Sum prices") {
                total = 0
                for (label, price) in prices {
                    total = total + price
                }
            }
        }
    }
}
