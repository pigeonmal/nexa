app AccessibilityExample {
    state greetingLabel = "Welcome heading"

    body {
        Column(spacing: 12, padding: 20) {
            Accessibility(label: greetingLabel, role: Header) {
                Text("Welcome to Nexa")
            }
            Accessibility(
                label: "Open settings",
                hint: "Opens the settings screen",
                role: Button
            ) {
                Button("Settings") {}
            }
            Accessibility(label: "Product photo", role: Image) {
                Image(asset: "product_photo", description: "Product photo")
            }
        }
    }
}
