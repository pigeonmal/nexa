app TupleMembers {
    let pair: Pair<String, Int32> = Pair("Nexa", 42)
    let triple: Triple<String, Int32, Bool> = Triple("Nexa", 42, true)

    body {
        Column(spacing: 8, padding: 20) {
            Text(pair.first)
            Text(pair.second)
            Text(triple.first)
            Text(triple.second)
            if triple.third {
                Text("Triple is enabled")
            }
        }
    }
}
