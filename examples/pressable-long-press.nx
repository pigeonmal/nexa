app PressableLongPress {
    state taps: Int32 = 0
    state longPresses: Int32 = 0

    body {
        Column(spacing: 12, padding: 20) {
            Pressable() {
                Text("Press or hold")
            } {
                taps = taps + 1
            } {
                longPresses = longPresses + 1
            }
            Text("Taps: \(taps)")
            Text("Long presses: \(longPresses)")
        }
    }
}
