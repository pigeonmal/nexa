app FastListScrollEventsDemo {
    state rows: Array<String> = ["First", "Second", "Third", "Fourth"]
    state scrollEvents: Int32 = 0

    body {
        FastList(rows, key: .self, rowHeight: 52) { row, index in
            Text("\(index): \(row)")
        }.onScroll {
            scrollEvents = scrollEvents + 1
        }
        Text("Scroll events: \(scrollEvents)")
    }
}
