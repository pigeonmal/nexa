app FastListStickyHeaderDemo {
    state rows: Array<String> = ["First", "Second", "Third", "Fourth"]

    body {
        FastList(items: rows, index: index, item: row, axis: Vertical, itemExtent: 52, key: row) {
            Text("\(index): \(row)")
        } stickyHeader {
            Text("Items")
        }
    }
}
