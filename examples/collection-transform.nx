app CollectionTransform {
    let values: Array<Int32> = [1, 2, 3]
    let doubled: Array<Int32> = values.map { value -> value + value }
    let positive: Array<Int32> = values.filter { value -> value > 0 }
    let total: Int32 = values.reduce(0) { accumulator, value -> accumulator + value }

    body {
        Column(spacing: 8, padding: 20) {
            Text(doubled)
            Text(positive)
            Text(total)
        }
    }
}
