struct User {
    id: Int64,
    name: String
}

struct Profile {
    user: User,
    enabled: Bool
}

app Structs {
    state user: User = User(42, "Ada")
    let profile: Profile = Profile(user, true)

    fn rename(user: User) -> User {
        let next = User(user.id, "Grace")
        return next
    }

    body {
        Column {
            Text(profile.user.name)
            Text(rename(user).name)
        }
    }
}
