app Counter {
    state count: Int32 = 0

    body {
        Column(gap: 16) {
            Text("Nexa Counter Demo")
            Text(count)

            Row(gap: 12) {
                Button("Increment") {
                    count = count + 1
                }
                Button("Reset") {
                    count = 0
                }
            }

            if count > 10 {
                Text("Double digits reached!")
            }
        }
    }
}
