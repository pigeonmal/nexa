app NativeApis {
    async fn loadBody(payload: String?) -> String {
        let response = await Network.fetch(url: "https://example.com", body: payload)
        return response.body
    }

    async fn saveBody() -> Bool {
        let path = Path.join(path: Path.documents(), component: "response.txt")
        let contents = await File.readText(path: path)
        return await File.writeText(path: path, contents: contents)
    }

    state body: String = ""
    state documentsPath = Path.documents()
    state saved: Bool = false

    body {
        OnAppear async {
            body = await loadBody(null)
            saved = await saveBody()
        }
        Column {
            Text(body)
            Text(documentsPath)
            Text(saved)
        }
    }
}
