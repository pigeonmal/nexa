app ListItemExtentDemo {
    state rows: Array<String> = ["First", "Second", "Third"]

    body {
        Column {
            FastList(rows, key: .self, rowHeight: 56) { row, index in
                Text(row)
            }

            FastList(count: 8, axis: Horizontal, rowHeight: 96) { card in
                Text("Card")
            }

            FastList(count: 12, axis: Grid(3), rowHeight: 72) { tile in
                Text("Tile")
            }
        }
    }
}
