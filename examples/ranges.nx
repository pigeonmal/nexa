app Ranges {
    state total: Int32 = 0

    body {
        Column(spacing: 12, padding: 20) {
            Text("Total: \(total)")
            Button("Inclusive range") {
                total = 0
                for value in 1..3 {
                    total = total + value
                }
            }
            Button("Exclusive range") {
                total = 0
                for value in 0..<3 {
                    total = total + value
                }
            }
            Button("Stepped range") {
                total = 0
                for value in 0..10 step 2 {
                    total = total + value
                }
            }
        }
    }
}
